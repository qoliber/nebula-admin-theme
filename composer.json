{
    "name": "qoliber/nebula-admin-theme",
    "version": "0.9.0",
    "description": "Nebula admin theme and modules for Magento 2 / Mage-OS. Targets Magento 2.4.7+ (or Mage-OS 2.0+) on PHP 8.1+.",
    "type": "magento2-component",
    "license": "proprietary",
    "authors": [
        { "name": "Qoliber",   "homepage": "https://qoliber.com" },
        { "name": "Siteation", "homepage": "https://siteation.dev" }
    ],
    "require": {
        "php": "^8.1",
        "magento/framework": "^103.0"
    },
    "autoload": {
        "psr-4": {
            "Qoliber\\": "code/Qoliber/"
        },
        "files": [
            "registration.php"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "magento/composer-dependency-version-audit-plugin": true,
            "magento/composer-root-update-plugin": true
        }
    },
    "scripts": {
        "phpstan": "dev-tools/vendor/bin/phpstan analyse --memory-limit=2G",
        "phpcs": "dev-tools/vendor/bin/phpcs",
        "phpcs:magento": "dev-tools/vendor/bin/phpcs --standard=Magento2 --extensions=php,phtml --ignore=*/Test/*,*/dev/*,*/docs/* code/Qoliber",
        "phpcbf": "dev-tools/vendor/bin/phpcbf",
        "cs-fixer": "dev-tools/vendor/bin/php-cs-fixer fix --config=../.php-cs-fixer.dist.php code/Qoliber design",
        "cs-fixer:dry": "dev-tools/vendor/bin/php-cs-fixer fix --dry-run --diff --config=../.php-cs-fixer.dist.php code/Qoliber design"
    }
}
