?>
<div class="flex min-h-full flex-col justify-center px-8 py-12 lg:px-16"
     x-data="forgotPassword()">

    <div class="w-full max-w-sm mx-auto mb-6">
        <h2 class="text-2xl font-bold tracking-tight text-gray-900">
            <?= $block->escapeHtml(__('Reset your password')) ?>
        </h2>
        <p class="mt-2 text-sm text-gray-500">
            <?= $block->escapeHtml(__('Enter your email address and we\'ll send you a link to reset your password.')) ?>
        </p>
    </div>

    <?= $block->getChildHtml('messages') ?>

    <div class="w-full max-w-sm mx-auto">
        <form method="post"
              action=""
              id="login-form"
              autocomplete="off"
              @submit="onSubmit"
              class="space-y-5">

            <input name="form_key" type="hidden" value="<?= $block->escapeHtmlAttr($block->getFormKey()) ?>"/>

            <div>
                <label for="email" class="block text-sm font-medium text-gray-700">
                    <?= $block->escapeHtml(__('Email address')) ?>
                </label>
                <input id="email"
                       type="email"
                       name="email"
                       required
                       autofocus
                       x-model="email"
                       placeholder="<?= $block->escapeHtmlAttr(__('admin@example.com')) ?>"
                       autocomplete="email"
                       class="mt-1.5 block w-full rounded-lg border border-gray-300 px-4 py-2.5 text-gray-900 shadow-sm placeholder:text-gray-400 focus:border-nebula-500 focus:ring-2 focus:ring-nebula-500/20 focus:outline-none transition sm:text-sm"/>
            </div>

            <?= $block->getChildHtml('form.additional.info') ?>

            <div class="pt-2">
                <button type="submit"
                        :disabled="loading"
                        class="flex w-full justify-center items-center rounded-lg bg-nebula-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-nebula-500 focus:outline-none focus:ring-2 focus:ring-nebula-500 focus:ring-offset-2 transition disabled:opacity-50 disabled:cursor-not-allowed">
                    <svg x-show="loading" x-cloak class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                    </svg>
                    <span x-text="loading ? '<?= $block->escapeJs(__('Sending...')) ?>' : '<?= $block->escapeJs(__('Retrieve Password')) ?>'"></span>
                </button>
            </div>

            <div class="text-center">
                <a href="<?= $block->escapeUrl($block->getUrl('adminhtml', ['_nosecret' => true])) ?>"
                   class="text-sm text-nebula-600 hover:text-nebula-500 transition">
                    <?= $block->escapeHtml(__('Back to Sign in')) ?>
                </a>
            </div>
        </form>
    </div>
</div>

<script>
    function forgotPassword() {
        return {
            email: '',
            loading: false,
            onSubmit() {
                if (this.email) {
                    this.loading = true;
                }
            }
        }
    }
</script>
