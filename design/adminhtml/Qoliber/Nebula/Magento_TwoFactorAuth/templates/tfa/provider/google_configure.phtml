        <div class="mt-6 text-center">
            <a href="<?= $block->escapeUrl($block->getUrl('adminhtml/auth/logout')) ?>"
               class="text-sm text-gray-400 hover:text-gray-600 transition">
                <?= $block->escapeHtml(__('Logout')) ?>
            </a>
        </div>
