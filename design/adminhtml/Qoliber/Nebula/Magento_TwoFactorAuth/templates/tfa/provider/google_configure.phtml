</div>

<script>
    function googleConfigure() {
        return {
            code: '',
            loading: false,
            error: '',
            qrCodeUrl: '<?= $block->escapeJs($qrCodeUrl) ?>',

            async verify() {
                if (this.code.length < 6) {
                    this.error = '<?= $block->escapeJs(__('Please enter a 6-digit code')) ?>';
                    return;
                }

                this.loading = true;
                this.error = '';

                try {
                    const formKey = document.querySelector('input[name="form_key"]')?.value
                        || '<?= $block->escapeJs($block->getFormKey()) ?>';

                    const response = await fetch('<?= $block->escapeJs($postUrl) ?>', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: new URLSearchParams({
                            'form_key': formKey,
                            'tfa_code': this.code
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        window.location.href = '<?= $block->escapeJs($successUrl) ?>';
                    } else {
                        this.error = data.message || '<?= $block->escapeJs(__('Invalid verification code. Please try again.')) ?>';
                        this.loading = false;
                    }
                } catch (e) {
                    this.error = '<?= $block->escapeJs(__('An error occurred. Please try again.')) ?>';
                    this.loading = false;
                }
            }
        }
    }
</script>
