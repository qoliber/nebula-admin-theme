$jsLayout = json_decode($block->getJsLayout(), true);
$config = $jsLayout['components']['tfa-configure'] ?? [];
$postUrl = $config['postUrl'] ?? '';
$qrCodeUrl = $config['qrCodeUrl'] ?? '';
$secretCode = $config['secretCode'] ?? '';
$successUrl = $config['successUrl'] ?? '';
?>
<div class="flex min-h-full flex-col justify-center px-8 py-12 lg:px-16"
     x-data="googleConfigure()">

    <?= $block->getChildHtml('messages') ?>

    <div class="w-full max-w-sm mx-auto">
        <div class="text-center mb-8">
            <div class="mx-auto mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-nebula-100">
                <svg class="h-8 w-8 text-nebula-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 3.75 9.375v-4.5ZM3.75 14.625c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5a1.125 1.125 0 0 1-1.125-1.125v-4.5ZM13.5 4.875c0-.621.504-1.125 1.125-1.125h4.5c.621 0 1.125.504 1.125 1.125v4.5c0 .621-.504 1.125-1.125 1.125h-4.5A1.125 1.125 0 0 1 13.5 9.375v-4.5Z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 6.75h.75v.75h-.75v-.75ZM6.75 16.5h.75v.75h-.75v-.75ZM16.5 6.75h.75v.75h-.75v-.75ZM13.5 13.5h.75v.75h-.75v-.75ZM13.5 19.5h.75v.75h-.75v-.75ZM19.5 13.5h.75v.75h-.75v-.75ZM19.5 19.5h.75v.75h-.75v-.75ZM16.5 16.5h.75v.75h-.75v-.75Z"/>
                </svg>
            </div>

            <h2 class="text-2xl font-bold tracking-tight text-gray-900">
                <?= $block->escapeHtml(__('Set Up Google Authenticator')) ?>
            </h2>
            <p class="mt-2 text-sm text-gray-500">
                <?= $block->escapeHtml(__('Scan the QR code below with your authenticator app')) ?>
            </p>
        </div>

        <div class="rounded-xl border border-gray-200 bg-gray-50 p-6 text-center mb-6">
            <img :src="qrCodeUrl"
                 alt="<?= $block->escapeHtmlAttr(__('QR Code')) ?>"
                 class="mx-auto h-48 w-48 rounded-lg bg-white p-2 shadow-sm"/>

            <div class="mt-4">
                <p class="text-xs text-gray-400 mb-1"><?= $block->escapeHtml(__('Or enter this code manually:')) ?></p>
                <code class="inline-block rounded bg-white px-3 py-1.5 text-sm font-mono font-semibold text-gray-700 shadow-sm border border-gray-200 select-all">
                    <?= $block->escapeHtml($secretCode) ?>
                </code>
            </div>
        </div>

        <form @submit.prevent="verify()" class="space-y-5">
            <div>
                <label for="tfa-code" class="block text-sm font-medium text-gray-700">
                    <?= $block->escapeHtml(__('Verification Code')) ?>
                </label>
                <input id="tfa-code"
                       type="text"
                       inputmode="numeric"
                       pattern="[0-9]*"
                       maxlength="6"
                       required
                       autofocus
                       x-model="code"
                       placeholder="000000"
                       class="mt-1.5 block w-full rounded-lg border border-gray-300 px-4 py-2.5 text-center text-lg font-mono tracking-widest text-gray-900 shadow-sm placeholder:text-gray-300 focus:border-nebula-500 focus:ring-2 focus:ring-nebula-500/20 focus:outline-none transition sm:text-sm"/>
            </div>

            <p class="text-red-600 text-sm text-center" x-show="error" x-cloak x-text="error"></p>

            <button type="submit"
                    :disabled="loading"
                    class="flex w-full justify-center items-center rounded-lg bg-nebula-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm hover:bg-nebula-500 focus:outline-none focus:ring-2 focus:ring-nebula-500 focus:ring-offset-2 transition disabled:opacity-50 disabled:cursor-not-allowed">
                <svg x-show="loading" x-cloak class="animate-spin -ml-1 mr-2 h-4 w-4 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                <span x-text="loading ? '<?= $block->escapeJs(__('Verifying...')) ?>' : '<?= $block->escapeJs(__('Confirm & Activate')) ?>'"></span>
            </button>
