<?xml version="1.0"?>
<!--
    Nebula: Top menu + 2-column content (config pages)
-->
<layout xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_layout.xsd">
    <container name="root">
        <container name="backend.page" htmlTag="div" htmlClass="nebula-admin-layout-top">
            <container name="after.body.start" as="after.body.start" label="Page Top" before="-"/>

            <container name="nebula.topbar" htmlTag="header" htmlClass="nebula-topbar" label="Top Bar">
                <container name="sidebar.logo" htmlTag="div" htmlClass="nebula-topbar-logo" label="Logo"/>
                <container name="page.menu" as="page.menu" htmlTag="nav" htmlClass="nebula-topbar-nav"
                    label="Top Navigation"/>
                <container name="header" htmlTag="div" htmlClass="nebula-topbar-actions" label="Header Actions"/>
            </container>

            <container name="nebula.main" htmlTag="div" htmlClass="nebula-main-full" label="Main Area">
                <container name="page.content" as="page_content" htmlTag="main" htmlClass="nebula-content">
                    <container name="notices.wrapper" before="-" htmlTag="div" htmlClass="nebula-notices">
                        <container name="notifications" as="notifications"/>
                        <container name="notification.window" as="notification_window" before="-"/>
                        <container name="global.notices" as="global_notices" after="notification.window"/>
                    </container>

                    <container name="page.breadcrumbs" as="page.breadcrumbs"/>
                    <container name="main.top" as="main-top" label="main-top"/>
                    <container name="page.main.actions" as="page_main_actions" htmlTag="div"
                        htmlClass="nebula-page-actions"/>
                    <container name="page.formkey" as="page.formkey"/>

                    <container name="messages.wrapper" as="messages.wrapper" htmlTag="div" htmlClass="nebula-messages">
                        <container name="page.messages" as="page.messages"/>
                    </container>

                    <container name="page.main.container" as="page_main_container" htmlTag="div"
                        htmlClass="nebula-2col-container mt-6">
                        <container name="side.col" as="side-col" htmlTag="div" htmlClass="nebula-2col-left">
                            <container name="left" as="left"/>
                        </container>
                        <container name="main.col" as="main-col" htmlTag="div" htmlClass="nebula-2col-main">
                            <container name="admin.scope.col.wrap" as="admin-scope-col-wrap" htmlTag="div">
                                <container name="content" as="content"/>
                            </container>
                        </container>
                    </container>
                </container>

                <container name="footer" htmlTag="footer" htmlClass="nebula-footer"/>
                <container name="js" as="js" label="JavaScript"/>
            </container>

            <container name="before.body.end" as="before_body_end" label="Before Body End" after="-"/>
        </container>
    </container>
</layout>
