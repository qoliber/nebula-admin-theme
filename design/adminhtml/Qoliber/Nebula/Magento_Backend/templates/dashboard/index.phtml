                <?php
                /*
                 * Nebula dashboard tabs.
                 *
                 * Mirrors Magento\Backend\Block\Dashboard\Grids: Bestsellers
                 * is eager-loaded, the other 3 fetch on first click.
                 *
                 * The AJAX endpoints implement HttpPostActionInterface, so we
                 * POST with form_key. Response is raw HTML — injected via
                 * x-html into the corresponding panel.
                 *
                 * Loaded HTML is cached in the Alpine state so re-clicking
                 * the same tab doesn't refetch.
                 */
                $bestsellersHtml = $block->getLayout()
                    ->createBlock(\Magento\Backend\Block\Dashboard\Tab\Products\Ordered::class)
                    ->toHtml();
                $tabs = [
                    [
                        'id'      => 'ordered_products',
                        'label'   => (string) __('Bestsellers'),
                        'content' => $bestsellersHtml,
                        'url'     => '',
                    ],
                    [
                        'id'      => 'reviewed_products',
                        'label'   => (string) __('Most Viewed Products'),
                        'content' => '',
                        'url'     => $block->getUrl('adminhtml/dashboard/productsViewed', ['_current' => true]),
                    ],
                    [
                        'id'      => 'new_customers',
                        'label'   => (string) __('New Customers'),
                        'content' => '',
                        'url'     => $block->getUrl('adminhtml/dashboard/customersNewest', ['_current' => true]),
                    ],
                    [
                        'id'      => 'customers',
                        'label'   => (string) __('Customers'),
                        'content' => '',
                        'url'     => $block->getUrl('adminhtml/dashboard/customersMost', ['_current' => true]),
                    ],
                ];
                $tabsConfig = json_encode(
                    ['tabs' => $tabs, 'formKey' => $block->getFormKey()],
                    JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES
                );
                ?>
                <div x-data="nebulaDashboardTabs(<?= $block->escapeHtmlAttr($tabsConfig) ?>)" class="nebula-dashboard-tabs">
                    <div class="flex flex-wrap items-center gap-1 border-b border-gray-200 dark:border-gray-700 mb-4">
                        <template x-for="(tab, idx) in tabs" :key="tab.id">
                            <button type="button"
                                    @click="activate(idx)"
                                    :class="active === idx
                                        ? 'border-[var(--color-nebula-600)] text-[var(--color-nebula-700)] dark:text-[var(--color-nebula-300)]'
                                        : 'border-transparent text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 hover:border-gray-300 dark:hover:border-gray-600'"
                                    class="-mb-px px-4 py-2 text-sm font-semibold border-b-2 transition"
                                    x-text="tab.label"></button>
                        </template>
                    </div>
                    <div class="relative min-h-[8rem]">
                        <!--
                            Render the currently-DISPLAYED tab. While a new tab
                            is being fetched, `displayed` stays on the previous
                            tab and the loader below overlays this panel — so
                            the container keeps its size instead of collapsing
                            then expanding when content arrives.
                        -->
                        <template x-for="(tab, idx) in tabs" :key="tab.id">
                            <div x-show="displayed === idx" x-html="tab.content"></div>
                        </template>
                        <template x-if="error">
                            <div class="rounded border border-red-200 dark:border-red-800/40 bg-red-50 dark:bg-red-900/30 px-3 py-2 text-xs text-red-700 dark:text-red-300 mt-2" x-text="error"></div>
                        </template>
                        <!-- Loader overlay: covers the currently-shown panel during fetch. -->
                        <div x-show="loading"
                             x-cloak
                             class="absolute inset-0 flex items-center justify-center bg-white/70 dark:bg-gray-900/70 backdrop-blur-[1px] z-10 rounded">
                            <div class="flex items-center text-xs font-medium text-gray-600 dark:text-gray-300">
                                <svg class="animate-spin h-4 w-4 mr-2" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
