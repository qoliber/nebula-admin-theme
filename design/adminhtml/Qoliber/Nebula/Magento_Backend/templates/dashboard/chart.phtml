<?php
/**
 * Qoliber Nebula — Dashboard Chart (Chart.js + Alpine.js)
 *
 * Skin- and dark-mode-compatible. All chart colors read from skin CSS
 * variables at render time so light + dark skins render correctly.
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

$viewModel = $block->getViewModel();
$htmlId = $block->getData('html_id');
$updateUrl = $block->getUrl($block->getData('update_url'), ['_current' => true]);
$precision = (int) ($block->getData('chart_precision') ?: 0);
$canvasId = 'nebula_chart_' . $htmlId;
?>
<div x-data="nebulaChart_<?= $escaper->escapeHtmlAttr($htmlId) ?>()"
     x-init="$nextTick(() => loadChart())"
     @nebula-chart-reload.window="loadChart($event.detail)"
     @nebula-chart-tab-visible.window="if ($event.detail === '<?= $escaper->escapeJs($htmlId) ?>') { loadChart(_pendingPeriod || null); _pendingPeriod = undefined; }"
     class="nebula-dashboard-chart">
    <canvas id="<?= $escaper->escapeHtmlAttr($canvasId) ?>" height="280"></canvas>
    <div x-show="loading" class="nebula-dashboard-chart__loading">
        <svg class="nebula-dashboard-chart__spinner" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
        </svg>
    </div>
    <div x-show="noData && !loading" x-cloak class="nebula-dashboard-chart__empty">
        <div>
            <svg class="nebula-dashboard-chart__empty-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 0 1 3 19.875v-6.75ZM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V8.625ZM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 0 1-1.125-1.125V4.125Z"/>
            </svg>
            <p class="nebula-dashboard-chart__empty-text"><?= $escaper->escapeHtml(__('No data available')) ?></p>
        </div>
    </div>
</div>

<script>
    function nebulaChart_<?= $escaper->escapeJs($htmlId) ?>() {
        return {
            chart: null,
            loading: true,
            noData: false,

            async loadChart(period) {
                if (typeof period !== 'string') {
                    period = null;
                }

                const canvas = document.getElementById('<?= $escaper->escapeJs($canvasId) ?>');
                if (canvas && canvas.offsetParent === null) {
                    this._pendingPeriod = period;
                    return;
                }

                this.loading = true;
                this.noData = false;

                const periodSelect = document.getElementById('dashboard_chart_period');
                const selectedPeriod = period || (periodSelect ? periodSelect.value : '24h');

                try {
                    const formKey = document.querySelector('[name="form_key"]')?.value || '';
                    const response = await fetch('<?= $escaper->escapeJs($updateUrl) ?>', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: new URLSearchParams({ period: selectedPeriod, form_key: formKey, isAjax: 'true' })
                    });

                    const json = await response.json();
                    const items = json.data || [];

                    if (!items.length) {
                        this.noData = true;
                        this.loading = false;
                        return;
                    }

                    const labels = items.map(i => i.label || i.x || '');
                    const values = items.map(i => parseFloat(i.value || i.y || 0));

                    const canvas = document.getElementById('<?= $escaper->escapeJs($canvasId) ?>');
                    if (!canvas) {
                        this.loading = false;
                        return;
                    }
                    const ctx = canvas.getContext('2d');

                    if (this.chart) {
                        this.chart.destroy();
                        this.chart = null;
                    }

                    // Read every chart color from skin CSS variables — skin/dark-mode aware.
                    const cssVar = (name, fallback) => {
                        const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
                        return v || fallback;
                    };
                    const chartLine   = cssVar('--nebula-chart-line', '#6366f1');
                    const chartFill   = cssVar('--nebula-chart-fill', '#6366f1');
                    const axisColor   = cssVar('--nebula-text-muted', '#9ca3af');
                    const gridColor   = cssVar('--nebula-border-light', '#f3f4f6');
                    const pointBorder = cssVar('--nebula-bg-primary', '#ffffff');
                    const tooltipBg   = cssVar('--nebula-text-primary', '#1f2937');
                    const tooltipText = cssVar('--nebula-bg-primary', '#ffffff');

                    const gradient = ctx.createLinearGradient(0, 0, 0, canvas.height || 280);
                    gradient.addColorStop(0, chartFill + '25');
                    gradient.addColorStop(1, chartFill + '00');

                    this.chart = new Chart(ctx, {
                        type: 'line',
                        data: {
                            labels: labels,
                            datasets: [{
                                label: json.label || '<?= $escaper->escapeJs($htmlId) ?>',
                                data: values,
                                borderColor: chartLine,
                                backgroundColor: gradient,
                                borderWidth: 2.5,
                                fill: true,
                                tension: 0.4,
                                pointBackgroundColor: chartLine,
                                pointBorderColor: pointBorder,
                                pointBorderWidth: 2,
                                pointRadius: 4,
                                pointHoverRadius: 6,
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            animation: false,
                            interaction: { intersect: false, mode: 'index' },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    backgroundColor: tooltipBg,
                                    titleColor: tooltipText,
                                    bodyColor: tooltipText,
                                    titleFont: { size: 12 },
                                    bodyFont: { size: 13, weight: 'bold' },
                                    padding: 10,
                                    cornerRadius: 8,
                                    displayColors: false,
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: { font: { size: 11 }, color: axisColor, maxRotation: 45 },
                                    border: { display: false },
                                },
                                y: {
                                    beginAtZero: true,
                                    grid: { color: gridColor },
                                    ticks: { font: { size: 11 }, color: axisColor, precision: <?= $precision ?> },
                                    border: { display: false },
                                }
                            }
                        }
                    });
                } catch (e) {
                    console.error('Chart load failed:', e);
                    this.noData = true;
                }

                this.loading = false;
            }
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const periodSelect = document.getElementById('dashboard_chart_period');
        if (periodSelect) {
            periodSelect.addEventListener('change', function() {
                window.dispatchEvent(new CustomEvent('nebula-chart-reload', {
                    detail: periodSelect.value
                }));
            });
        }
    });
</script>
