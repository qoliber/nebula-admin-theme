<?php
/**
 * Qoliber Nebula — Sidebar Navigation with pins, icons, and footer
 *
 * @var \Qoliber\Nebula\Block\Menu $block
 */

$data = $block->getNebulaMenuData();
$items = $data['items'];
$activeParents = $data['activeParents'];
$pinnedItems = $data['pinnedItems'] ?? [];
$pinnedIds = $data['pinnedIds'] ?? [];
$pinUrl = $data['pinUrl'] ?? '';

function renderNebulaItems(array $items, array $pinnedIds, string $pinUrl, int $level = 0): string
{
    $html = '';

    foreach ($items as $item) {
        $id = htmlspecialchars($item['id'], ENT_QUOTES);
        $title = htmlspecialchars($item['title'], ENT_QUOTES);
        $icon = $item['icon'] ?? null;
        $iconHtml = $icon
            ? '<i class="' . $icon . ' w-5 text-center text-xs opacity-70"></i>'
            : ($level === 0 ? '<i class="fa-solid fa-circle w-5 text-center text-[6px] opacity-40"></i>' : '');

        $indent = $level > 0 ? ' pl-' . (($level + 1) * 3) : '';
        $isPinned = in_array($item['id'], $pinnedIds);

        if ($item['hasChildren']) {
            $activeClass = ($item['isActive'] || $item['isActiveParent'])
                ? 'nebula-menu-item-active'
                : 'nebula-menu-item';

            $html .= '<li>'
                . '<button type="button" @click="toggle(\'' . $id . '\')" '
                . 'class="group flex w-full items-center gap-2.5 rounded-lg px-3 py-2 text-sm font-medium ' . $activeClass . $indent . '">'
                . $iconHtml
                . '<span class="flex-1 truncate text-left">' . $title . '</span>'
                . '<svg class="h-3.5 w-3.5 shrink-0 opacity-50 transition-transform duration-200" '
                . ':class="isOpen(\'' . $id . '\') ? \'rotate-90\' : \'\'" '
                . 'xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">'
                . '<path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/>'
                . '</svg></button>'
                . '<ul x-show="isOpen(\'' . $id . '\')" x-collapse class="mt-0.5 space-y-0.5">'
                . renderNebulaItems($item['children'], $pinnedIds, $pinUrl, $level + 1)
                . '</ul></li>';
        } else {
            $activeClass = $item['isActive']
                ? 'nebula-menu-item-active font-medium'
                : 'nebula-menu-item-muted';

            $childIcon = $icon
                ? '<i class="' . $icon . ' w-5 text-center text-xs opacity-60"></i>'
                : '';

            $html .= '<li class="relative flex items-center' . $indent . '">'
                . '<a href="' . htmlspecialchars($item['url'], ENT_QUOTES) . '" '
                . 'class="flex-1 flex items-center gap-2.5 rounded-lg px-3 py-1.5 text-sm ' . $activeClass . '">'
                . $childIcon
                . '<span class="truncate">' . $title . '</span>'
                . '</a>'
                . '<button type="button" '
                . '@click.stop.prevent="togglePin(\'' . $id . '\')" '
                . 'class="flex items-center justify-center w-7 h-7 rounded-md transition cursor-pointer '
                . ($isPinned
                    ? 'nebula-menu-item-active'
                    : 'nebula-menu-item opacity-40 hover:opacity-100')
                . '" title="' . ($isPinned ? 'Unpin' : 'Pin') . '">'
                . '<i class="fa-solid fa-thumbtack text-[11px]"></i>'
                . '</button>'
                . '</li>';
        }
    }

    return $html;
}
?>
<div x-data="nebulaMenu()" class="flex flex-col h-full">

    <!-- Pinned Items -->
    <?php if (!empty($pinnedItems)): ?>
        <div class="px-3 pt-4 pb-2">
            <p class="px-3 mb-2 text-[10px] font-semibold uppercase tracking-widest text-nebula-500">
                <i class="fa-solid fa-thumbtack mr-1"></i><?= $block->escapeHtml(__('Pinned')) ?>
            </p>
            <ul id="nebula-pinned-list" class="space-y-0.5">
                <?php foreach ($pinnedItems as $pinned): ?>
                    <?php $pinnedIcon = $pinned['icon'] ?? null; ?>
                    <li class="group flex items-center rounded-lg transition hover:bg-nebula-800/30"
                        data-pin-id="<?= htmlspecialchars($pinned['id'], ENT_QUOTES) ?>">
                        <span class="nebula-drag-handle flex items-center justify-center w-6 pl-2 cursor-grab text-white/40 hover:text-white">
                            <i class="fa-solid fa-grip-vertical text-[10px]"></i>
                        </span>
                        <a href="<?= htmlspecialchars($pinned['url'], ENT_QUOTES) ?>"
                           class="flex-1 flex items-center gap-2 px-2 py-1.5 text-sm transition
                                  <?= $pinned['isActive'] ? 'text-white font-medium' : 'text-nebula-200 hover:text-white' ?>">
                            <?php if ($pinnedIcon): ?>
                                <i class="<?= $pinnedIcon ?> w-4 text-center text-xs opacity-70"></i>
                            <?php endif; ?>
                            <span class="truncate"><?= htmlspecialchars($pinned['title'], ENT_QUOTES) ?></span>
                        </a>
                        <button type="button"
                                @click.stop.prevent="togglePin('<?= htmlspecialchars($pinned['id'], ENT_QUOTES) ?>')"
                                class="flex items-center justify-center w-7 h-7 mr-1 rounded-md text-white/40 hover:text-red-400 hover:bg-red-400/10 transition cursor-pointer"
                                title="<?= $block->escapeHtmlAttr(__('Unpin')) ?>">
                            <i class="fa-solid fa-times text-xs"></i>
                        </button>
                    </li>
                <?php endforeach; ?>
            </ul>
        </div>
        <div class="mx-5 border-t border-nebula-800"></div>
    <?php endif; ?>

    <!-- Main Menu -->
    <ul class="flex-1 space-y-0.5 px-3 py-3">
        <?= /* @noEscape */ renderNebulaItems($items, $pinnedIds, $pinUrl) ?>
    </ul>

    <!-- Sidebar Footer -->
    <div class="nebula-sidebar-footer border-t border-nebula-800 px-3 py-3 space-y-0.5">
        <a href="#"
           class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-nebula-400 hover:bg-nebula-800/30 hover:text-white transition">
            <i class="fa-solid fa-compass w-5 text-center text-xs opacity-60 shrink-0"></i>
            <span class="flex-1 nebula-menu-text"><?= $block->escapeHtml(__("What's new")) ?></span>
            <span class="nebula-menu-text nebula-accent-badge inline-flex items-center rounded-full px-2 py-0.5 text-[10px] font-bold">3</span>
        </a>
        <a href="https://experienceleague.adobe.com/docs/commerce-admin/start/admin-workspace.html" target="_blank"
           class="flex items-center gap-2.5 rounded-lg px-3 py-2 text-sm text-nebula-400 hover:bg-nebula-800/30 hover:text-white transition">
            <i class="fa-solid fa-circle-question w-5 text-center text-xs opacity-60 shrink-0"></i>
            <span class="nebula-menu-text"><?= $block->escapeHtml(__('Help & Support')) ?></span>
        </a>
        <div class="px-3 pt-2 pb-1 nebula-menu-text">
            <p class="nebula-accent-soft text-[10px]">Qoliber Nebula v1.0</p>
        </div>
    </div>
</div>

<script>
    function nebulaMenu() {
        return {
            openSections: <?= /* @noEscape */ json_encode($activeParents) ?>,

            init() {
                const navContainer = this.$root.closest('nav');
                if (navContainer && !navContainer.hasAttribute('aria-label')) {
                    if (navContainer.classList.contains('nebula-sidebar-nav')) {
                        navContainer.setAttribute('aria-label', 'Sidebar navigation');
                    } else if (navContainer.classList.contains('nebula-topbar-nav')) {
                        navContainer.setAttribute('aria-label', 'Top navigation');
                    }
                }

                // Initialize SortableJS on pinned list
                const pinnedList = document.getElementById('nebula-pinned-list');
                if (pinnedList && typeof Sortable !== 'undefined') {
                    Sortable.create(pinnedList, {
                        handle: '.nebula-drag-handle',
                        animation: 150,
                        ghostClass: 'opacity-30',
                        chosenClass: 'bg-nebula-800',
                        onEnd: (evt) => { this.savePinOrder(); }
                    });
                }

                // UX contract: when the sidebar collapses, clear open submenu state.
                // This prevents stale sections from reopening unexpectedly later.
                const nebulaStore = window.Alpine && Alpine.store ? Alpine.store('nebula') : null;
                if (nebulaStore && window.Alpine && typeof Alpine.effect === 'function') {
                    Alpine.effect(() => {
                        if (nebulaStore.sidebarCollapsed) {
                            this.openSections = [];
                        }
                    });
                }
            },

            toggle(id) {
                // In collapsed mode, clicking a parent icon should expand the full sidebar
                // and keep the clicked section open.
                const nebulaStore = window.Alpine && Alpine.store ? Alpine.store('nebula') : null;
                if (nebulaStore && nebulaStore.sidebarCollapsed) {
                    if (!this.openSections.includes(id)) {
                        this.openSections.push(id);
                    }
                    nebulaStore.toggleSidebar();
                    return;
                }

                const i = this.openSections.indexOf(id);
                i > -1 ? this.openSections.splice(i, 1) : this.openSections.push(id);
            },

            isOpen(id) {
                return this.openSections.includes(id);
            },

            async togglePin(itemId) {
                try {
                    const formKey = document.querySelector('[name="form_key"]')?.value || '';
                    const resp = await fetch('<?= /* @noEscape */ $pinUrl ?>', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: new URLSearchParams({ item_id: itemId, form_key: formKey })
                    });
                    const data = await resp.json();
                    if (data.success) {
                        window.location.reload();
                    }
                } catch (e) {
                    console.error('Pin toggle failed:', e);
                }
            },

            async savePinOrder() {
                const items = document.querySelectorAll('#nebula-pinned-list [data-pin-id]');
                const order = Array.from(items).map(el => el.dataset.pinId);
                try {
                    const formKey = document.querySelector('[name="form_key"]')?.value || '';
                    await fetch('<?= $block->escapeJs($block->getUrl('nebula/menupin/reorder', ['_nosecret' => true])) ?>', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/x-www-form-urlencoded',
                            'X-Requested-With': 'XMLHttpRequest'
                        },
                        body: new URLSearchParams({ order: JSON.stringify(order), form_key: formKey })
                    });
                } catch (e) {
                    console.error('Reorder failed:', e);
                }
            }
        }
    }
</script>
