<?php

/**
 * PageBuilder field — delegates to the PageBuilder module's block.
 *
 * @var \Qoliber\NebulaForm\Block\Form $block
 */
$pbBlock = $block->getLayout()->createBlock(\Qoliber\NebulaPageBuilder\Block\PageBuilder::class);
$pbBlock->setData('field_name', $fieldName);
$pbBlock->setData('field_value', (string) ($fieldValue ?? ''));
$pbBlock->setData('form_key', $block->getFormKey());
echo '<div class="py-4">' . $pbBlock->toHtml() . '</div>';
