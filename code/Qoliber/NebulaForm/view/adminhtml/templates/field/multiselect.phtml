<?php
/**
 * Multiselect field — Alpine `nebulaField_multiselect` owns the value array.
 *
 * Shape-aware: if any resolved option carries a `depth` or `group` key the
 * field switches to tree mode. See ts/fields/multiselect.ts for the UI.
 *
 * Injected by the surrounding form-render partial in form.phtml — these
 * variables are template-local and PHPStan can't infer them from this file
 * alone. They're declared here so static analysis stays clean.
 *
 * @var \Qoliber\NebulaForm\Block\Form $block
 * @var \Magento\Framework\Escaper $escaper
 * @var array<string, mixed> $field
 * @var string $fieldName
 * @var string $fKey
 * @var mixed $fieldValue
 */
$options = [];
$tree = false;
foreach ($block->getFieldOptions($field) as $option) {
    if (!is_array($option)) {
        // Flat scalar option — { value, label } shape isn't a tree row.
        $optVal = $option;
        if ($optVal === '' || is_array($optVal)) {
            continue;
        }
        $options[] = ['value' => (string) $optVal, 'label' => (string) $optVal];
        continue;
    }

    $rowValue = array_key_exists('value', $option) ? $option['value'] : null;
    $rowLabel = (string) ($option['label'] ?? '');
    $rowDepth = $option['depth'] ?? null;
    $rowGroup = (bool) ($option['group'] ?? false);
    $rowAll   = (bool) ($option['all'] ?? false);

    // A group header is allowed to carry a null value; a leaf must have one.
    if (!$rowGroup) {
        if ($rowValue === null || $rowValue === '' || is_array($rowValue)) {
            continue;
        }
    }

    $row = ['value' => $rowValue === null ? null : (string) $rowValue, 'label' => $rowLabel];
    if ($rowDepth !== null) {
        $row['depth'] = (int) $rowDepth;
        $tree = true;
    }
    if ($rowGroup) {
        $row['group'] = true;
        $tree = true;
    }
    if ($rowAll) {
        // Forward the "all" sentinel marker — tree multiselect uses it to
        // enforce all-vs-specific exclusivity on toggle.
        $row['all'] = true;
    }
    $options[] = $row;
}

$selected = is_array($fieldValue)
    ? array_map('strval', $fieldValue)
    : array_filter(explode(',', (string) ($fieldValue ?? '')));
$selected = array_values(array_map('strval', $selected));

$placeholder = (string) ($field['placeholder'] ?? __('Search...'));
$fieldLabel = $block->translate((string) ($field['label'] ?? $fKey));

$configJson = json_encode([
    'fieldName' => $fieldName,
    'options' => $options,
    'value' => $selected,
    'tree' => $tree,
    'validation' => $field['validation'] ?? [],
], JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR);

ob_start();
?>
<div x-data="nebulaField_multiselect(<?= $escaper->escapeHtmlAttr($configJson) ?>)" class="relative">
    <!-- Tree mode: indented checkbox tree. -->
    <template x-if="tree">
        <div class="rounded-lg border border-gray-200 bg-white shadow-sm">
            <div class="border-b border-gray-100 px-3 py-2 flex items-center gap-2">
                <input type="text"
                       x-model="treeUi.search"
                       placeholder="<?= $escaper->escapeHtmlAttr($placeholder) ?>"
                       class="flex-1 rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none">
                <span class="text-xs text-gray-500"><span x-text="value.length"></span> <?= $escaper->escapeHtml((string) __('selected')) ?></span>
            </div>
            <div class="max-h-72 overflow-y-auto py-1.5 px-3">
                <template x-for="node in treeUi.visibleNodes()" :key="(node.value ?? '_g') + '@' + node.depth + '/' + node.label">
                    <div>
                        <div x-show="node.group"
                             :class="node.depth === 0 ? 'mt-1.5 text-xs font-bold uppercase tracking-wide text-gray-500' : 'mt-1 text-xs font-semibold text-gray-600'"
                             :style="'padding-left:' + (node.depth * 1) + 'rem'"
                             x-text="node.label"></div>
                        <label x-show="!node.group"
                               class="flex items-center gap-2 py-1 cursor-pointer hover:bg-gray-50 rounded px-1 -mx-1"
                               :style="'padding-left:' + (node.depth * 1 + 0.25) + 'rem'">
                            <input type="checkbox"
                                   :value="node.value"
                                   :checked="value.includes(node.value)"
                                   @change="value = treeUi.toggle(value, node)"
                                   class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                            <span class="text-sm text-gray-700" x-text="node.label"></span>
                        </label>
                    </div>
                </template>
            </div>
        </div>
    </template>

    <!-- Flat mode: existing dropdown / compact-grid behaviour. -->
    <template x-if="!tree">
        <div x-data="nebulaMultiselectUi({ placeholderText: '<?= $escaper->escapeJs($placeholder) ?>', labelText: '<?= $escaper->escapeJs($fieldLabel) ?>', compactThreshold: 12 })">
            <template x-if="options.length <= 12">
                <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
                    <template x-for="opt in options" :key="opt.value">
                        <label class="flex items-center gap-2 py-1 cursor-pointer hover:bg-gray-50 rounded px-1 -mx-1">
                            <input type="checkbox" :checked="isSelected(opt.value)" @change="toggle(opt.value)"
                                   class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                            <span class="text-sm text-gray-700" x-text="opt.label"></span>
                        </label>
                    </template>
                </div>
            </template>
            <template x-if="options.length > 12">
                <div class="flex items-center gap-2">
                    <div class="relative flex-1" @click.outside="showDropdown = false">
                        <input type="text" x-model="search" @focus="showDropdown = true"
                               placeholder="<?= $escaper->escapeHtmlAttr($placeholder) ?>"
                               class="w-full rounded-lg border border-gray-300 bg-white py-2 pl-3 pr-3 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none">
                    </div>
                </div>
            </template>
        </div>
    </template>
</div>
<?php
$fieldControl = (string) ob_get_clean();
include __DIR__ . '/_row.phtml';
