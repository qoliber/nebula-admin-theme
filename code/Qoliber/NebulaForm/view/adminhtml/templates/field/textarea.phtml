<?php

/** @var \Qoliber\NebulaForm\Block\Form $block */
$config = json_encode([
    'fieldName' => $fieldName,
    'value' => (string) ($fieldValue ?? ''),
    'disabled' => $isDisabled,
    'required' => $isRequired,
    'rows' => (int) ($field['rows'] ?? 5),
    'validation' => $field['validation'] ?? [],
], JSON_UNESCAPED_SLASHES);
$validateRules = [];
if ($isRequired) {
    $validateRules[] = 'required';
}
$validateAttr = $validateRules !== []
    ? ' data-validate="' . $escaper->escapeHtmlAttr(implode('|', $validateRules)) . '" data-validate-label="' . $escaper->escapeHtmlAttr($block->translate((string) ($field['label'] ?? $fKey))) . '"'
    : '';
$fieldControl = '<div x-data="nebulaField_textarea(' . htmlspecialchars((string) $config, ENT_QUOTES, 'UTF-8') . ')">'
    . '<textarea id="' . $escaper->escapeHtmlAttr($fieldId) . '"'
    . ' x-model="value"'
    . ' rows="' . (int) ($field['rows'] ?? 5) . '"'
    . $validateAttr
    . ($isDisabled ? ' disabled' : '')
    . ' placeholder="' . $escaper->escapeHtmlAttr($block->translate((string) ($field['placeholder'] ?? ''))) . '"'
    . ' class="block w-full rounded-lg border border-gray-300 py-2 px-3 text-sm text-gray-900 shadow-sm placeholder:text-gray-400 focus:border-nebula-500 focus:ring-2 focus:ring-nebula-500/20 focus:outline-none disabled:bg-gray-50 disabled:text-gray-500"></textarea>'
    . '</div>';
include __DIR__ . '/_row.phtml';
