<?php

/** @var \Qoliber\NebulaForm\Block\Form $block */
$options = [];
foreach ($block->getFieldOptions($field) as $option) {
    $optVal = is_array($option) ? ($option['value'] ?? '') : $option;
    $optLabel = is_array($option) ? ($option['label'] ?? '') : $option;
    if (is_array($optVal)) {
        continue;
    }
    $options[] = ['value' => (string) $optVal, 'label' => (string) $optLabel];
}
$config = json_encode([
    'fieldName' => $fieldName,
    'value' => (string) ($fieldValue ?? ''),
    'options' => $options,
    'disabled' => $isDisabled,
    'required' => $isRequired,
    'validation' => $field['validation'] ?? [],
], JSON_UNESCAPED_SLASHES);
$validateRules = [];
if ($isRequired) {
    $validateRules[] = 'required';
}
$validateAttr = $validateRules !== []
    ? ' data-validate="' . $escaper->escapeHtmlAttr(implode('|', $validateRules)) . '" data-validate-label="' . $escaper->escapeHtmlAttr($block->translate((string) ($field['label'] ?? $fKey))) . '"'
    : '';
$optionsHtml = '<option value="">' . $escaper->escapeHtml((string) __('-- Please Select --')) . '</option>';
foreach ($options as $option) {
    $optionsHtml .= '<option value="' . $escaper->escapeHtmlAttr($option['value']) . '">'
        . $escaper->escapeHtml($block->translate($option['label']))
        . '</option>';
}
$fieldControl = '<div x-data="nebulaField_select(' . htmlspecialchars((string) $config, ENT_QUOTES, 'UTF-8') . ')">'
    . '<select id="' . $escaper->escapeHtmlAttr($fieldId) . '" x-model="value"'
    . $validateAttr
    . ($isDisabled ? ' disabled' : '')
    . ' class="block w-full rounded-lg border border-gray-300 py-2 px-3 text-sm text-gray-900 shadow-sm focus:border-nebula-500 focus:ring-2 focus:ring-nebula-500/20 focus:outline-none disabled:bg-gray-50 disabled:text-gray-500">'
    . $optionsHtml
    . '</select></div>';
include __DIR__ . '/_row.phtml';
