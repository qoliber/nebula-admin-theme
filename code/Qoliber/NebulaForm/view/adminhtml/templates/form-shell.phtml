<?php
/**
 * Shared chrome for every Nebula form (Simple + EAV).
 *
 * Emits the <form>, form_key, CSRF, route-marker hidden fields, the header
 * (back button, title, badge, action buttons), and opens the body area.
 * The caller is responsible for closing the form body markup. This partial
 * provides both an `header` and a `body-open` hook via data params so the
 * outer template can simply include this, then render its body, then
 * `include form-shell-close.phtml`.
 *
 * The caller (outer template) is expected to declare:
 *   $block        : Qoliber\NebulaForm\Block\Form | Qoliber\NebulaForm\Block\EavForm
 *   $title        : string — page heading.
 *   $subtitle     : string|null — optional subtitle rendered below the heading.
 *   $statusLabel  : string|null — optional status pill.
 *   $statusClass  : string — CSS classes for the status pill (if present).
 *   $hasFiles     : bool — whether the form needs multipart encoding.
 *   $formRef      : string — x-ref name ('nebulaForm' or 'nebulaEavForm').
 *   $routeFields  : array<string, string> — hidden route markers (NOT business data).
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var string $title
 * @var string|null $subtitle
 * @var string|null $statusLabel
 * @var string $statusClass
 * @var bool $hasFiles
 * @var string $formRef
 * @var array<string, string> $routeFields
 * @var string $formKey
 * @var string $saveUrl
 * @var string $backUrl
 * @var string $deleteUrl
 * @var bool $isNew
 */
$subtitle ??= null;
$statusLabel ??= null;
$statusClass ??= '';
$hasFiles ??= false;
$formRef ??= 'nebulaForm';
$routeFields ??= [];
$scopeSwitcherHtml = $block->getChildHtml('scope_switcher');
?>
<style>
    /* Hide Magento's default page title block on form pages — the form-shell
       renders its own h1 + actions bar below, so the stock .page-title-wrapper
       is a duplicate that just wastes vertical space. Other children of
       .nebula-page-actions (session-warning modal, flash messages) keep working. */
    .nebula-page-actions .page-title-wrapper { display: none !important; }
    .nebula-page-actions { margin: 0 !important; padding: 0 !important; min-height: 0 !important; }
</style>
<div x-data="nebulaForm({formKey: '<?= $escaper->escapeJs($formKey) ?>'})" class="w-full">

    <div class="nebula-form-actions-bar sticky top-0 z-30 mb-6 shadow-sm backdrop-blur-sm">
        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">
            <div class="flex min-w-0 flex-1 items-center gap-4">
                <div>
                    <div class="flex items-center gap-3">
                        <h1 class="text-xl font-bold text-gray-900"><?= $escaper->escapeHtml($title) ?></h1>
                        <?php if ($statusLabel !== null && $statusLabel !== '') : ?>
                        <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-semibold ring-1 ring-inset <?= /* @noEscape */ $statusClass ?>"><?= $escaper->escapeHtml($statusLabel) ?></span>
                        <?php endif; ?>
                    </div>
                    <?php if ($subtitle !== null && $subtitle !== '') : ?>
                    <p class="text-xs text-gray-500 mt-0.5"><?= $escaper->escapeHtml($subtitle) ?></p>
                    <?php endif; ?>
                </div>
            </div>
            <div class="nebula-form-actions-right flex flex-wrap items-center gap-3">
                <?php if ($scopeSwitcherHtml): ?>
                    <div class="shrink-0">
                        <?= /* @noEscape */ $scopeSwitcherHtml ?>
                    </div>
                <?php endif; ?>
                <?= $block->getChildHtml('actions_before_back') ?>
                <a href="<?= $escaper->escapeUrl($backUrl) ?>"
                   class="inline-flex items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm border border-gray-300 transition hover:bg-gray-50">
                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 19.5 8.25 12l7.5-7.5"/></svg>
                    <?= $escaper->escapeHtml((string) __('Back')) ?>
                </a>
                <div class="nebula-form-actions-divider h-6 w-px bg-gray-200 hidden sm:block"></div>
                <?php if (!$isNew && $deleteUrl) : ?>
                <button type="button"
                        @click="(async () => { if (await window.Nebula.confirm({ title: '<?= $escaper->escapeJs((string) __('Delete this item?')) ?>', message: '<?= $escaper->escapeJs((string) __('This action cannot be undone.')) ?>', danger: true, confirmText: '<?= $escaper->escapeJs((string) __('Delete')) ?>' })) { const f = document.createElement('form'); f.method = 'POST'; f.action = '<?= $escaper->escapeJs($deleteUrl) ?>'; const k = document.createElement('input'); k.type = 'hidden'; k.name = 'form_key'; k.value = '<?= $escaper->escapeJs($formKey) ?>'; f.appendChild(k); document.body.appendChild(f); f.submit(); } })()"
                        class="inline-flex items-center gap-1.5 rounded-lg bg-red-50 px-4 py-2 text-sm font-semibold text-red-700 ring-1 ring-inset ring-red-200 transition hover:bg-red-100">
                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0"/></svg>
                    <?= $escaper->escapeHtml((string) __('Delete')) ?>
                </button>
                <?php endif; ?>
                <button type="button"
                        @click="saveWithBack($refs.<?= /* @noEscape */ $formRef ?>, 'continue')"
                        data-nebula-save-action="saveWithBack"
                        :disabled="saving"
                        class="inline-flex items-center gap-1.5 rounded-lg bg-white px-4 py-2.5 text-sm font-semibold text-gray-700 shadow-sm border border-gray-300 transition hover:bg-gray-50 disabled:opacity-50">
                    <svg :class="saving && saveAndContinue ? 'animate-spin' : ''" class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182"/></svg>
                    <?= $escaper->escapeHtml((string) __('Save & Continue')) ?>
                </button>
                <button type="button"
                        @click="saveWithBack($refs.<?= /* @noEscape */ $formRef ?>, '')"
                        data-nebula-save-action="saveWithBack"
                        :disabled="saving"
                        class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-indigo-500 disabled:opacity-50">
                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/></svg>
                    <?= $escaper->escapeHtml((string) __('Save')) ?>
                </button>
            </div>
        </div>
    </div>

    <form x-ref="<?= /* @noEscape */ $formRef ?>"
          method="post"
          action="<?= $escaper->escapeUrl($saveUrl) ?>"
          <?php if ($hasFiles) :
              ?>enctype="multipart/form-data"<?php
          endif; ?>>
        <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>">
        <input type="hidden" name="nebula_form_id" value="<?= $escaper->escapeHtmlAttr($block->getFormId()) ?>">
        <?php foreach ($routeFields as $name => $value) : ?>
        <input type="hidden" name="<?= $escaper->escapeHtmlAttr((string) $name) ?>" value="<?= $escaper->escapeHtmlAttr((string) $value) ?>">
        <?php endforeach; ?>
