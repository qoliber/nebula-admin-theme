{
  "id": "report_sales_shipping",
  "acl": "Magento_Reports::salesroot_shipping",
  "dataSource": {
    "provider": "grid.collection",
    "config": {
      "collection": "report_sales_shipping.collection"
    }
  },
  "settings": {
    "pageSize": 100,
    "pageSizes": [50, 100, 200],
    "defaultSort": {
      "field": "period",
      "direction": "asc"
    },
    "massActions": false
  },
  "columns": {
    "period": {
      "label": "Interval",
      "type": "text",
      "sortable": false,
      "position": 10
    },
    "shipping_description": {
      "label": "Carrier/Method",
      "type": "text",
      "sortable": false,
      "position": 20
    },
    "orders_count": {
      "label": "Orders",
      "type": "text",
      "sortable": false,
      "position": 30
    },
    "total_shipping": {
      "label": "Total Sales Shipping",
      "type": "price",
      "sortable": false,
      "position": 40
    },
    "total_shipping_actual": {
      "label": "Total Shipping",
      "type": "price",
      "sortable": false,
      "position": 50
    }
  }
}
