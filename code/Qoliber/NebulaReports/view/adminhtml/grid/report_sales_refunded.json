{
  "id": "report_sales_refunded",
  "acl": "Magento_Reports::salesroot_refunded",
  "dataSource": {
    "provider": "grid.collection",
    "config": {
      "collection": "report_sales_refunded.collection"
    }
  },
  "settings": {
    "pageSize": 100,
    "pageSizes": [50, 100, 200],
    "defaultSort": {
      "field": "period",
      "direction": "asc"
    },
    "massActions": false
  },
  "columns": {
    "period": {
      "label": "Interval",
      "type": "text",
      "sortable": false,
      "position": 10
    },
    "orders_count": {
      "label": "Refunded Orders",
      "type": "text",
      "sortable": false,
      "position": 20
    },
    "refunded": {
      "label": "Total Refunded",
      "type": "price",
      "sortable": false,
      "position": 30
    },
    "online_refunded": {
      "label": "Online Refunds",
      "type": "price",
      "sortable": false,
      "position": 40
    },
    "offline_refunded": {
      "label": "Offline Refunds",
      "type": "price",
      "sortable": false,
      "position": 50
    }
  }
}
