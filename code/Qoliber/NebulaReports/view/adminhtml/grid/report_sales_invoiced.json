{
  "id": "report_sales_invoiced",
  "acl": "Magento_Reports::salesroot_invoiced",
  "dataSource": {
    "provider": "grid.collection",
    "config": {
      "collection": "report_sales_invoiced.collection"
    }
  },
  "settings": {
    "pageSize": 100,
    "pageSizes": [50, 100, 200],
    "defaultSort": {
      "field": "period",
      "direction": "asc"
    },
    "massActions": false
  },
  "columns": {
    "period": {
      "label": "Interval",
      "type": "text",
      "sortable": false,
      "position": 10
    },
    "orders_count": {
      "label": "Orders",
      "type": "text",
      "sortable": false,
      "position": 20
    },
    "orders_invoiced": {
      "label": "Invoiced Orders",
      "type": "text",
      "sortable": false,
      "position": 30
    },
    "invoiced": {
      "label": "Total Invoiced",
      "type": "price",
      "sortable": false,
      "position": 40
    },
    "invoiced_captured": {
      "label": "Paid Invoices",
      "type": "price",
      "sortable": false,
      "position": 50
    },
    "invoiced_not_captured": {
      "label": "Unpaid Invoices",
      "type": "price",
      "sortable": false,
      "position": 60
    }
  }
}
