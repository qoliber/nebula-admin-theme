{
  "id": "report_sales_tax",
  "acl": "Magento_Reports::salesroot_tax",
  "dataSource": {
    "provider": "grid.collection",
    "config": {
      "collection": "report_sales_tax.collection"
    }
  },
  "settings": {
    "pageSize": 100,
    "pageSizes": [50, 100, 200],
    "defaultSort": {
      "field": "period",
      "direction": "asc"
    },
    "massActions": false
  },
  "columns": {
    "period": {
      "label": "Interval",
      "type": "text",
      "sortable": false,
      "position": 10
    },
    "code": {
      "label": "Tax",
      "type": "text",
      "sortable": false,
      "position": 20
    },
    "percent": {
      "label": "Rate",
      "type": "text",
      "sortable": false,
      "position": 30
    },
    "orders_count": {
      "label": "Orders",
      "type": "text",
      "sortable": false,
      "position": 40
    },
    "tax_base_amount_sum": {
      "label": "Tax Amount",
      "type": "price",
      "sortable": false,
      "position": 50
    }
  }
}
