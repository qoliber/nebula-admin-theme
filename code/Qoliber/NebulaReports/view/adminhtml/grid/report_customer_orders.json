{
  "id": "report_customer_orders",
  "acl": "Magento_Reports::customers_orders",
  "dataSource": {
    "provider": "grid.collection",
    "config": {
      "collection": "report_customer_orders.collection"
    }
  },
  "settings": {
    "pageSize": 100,
    "pageSizes": [50, 100, 200],
    "defaultSort": {
      "field": "orders_count",
      "direction": "desc"
    },
    "massActions": false
  },
  "columns": {
    "name": {
      "label": "Customer",
      "type": "text",
      "sortable": false,
      "position": 10
    },
    "orders_count": {
      "label": "Orders",
      "type": "text",
      "sortable": false,
      "position": 20
    },
    "orders_avg_amount": {
      "label": "Average",
      "type": "price",
      "sortable": false,
      "position": 30
    },
    "orders_sum_amount": {
      "label": "Total",
      "type": "price",
      "sortable": false,
      "position": 40
    }
  }
}
