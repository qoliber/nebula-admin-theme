    <preference for="Magento\Backend\Block\Menu" type="Qoliber\Nebula\Block\Menu" />
    <preference for="Magento\Config\Block\System\Config\Form\Field" type="Qoliber\Nebula\Block\Config\Form\Field" />
    <preference
        for="Magento\Config\Block\System\Config\Form\Fieldset"
        type="Qoliber\Nebula\Block\Config\Form\Fieldset"
    />
    <preference for="Magento\Config\Block\System\Config\Form" type="Qoliber\Nebula\Block\Config\Form" />
    <preference
        for="Magento\Backend\Block\Widget\Form\Element\Dependence"
        type="Qoliber\Nebula\Block\Widget\Form\Element\Dependence"
    />
    <preference
        for="Magento\MediaStorage\Block\System\Config\System\Storage\Media\Synchronize"
        type="Qoliber\Nebula\Block\Config\Form\Field\MediaSynchronize"
    />

    <type name="Magento\Config\Block\System\Config\Form\Field\FieldArray\AbstractFieldArray">
        <plugin
            name="qoliber_nebula_array_field_render"
            type="Qoliber\Nebula\Plugin\Config\ArrayFieldRenderPlugin"
            sortOrder="10"
        />
    </type>

    <type name="Magento\Framework\View\Page\Config\Renderer">
        <plugin
            name="qoliber_nebula_menu_position_body_class"
            type="Qoliber\Nebula\Plugin\AddMenuPositionBodyClass"
            sortOrder="10"
        />
    </type>

    <type name="Magento\Framework\View\Model\Layout\Merge">
        <plugin
            name="qoliber_nebula_swap_page_layout_for_top_menu"
            type="Qoliber\Nebula\Plugin\SwapPageLayoutForTopMenu"
            sortOrder="20"
        />
    </type>

    <type name="Magento\Theme\Model\View\Design">
        <plugin name="qoliber_nebula_force_theme" type="Qoliber\Nebula\Plugin\ForceAdminTheme" sortOrder="100" />
    </type>

    <type name="Qoliber\NebulaForm\Block\EavForm">
        <plugin
            name="qoliber_nebula_product_edit_form_id_swap"
            type="Qoliber\Nebula\Plugin\UseTabbedProductEditForm"
            sortOrder="10"
        />
        <plugin
            name="qoliber_nebula_category_refresh_form_id_swap"
            type="Qoliber\Nebula\Plugin\UseCategoryRefreshForm"
            sortOrder="20"
        />
    </type>
    <type name="Qoliber\NebulaForm\Block\Form">
        <plugin
            name="qoliber_nebula_cms_page_edit_form_id_swap"
            type="Qoliber\Nebula\Plugin\UseTabbedCmsPageEditForm"
            sortOrder="10"
        />
        <plugin
            name="qoliber_nebula_cms_block_edit_form_id_swap"
            type="Qoliber\Nebula\Plugin\UseTabbedCmsBlockEditForm"
            sortOrder="20"
        />
    </type>

    <!--
        Nebula sidebar menu icon registry. Single source of truth for the
        Font Awesome (or image, or custom-type) icon rendered next to every
        menu item. Custom modules extend the `icons` argument from their
        own etc/adminhtml/di.xml to add or override:

            <type name="Qoliber\Nebula\Model\Menu\MenuIconRegistry">
                <arguments>
                    <argument name="icons" xsi:type="array">
                        <item name="Acme_Catalog::dashboard" xsi:type="array">
                            <item name="class" xsi:type="string">fa-solid fa-rocket</item>
                        </item>
                        <item name="Acme_Catalog::brand" xsi:type="array">
                            <item name="type" xsi:type="string">image</item>
                            <item name="src"  xsi:type="string">Acme_Catalog::images/logo.svg</item>
                            <item name="alt"  xsi:type="string">Acme</item>
                        </item>
                    </argument>
                </arguments>
            </type>

        New icon TYPES register under the `renderers` argument:

            <argument name="renderers" xsi:type="array">
                <item name="inline-svg" xsi:type="object">Acme\Catalog\Model\Menu\InlineSvgRenderer</item>
            </argument>

        No JS rebuild, no template edit — picked up on next request after
        `cache:clean config`.
    -->
    <type name="Qoliber\Nebula\Model\Menu\MenuIconRegistry">
        <arguments>
            <argument name="defaultType" xsi:type="string">fontawesome</argument>
            <argument name="default" xsi:type="array">
                <item name="class" xsi:type="string">fa-solid fa-circle-dot</item>
            </argument>
            <argument name="renderers" xsi:type="array">
                <item name="fontawesome" xsi:type="object">Qoliber\Nebula\Model\Menu\Renderer\FontawesomeRenderer</item>
                <item name="image"       xsi:type="object">Qoliber\Nebula\Model\Menu\Renderer\ImageRenderer</item>
            </argument>
            <argument name="icons" xsi:type="array">
