<?xml version="1.0"?>
<!--
    Declares Nebula's own ACL resources. Every definition JSON references
    a vendor Magento_* resource directly (Catalog::products, Customer::customer,
    etc.) and does not need a Nebula-side declaration. This file exists so the
    system.xml `<resource>Qoliber_Nebula::config</resource>` reference resolves
    against a real ACL node — without it Magento silently treats the resource
    as missing and the Nebula admin config section is invisible to permission
    sets that don't already inherit Magento_Config::config.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Qoliber_Nebula::config" title="Nebula" sortOrder="100"/>
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
