          "styles": {
            "text-align": { "source": "text_align" },
            "border-style": { "source": "border_style", "converter": "borderStyle" },
            "border-color": { "source": "border_color" },
            "border-width": { "source": "border_width" },
            "border-radius": { "source": "border_radius" },
            "display": { "source": "display", "converter": "display" },
            "margin": { "source": "margins_and_padding", "converter": "margins" },
            "padding": { "source": "margins_and_padding", "converter": "paddings" }
          },
          "cssSource": "css_classes"
        }
      }
    }
  },
