                            <input type="text" class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none"
                                   :value="getEditingNode()?.data?.button_color||''" @input="updateNodeData(editingNodeId,'button_color',$event.target.value)">
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1.5"><?= $escaper->escapeHtml((string) __('Border Radius')) ?></label>
                        <input type="text" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none"
                               placeholder="e.g. 4px" :value="getEditingNode()?.data?.border_radius||''" @input="updateNodeData(editingNodeId,'border_radius',$event.target.value)">
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1.5"><?= $escaper->escapeHtml((string) __('CSS Classes')) ?></label>
                        <input type="text" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none"
                               :value="getEditingNode()?.data?.css_classes||''" @input="updateNodeData(editingNodeId,'css_classes',$event.target.value)">
                    </div>
                </div>
            </template>

            <!-- Buttons container -->
            <template x-if="getEditingNode()?.type==='buttons'">
                <div class="space-y-4">
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1.5"><?= $escaper->escapeHtml((string) __('Appearance')) ?></label>
                        <div class="flex gap-1.5">
                            <template x-for="ap in ['inline','stacked']" :key="ap">
                                <button type="button" class="flex-1 rounded-lg border px-3 py-2 text-xs font-semibold transition capitalize"
                                        :class="(getEditingNode()?.data?.appearance||'inline')===ap?'border-indigo-500 bg-indigo-50 text-indigo-700':'border-gray-300 text-gray-500 hover:bg-gray-50'"
                                        @click="updateNodeData(editingNodeId,'appearance',ap)" x-text="ap"></button>
                            </template>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-medium text-gray-700 mb-1.5"><?= $escaper->escapeHtml((string) __('Alignment')) ?></label>
                        <div class="flex gap-1">
                            <template x-for="a in [{v:'',i:'fa-align-justify'},{v:'left',i:'fa-align-left'},{v:'center',i:'fa-align-center'},{v:'right',i:'fa-align-right'}]" :key="'b'+a.v">
                                <button type="button" class="flex-1 rounded-lg border px-2 py-2 text-xs transition flex items-center justify-center"
                                        :aria-label="'<?= $escaper->escapeJs((string) __('Align buttons')) ?>: ' + (a.v || 'default')"
                                        :title="'<?= $escaper->escapeJs((string) __('Align buttons')) ?>: ' + (a.v || 'default')"
                                        :class="(getEditingNode()?.data?.text_align||'')===a.v?'border-indigo-500 bg-indigo-50 text-indigo-700':'border-gray-300 text-gray-500 hover:bg-gray-50'"
                                        @click="updateNodeData(editingNodeId,'text_align',a.v)"><i :class="'fa-solid '+a.i"></i></button>
                            </template>
                        </div>
                    </div>
                    <div>
                        <label :for="'pb-buttons-css-classes-' + editingNodeId" class="block text-xs font-medium text-gray-700 mb-1.5"><?= $escaper->escapeHtml((string) __('CSS Classes')) ?></label>
                        <input :id="'pb-buttons-css-classes-' + editingNodeId" type="text" class="w-full rounded-lg border border-gray-300 px-3 py-2 text-sm focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none"
                               aria-label="<?= $escaper->escapeHtmlAttr((string) __('CSS Classes')) ?>"
                               title="<?= $escaper->escapeHtmlAttr((string) __('CSS Classes')) ?>"
                               :value="getEditingNode()?.data?.css_classes||''" @input="updateNodeData(editingNodeId,'css_classes',$event.target.value)">
                    </div>
                </div>
            </template>
        </div>
    </template>
</div>
