<?php

declare(strict_types=1);

/** @var \Qoliber\NebulaPageBuilder\Block\MasterTemplate $block */
$data = $block->getNodeData();
$elements = $block->getElements();
$link = $elements['link'] ?? [];
$linkStyle = $block->buildStyleString($link['styles'] ?? []);
$text = $data['button_text'] ?? 'Button';
$url = $data['link_url'] ?? '#';
$target = $data['link_target'] ?? '';
$buttonType = $data['button_type'] ?? 'primary';
$cssClasses = implode(' ', $link['cssClasses'] ?? []);
$btnClass = 'pagebuilder-button-' . $buttonType;
if ($cssClasses) {
    $btnClass .= ' ' . $cssClasses;
}
?><div data-content-type="button-item" data-appearance="default"><a class="<?= $escaper->escapeHtmlAttr($btnClass) ?>" href="<?= $escaper->escapeUrl($url) ?>"<?php if ($target) :
    ?> target="<?= $escaper->escapeHtmlAttr($target) ?>"<?php
endif; ?><?php if ($linkStyle) :
    ?> style="<?= $escaper->escapeHtmlAttr($linkStyle) ?>"<?php
endif; ?>><?= $escaper->escapeHtml($text) ?></a></div>
