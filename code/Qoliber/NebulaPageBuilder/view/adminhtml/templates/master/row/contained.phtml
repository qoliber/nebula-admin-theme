<?php

declare(strict_types=1);

/** @var \Qoliber\NebulaPageBuilder\Block\MasterTemplate $block */
$elements = $block->getElements();
$main = $elements['main'] ?? [];
$inner = $elements['inner'] ?? [];
$childrenHtml = $block->getChildrenHtml();
$mainStyle = $block->buildStyleString($main['styles'] ?? []);
$innerStyle = $block->buildStyleString($inner['styles'] ?? []);
$innerAttrs = $block->buildAttributeString($inner['attributes'] ?? []);
$innerClasses = implode(' ', $inner['cssClasses'] ?? []);
$innerCombinedClasses = trim('flex flex-col ' . $innerClasses);
?><div data-content-type="row" data-appearance="contained"<?php if ($mainStyle) :
    ?> style="<?= $escaper->escapeHtmlAttr($mainStyle) ?>"<?php
endif; ?>><div class="<?= $escaper->escapeHtmlAttr($innerCombinedClasses) ?>"<?php if ($innerStyle) :
    ?> style="<?= $escaper->escapeHtmlAttr($innerStyle) ?>"<?php
endif; ?> <?= /* @noEscape */ $innerAttrs ?>><?= /* @noEscape */ $childrenHtml ?></div></div>
