$rowClasses = trim('flex flex-col ' . $mainClasses);
?><div data-content-type="row" data-appearance="full-bleed" class="<?= $escaper->escapeHtmlAttr($rowClasses) ?>"<?php if ($mainStyle) :
    ?> style="<?= $escaper->escapeHtmlAttr($mainStyle) ?>"<?php
endif; ?> <?= /* @noEscape */ $mainAttrs ?>><?= /* @noEscape */ $childrenHtml ?></div>
