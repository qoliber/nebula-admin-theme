<?php

declare(strict_types=1);

/** @var \Qoliber\NebulaPageBuilder\Block\MasterTemplate $block */
$elements = $block->getElements();
$main = $elements['main'] ?? [];
$childrenHtml = $block->getChildrenHtml();
$mainStyle = $block->buildStyleString($main['styles'] ?? []);
$classes = array_merge(['pagebuilder-column'], $main['cssClasses'] ?? []);
$data = $block->getNodeData();
$width = $data['width'] ?? '50%';
$columnClasses = implode(' ', array_merge($classes, ['self-stretch', 'flex', 'flex-col']));
$columnStyle = 'width: ' . $width . ';' . ($mainStyle ? ' ' . $mainStyle : '');
?><div class="<?= $escaper->escapeHtmlAttr($columnClasses) ?>" data-content-type="column" data-appearance="<?= $escaper->escapeHtmlAttr($block->getAppearance()) ?>" style="<?= $escaper->escapeHtmlAttr($columnStyle) ?>"><?= /* @noEscape */ $childrenHtml ?></div>
