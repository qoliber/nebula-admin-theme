<?php

declare(strict_types=1);

/** @var \Qoliber\NebulaPageBuilder\Block\MasterTemplate $block */
$elements = $block->getElements();
$main = $elements['main'] ?? [];
$data = $block->getNodeData();
$mainStyle = $block->buildStyleString($main['styles'] ?? []);
$classes = implode(' ', $main['cssClasses'] ?? []);
$imageUrl = $data['image_url'] ?? '';
$alt = $data['alt_text'] ?? '';
$title = $data['title_text'] ?? '';
$linkUrl = $data['link_url'] ?? '';
$linkTarget = $data['link_target'] ?? '';
$caption = $data['caption'] ?? '';
$maxWidth = $data['max_width'] ?? '';
$imgStyle = $maxWidth ? 'max-width: ' . $escaper->escapeHtmlAttr($maxWidth) : '';
?><figure data-content-type="image" data-appearance="default"<?php if ($classes) :
    ?> class="<?= $escaper->escapeHtmlAttr($classes) ?>"<?php
endif; ?><?php if ($mainStyle) :
    ?> style="<?= $escaper->escapeHtmlAttr($mainStyle) ?>"<?php
endif; ?>><?php if ($linkUrl) :
    ?><a href="<?= $escaper->escapeUrl($linkUrl) ?>"<?php if ($linkTarget) :
        ?> target="<?= $escaper->escapeHtmlAttr($linkTarget) ?>"<?php
    endif; ?>><?php
endif; ?><?php if ($imageUrl) :
    ?><img src="<?= $escaper->escapeUrl($imageUrl) ?>" alt="<?= $escaper->escapeHtmlAttr($alt) ?>"<?php if ($title) :
        ?> title="<?= $escaper->escapeHtmlAttr($title) ?>"<?php
    endif; ?><?php if ($imgStyle) :
        ?> style="<?= $escaper->escapeHtmlAttr($imgStyle) ?>"<?php
    endif; ?>><?php
endif; ?><?php if ($linkUrl) :
    ?></a><?php
endif; ?><?php if ($caption) :
    ?><figcaption><?= $escaper->escapeHtml($caption) ?></figcaption><?php
endif; ?></figure>
