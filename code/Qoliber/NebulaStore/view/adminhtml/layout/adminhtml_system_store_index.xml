<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="adminhtml.system.store.container" remove="true"/>
        <referenceContainer name="page.main.actions" remove="true"/>
        <referenceContainer name="content" htmlTag="div">
            <block class="Magento\Backend\Block\Template"
                   name="nebula.stores_tree"
                   template="Qoliber_NebulaStore::snippet/stores_tree.phtml"
                   after="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Qoliber\NebulaStore\ViewModel\StoresTree</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
