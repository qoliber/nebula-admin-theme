<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="design_config_listing" remove="true"/>
        <referenceContainer name="content" htmlTag="div">
            <block class="Magento\Backend\Block\Template"
                   name="nebula.design_config_tree"
                   template="Qoliber_NebulaStore::snippet/design_config_tree.phtml"
                   after="-">
                <arguments>
                    <argument name="view_model" xsi:type="object">Qoliber\NebulaStore\ViewModel\DesignConfigTree</argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>
