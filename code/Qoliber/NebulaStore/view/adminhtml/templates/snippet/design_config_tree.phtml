<script>
(function () {
    if (window._nebulaDesignConfigTreeRegistered) {
        return;
    }
    window._nebulaDesignConfigTreeRegistered = true;

    var register = function () {
        Alpine.data('nebulaDesignConfigTree', function (initialWebsites) {
            var websites = (initialWebsites || []).map(function (w) {
                return Object.assign({}, w, {
                    _open: true,
                    groups: (w.groups || []).map(function (g) {
                        return Object.assign({}, g, { stores: g.stores || [] });
                    })
                });
            });
            return {
                websites: websites,
                search: '',
                toggle: function (node) { node._open = !node._open; },
                expandAll: function () {
                    this.websites.forEach(function (w) { w._open = true; });
                },
                collapseAll: function () {
                    this.websites.forEach(function (w) { w._open = false; });
                },
                onSearch: function () {
                    if (this.search.trim().length > 0) this.expandAll();
                },
                _matches: function (text) {
                    var q = this.search.trim().toLowerCase();
                    if (q.length === 0) return true;
                    return String(text || '').toLowerCase().indexOf(q) !== -1;
                },
                _storeMatches: function (s) {
                    return this._matches(s.name) || this._matches(s.code);
                },
                _groupMatches: function (g) {
                    if (this._matches(g.name)) return true;
                    return g.stores.some(this._storeMatches.bind(this));
                },
                _websiteMatches: function (w) {
                    if (this._matches(w.name) || this._matches(w.code)) return true;
                    return w.groups.some(this._groupMatches.bind(this));
                },
                visibleWebsites: function () {
                    if (this.search.trim().length === 0) return this.websites;
                    return this.websites.filter(this._websiteMatches.bind(this));
                },
                visibleGroups: function (website) {
                    if (this.search.trim().length === 0) return website.groups;
                    if (this._matches(website.name) || this._matches(website.code)) {
                        return website.groups;
                    }
                    return website.groups.filter(this._groupMatches.bind(this));
                },
                visibleStores: function (group) {
                    if (this.search.trim().length === 0) return group.stores;
                    if (this._matches(group.name)) return group.stores;
                    return group.stores.filter(this._storeMatches.bind(this));
                }
            };
        });
    };

    if (window.Alpine) {
        register();
    } else {
        document.addEventListener('alpine:init', register);
    }
})();
</script>
