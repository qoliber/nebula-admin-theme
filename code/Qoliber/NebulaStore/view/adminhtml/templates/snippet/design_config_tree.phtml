    throw new \RuntimeException(
        'Nebula snippet "design_config_tree (layout XML)": view_model was not injected '
        . '(expected \Qoliber\NebulaStore\ViewModel\DesignConfigTree). Check the SnippetViewModelRegistry binding or layout wiring.'
    );
}

$defaultScope = $viewModel->getDefaultScope();
$tree = $viewModel->getTree();
$treeJson = json_encode($tree, JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR);
