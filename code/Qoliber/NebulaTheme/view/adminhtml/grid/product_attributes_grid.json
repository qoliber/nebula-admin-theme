{
  "id": "product_attributes_grid",
  "acl": "Magento_Catalog::attributes_attributes",
  "dataSource": {
    "provider": "grid.collection",
    "config": {
      "collection": "product_attributes.collection"
    }
  },
  "settings": {
    "pageSize": 50,
    "pageSizes": [20, 50, 100, 200],
    "defaultSort": {
      "field": "attribute_code",
      "direction": "asc"
    },
    "massActions": false,
    "addButton": {
      "label": "Add Attribute",
      "url": "catalog/product_attribute/new"
    }
  },
  "columns": {
    "attribute_id": {
      "label": "ID",
      "type": "text",
      "sortable": true,
      "filter": "range",
      "position": 10
    },
    "attribute_code": {
      "label": "Attribute Code",
      "type": "text",
      "sortable": true,
      "filter": "text",
      "searchable": true,
      "position": 20
    },
    "frontend_label": {
      "label": "Label",
      "type": "text",
      "sortable": true,
      "filter": "text",
      "searchable": true,
      "position": 30
    },
    "frontend_input": {
      "label": "Input Type",
      "type": "text",
      "sortable": true,
      "filter": "select",
      "filterOptionsSource": "Magento\\Catalog\\Model\\Product\\Attribute\\Source\\Inputtype",
      "position": 40
    },
    "is_required": {
      "label": "Required",
      "renderer": "snippet.boolean_badge",
      "sortable": true,
      "filter": "select",
      "filterOptionsSource": "Magento\\Config\\Model\\Config\\Source\\Yesno",
      "position": 50
    },
    "is_user_defined": {
      "label": "User Defined",
      "renderer": "snippet.boolean_badge",
      "sortable": true,
      "filter": "select",
      "filterOptionsSource": "Magento\\Config\\Model\\Config\\Source\\Yesno",
      "position": 60
    },
    "is_visible": {
      "label": "Visible",
      "renderer": "snippet.boolean_badge",
      "sortable": true,
      "filter": "select",
      "filterOptionsSource": "Magento\\Config\\Model\\Config\\Source\\Yesno",
      "position": 70
    },
    "is_global": {
      "label": "Scope",
      "renderer": "snippet.scope_badge",
      "sortable": true,
      "filter": "select",
      "filterOptionsSource": "Magento\\Catalog\\Model\\Attribute\\Source\\Scopes",
      "position": 80
    },
    "is_searchable": {
      "label": "Searchable",
      "renderer": "snippet.boolean_badge",
      "sortable": true,
      "filter": "select",
      "filterOptionsSource": "Magento\\Config\\Model\\Config\\Source\\Yesno",
      "position": 90
    },
    "is_filterable": {
      "label": "Filterable",
      "renderer": "snippet.boolean_badge",
      "sortable": true,
      "filter": "select",
      "filterOptionsSource": "Magento\\Config\\Model\\Config\\Source\\Yesno",
      "position": 100
    },
    "is_comparable": {
      "label": "Comparable",
      "renderer": "snippet.boolean_badge",
      "sortable": true,
      "filter": "select",
      "filterOptionsSource": "Magento\\Config\\Model\\Config\\Source\\Yesno",
      "position": 110
    },
    "is_used_for_promo_rules": {
      "label": "Promo Rules",
      "renderer": "snippet.boolean_badge",
      "sortable": true,
      "filter": "select",
      "filterOptionsSource": "Magento\\Config\\Model\\Config\\Source\\Yesno",
      "position": 120
    },
    "actions": {
      "label": "",
      "type": "actions",
      "actions": [
        {
          "label": "Edit",
          "url": "catalog/product_attribute/edit/attribute_id/{{attribute_id}}"
        }
      ],
      "position": 999
    }
  }
}
