{
  "id": "tax_rule_listing",
  "acl": "Magento_Tax::manage_tax",
  "dataSource": {
    "provider": "grid.collection",
    "config": {
      "collection": "tax_rule.collection"
    }
  },
  "settings": {
    "pageSize": 20,
    "pageSizes": [10, 20, 50],
    "defaultSort": {
      "field": "tax_calculation_rule_id",
      "direction": "asc"
    },
    "massActions": false
  },
  "columns": {
    "tax_calculation_rule_id": {
      "label": "ID",
      "type": "text",
      "sortable": true,
      "filter": "range",
      "position": 10
    },
    "code": {
      "label": "Name",
      "type": "text",
      "sortable": true,
      "filter": "text",
      "searchable": true,
      "position": 20
    },
    "priority": {
      "label": "Priority",
      "type": "text",
      "sortable": true,
      "filter": "range",
      "position": 30
    },
    "position": {
      "label": "Sort Order",
      "type": "text",
      "sortable": true,
      "filter": "range",
      "position": 40
    },
    "actions": {
      "label": "",
      "type": "actions",
      "actions": [
        {
          "label": "Edit",
          "url": "tax/rule/edit/rule/{{tax_calculation_rule_id}}"
        }
      ],
      "position": 999
    }
  }
}
