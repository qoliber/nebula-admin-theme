<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Qoliber\NebulaTheme\ViewModel\CustomerOverview $viewModel */

$viewModel = $block->getData('view_model');
if (!$viewModel instanceof \Qoliber\NebulaTheme\ViewModel\CustomerOverview) {
    throw new \RuntimeException(
        'Nebula snippet "customer_overview": view_model was not injected '
        . '(expected \Qoliber\NebulaTheme\ViewModel\CustomerOverview). Check the SnippetViewModelRegistry binding or layout wiring.'
    );
}

$entity = $block->getData('entity');
$formBlock = $block->getData('form_block');

if (!$entity || !$formBlock) {
    return;
}

$entityId = (int) $entity->getId();
$stats = $formBlock->getFieldValue('_stats') ?? [];
$account = $formBlock->getFieldValue('_account') ?? [];
$newsletter = $formBlock->getFieldValue('_newsletter') ?? [];
$cart = $formBlock->getFieldValue('_cart') ?? [];

$totalOrders = (int) ($stats['total_orders'] ?? 0);
$lifetimeRevenue = (float) ($stats['lifetime_revenue'] ?? 0);
$avgOrderValue = (float) ($stats['avg_order_value'] ?? 0);
$lastPurchase = $stats['last_purchase'] ?? null;

$formatCurrency = static fn (float $amount): string => $viewModel->formatCurrency($amount);
$relativeDate = static fn (?string $date): string => $viewModel->relativeDate($date);

// Account details
$fullName = $escaper->escapeHtml(trim(($entity->getFirstname() ?? '') . ' ' . ($entity->getLastname() ?? '')));
$email = $escaper->escapeHtml((string) $entity->getEmail());
$groupName = $escaper->escapeHtml((string) ($account['group_name'] ?? ''));
$createdAt = $escaper->escapeHtml((string) ($account['created_at'] ?? $entity->getCreatedAt() ?? ''));
$lastLogin = $account['last_login'] ?? null;
$storeName = $escaper->escapeHtml((string) ($account['store_name'] ?? ''));
$isConfirmed = (bool) ($account['is_confirmed'] ?? true);
$isLocked = (bool) ($account['is_locked'] ?? false);

// Quick stats
$reviewsCount = (int) ($stats['reviews_count'] ?? 0);
$cartItemsCount = (int) ($cart['items_count'] ?? 0);
$cartTotal = (float) ($cart['total'] ?? 0);
$isSubscribed = (bool) ($newsletter['is_subscribed'] ?? false);
$billingAddress = $account['default_billing'] ?? null;
$shippingAddress = $account['default_shipping'] ?? null;
?>

