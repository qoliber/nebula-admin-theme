<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */

$entity = $block->getData('entity');
$formBlock = $block->getData('form_block');

if (!$entity || !$formBlock) {
    return;
}

$entityId = (int) $entity->getId();
$resetUrl = $block->getUrl('customer/index/resetPassword', ['customer_id' => $entityId]);
$formKey = $formBlock->getFormKey();
?>

<div class="space-y-4" x-data="{ forceSignIn: false }">
    <!-- Reset Password -->
    <div class="flex items-center justify-between">
        <div class="flex items-center gap-3">
            <i class="fa-solid fa-key text-gray-400"></i>
            <div>
                <div class="text-sm font-medium text-gray-900"><?= $escaper->escapeHtml((string) __('Reset Password')) ?></div>
                <div class="text-xs text-gray-500"><?= $escaper->escapeHtml((string) __('Send a password reset email to the customer')) ?></div>
            </div>
        </div>
        <form method="post" action="<?= $escaper->escapeUrl($resetUrl) ?>">
            <input type="hidden" name="form_key" value="<?= $escaper->escapeHtmlAttr($formKey) ?>">
            <input type="hidden" name="customer_id" value="<?= $escaper->escapeHtmlAttr((string) $entityId) ?>">
            <button type="submit"
                    class="inline-flex items-center gap-1.5 px-3 py-2 text-sm font-medium rounded-lg bg-white text-gray-700 border border-gray-300 hover:bg-gray-50 transition-colors"
                    @click.prevent="(async () => { if (await window.Nebula.confirm({ title: '<?= $escaper->escapeJs((string) __('Send password reset email?')) ?>', message: '<?= $escaper->escapeJs((string) __('The customer will receive a link to choose a new password.')) ?>', confirmText: '<?= $escaper->escapeJs((string) __('Send email')) ?>' })) { $event.currentTarget.form?.submit(); } })()">
                <i class="fa-solid fa-paper-plane text-xs"></i>
                <?= $escaper->escapeHtml((string) __('Send Reset Email')) ?>
            </button>
        </form>
    </div>

    <!-- Force Sign-In -->
    <div class="flex items-center justify-between pt-4 border-t border-gray-100">
        <div class="flex items-center gap-3">
            <i class="fa-solid fa-shield-halved text-gray-400"></i>
            <div>
                <div class="text-sm font-medium text-gray-900"><?= $escaper->escapeHtml((string) __('Force Sign-In')) ?></div>
                <div class="text-xs text-gray-500"><?= $escaper->escapeHtml((string) __('Require the customer to re-authenticate on next visit')) ?></div>
            </div>
        </div>

        <input type="hidden" name="customer[force_sign_in]" :value="forceSignIn ? '1' : '0'">
        <button type="button"
                @click="forceSignIn = !forceSignIn"
                :class="forceSignIn ? 'bg-amber-500' : 'bg-gray-300'"
            :aria-label="forceSignIn ? '<?= $escaper->escapeJs((string) __('Disable force sign-in')) ?>' : '<?= $escaper->escapeJs((string) __('Enable force sign-in')) ?>'"
            :title="forceSignIn ? '<?= $escaper->escapeJs((string) __('Disable force sign-in')) ?>' : '<?= $escaper->escapeJs((string) __('Enable force sign-in')) ?>'"
            role="switch"
            :aria-checked="forceSignIn"
                class="relative inline-flex h-6 w-11 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-indigo-500/20 focus:ring-offset-2">
            <span :class="forceSignIn ? 'translate-x-5' : 'translate-x-0'"
                  class="pointer-events-none inline-block h-5 w-5 transform rounded-full bg-white shadow ring-0 transition duration-200 ease-in-out"></span>
        </button>
    </div>
</div>
