<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Qoliber\NebulaTheme\ViewModel\CustomerCart $viewModel */

$viewModel = $block->getData('view_model');
if (!$viewModel instanceof \Qoliber\NebulaTheme\ViewModel\CustomerCart) {
    // nebula:allow-object-manager dynamic-snippet-view-model fallback.
    $viewModel = \Magento\Framework\App\ObjectManager::getInstance()
        ->get(\Qoliber\NebulaTheme\ViewModel\CustomerCart::class);
}

$formBlock = $block->getData('form_block');
$cart = $formBlock ? ($formBlock->getFieldValue('_cart') ?? []) : [];
$items = $cart['items'] ?? [];

$formatCurrency = static fn (float $amount): string => $viewModel->formatCurrency($amount);
?>

<?php if (empty($items)) : ?>
    <div class="text-center py-8">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-gray-100 mb-3">
            <i class="fa-solid fa-cart-shopping text-gray-400 text-lg"></i>
        </div>
        <p class="text-sm text-gray-500"><?= $escaper->escapeHtml((string) __('The shopping cart is empty.')) ?></p>
    </div>
<?php else : ?>
    <div class="overflow-x-auto">
        <table class="w-full text-sm">
            <thead>
                <tr class="bg-gray-50 text-left text-xs font-semibold text-gray-500 uppercase tracking-wider">
                    <th class="px-4 py-3"><?= $escaper->escapeHtml((string) __('Product')) ?></th>
                    <th class="px-4 py-3"><?= $escaper->escapeHtml((string) __('SKU')) ?></th>
                    <th class="px-4 py-3 text-center"><?= $escaper->escapeHtml((string) __('Qty')) ?></th>
                    <th class="px-4 py-3 text-right"><?= $escaper->escapeHtml((string) __('Price')) ?></th>
                    <th class="px-4 py-3 text-right"><?= $escaper->escapeHtml((string) __('Subtotal')) ?></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                <?php foreach ($items as $item) : ?>
                    <tr class="hover:bg-gray-50 transition-colors">
                        <td class="px-4 py-3 font-medium text-gray-900"><?= $escaper->escapeHtml((string) ($item['name'] ?? '')) ?></td>
                        <td class="px-4 py-3 text-gray-500 font-mono text-xs"><?= $escaper->escapeHtml((string) ($item['sku'] ?? '')) ?></td>
                        <td class="px-4 py-3 text-center text-gray-700"><?= $escaper->escapeHtml((string) (int) ($item['qty'] ?? 0)) ?></td>
                        <td class="px-4 py-3 text-right text-gray-700"><?= $escaper->escapeHtml($formatCurrency((float) ($item['price'] ?? 0))) ?></td>
                        <td class="px-4 py-3 text-right font-medium text-gray-900"><?= $escaper->escapeHtml($formatCurrency((float) ($item['subtotal'] ?? 0))) ?></td>
                    </tr>
                <?php endforeach; ?>
            </tbody>
        </table>
    </div>

    <?php if (isset($cart['total']) && (float) $cart['total'] > 0) : ?>
        <div class="border-t border-gray-200 bg-gray-50 px-4 py-3 flex justify-end">
            <div class="text-sm">
                <span class="text-gray-500"><?= $escaper->escapeHtml((string) __('Cart Total:')) ?></span>
                <span class="ml-2 font-semibold text-gray-900"><?= $escaper->escapeHtml($formatCurrency((float) $cart['total'])) ?></span>
            </div>
        </div>
    <?php endif; ?>
<?php endif; ?>
