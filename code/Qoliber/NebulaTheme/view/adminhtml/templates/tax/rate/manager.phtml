$script = <<<'JS'
(function () {
    var register = function () {
        Alpine.data('nebulaTaxRateManager', function (config) {
            config = config || {};

            return {
                modalOpen: !!config.open,
                isEditing: !!config.isEditing,
                redirectOnClose: !!config.redirectOnClose,
                loading: false,
                submitting: false,
                routeBasePath: config.routeBasePath || '',
                newUrl: config.newUrl || '',
                indexUrl: config.indexUrl || '',
                currentLoadUrl: config.loadUrl || '',
                currentDeleteUrl: config.deleteUrl || '',
                modalTitle: config.title || '',
                modalDescription: config.description || '',
                errorMessage: '',
                init: function () {
                    if (this.modalOpen) {
                        this.$nextTick(this.executeInlineScripts.bind(this));
                    }
                },
                handleTriggerClick: function (event) {
                    var trigger = event.target.closest('a');
                    if (!trigger || !trigger.href) {
                        return;
                    }

                    var url = new URL(trigger.href, window.location.origin);
                    if (!this.routeBasePath || url.pathname.indexOf(this.routeBasePath) !== 0) {
                        return;
                    }

                    if (!/\/(new|edit)(\/|$)/.test(url.pathname)) {
                        return;
                    }

                    event.preventDefault();
                    event.stopPropagation();
                    this.openFromUrl(trigger.href);
                },
                openFromUrl: async function (url) {
                    this.loading = true;
                    this.modalOpen = true;
                    this.errorMessage = '';

                    try {
                        var response = await fetch(url, {
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            }
                        });
                        var payload = await response.json();
                        if (!payload.success) {
                            if (payload.redirectUrl) {
                                window.location.href = payload.redirectUrl;
                                return;
                            }

                            throw new Error(payload.message || 'Could not load the tax rate form.');
                        }

                        this.applyPayload(payload);
                    } catch (error) {
                        this.errorMessage = error.message || 'Could not load the tax rate form.';
                    } finally {
                        this.loading = false;
                    }
                },
                applyPayload: function (payload) {
                    this.isEditing = !!payload.isEditing;
                    this.modalTitle = payload.title || '';
                    this.modalDescription = payload.description || '';
                    this.currentLoadUrl = payload.loadUrl || this.newUrl;
                    this.currentDeleteUrl = payload.deleteUrl || '';
                    this.renderFormHtml(payload.html || '');
                },
                renderFormHtml: function (html) {
                    var container = this.$refs.formContainer;
                    if (!container) {
                        return;
                    }

                    container.innerHTML = html;
                    this.$nextTick(this.executeInlineScripts.bind(this));
                },
                executeInlineScripts: function () {
                    var container = this.$refs.formContainer;
                    if (!container) {
                        return;
                    }

                    Array.prototype.forEach.call(container.querySelectorAll('script'), function (oldScript) {
                        var newScript = document.createElement('script');
                        Array.prototype.forEach.call(oldScript.attributes, function (attribute) {
                            newScript.setAttribute(attribute.name, attribute.value);
                        });
                        newScript.textContent = oldScript.textContent;
                        oldScript.parentNode.replaceChild(newScript, oldScript);
                    });
                },
                closeModal: function () {
                    if (this.redirectOnClose) {
                        window.location.href = this.indexUrl;
                        return;
                    }

                    this.modalOpen = false;
                    this.errorMessage = '';
                },
                resetForm: function () {
                    if (!this.currentLoadUrl) {
                        return;
                    }

                    this.openFromUrl(this.currentLoadUrl);
                },
                submitForm: async function () {
                    var form = this.$refs.formContainer ? this.$refs.formContainer.querySelector('#rate-form') : null;
                    if (!form) {
                        return;
                    }

                    if (window.Nebula && window.Nebula.validateForm && !window.Nebula.validateForm(form)) {
                        return;
                    }

                    this.submitting = true;
                    this.errorMessage = '';

                    try {
                        var response = await fetch(form.action, {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: new URLSearchParams(new FormData(form))
                        });
                        var payload = await response.json();

                        if (payload.success) {
                            window.location.href = payload.redirectUrl || this.indexUrl;
                            return;
                        }

                        this.errorMessage = payload.message || 'Could not save the tax rate.';
                        if (payload.html) {
                            this.applyPayload(payload);
                        }
                    } catch (error) {
                        this.errorMessage = error.message || 'Could not save the tax rate.';
                    } finally {
                        this.submitting = false;
                    }
                },
                confirmDelete: async function () {
                    if (!this.isEditing || !this.currentDeleteUrl) {
                        return;
                    }

                    if (!window.confirm('Are you sure you want to do this?')) {
                        return;
                    }

                    var form = this.$refs.formContainer ? this.$refs.formContainer.querySelector('#rate-form') : null;
                    var formKey = form ? (form.querySelector('[name="form_key"]') || {}).value : '';
                    var body = new URLSearchParams();
                    if (formKey) {
                        body.set('form_key', formKey);
                    }

                    this.errorMessage = '';
                    this.submitting = true;

                    try {
                        var response = await fetch(this.currentDeleteUrl, {
                            method: 'POST',
                            headers: {
                                'X-Requested-With': 'XMLHttpRequest'
                            },
                            body: body
                        });
                        var payload = await response.json();
                        if (!payload.success) {
                            throw new Error(payload.message || 'Could not delete the tax rate.');
                        }

                        window.location.href = payload.redirectUrl || this.indexUrl;
                    } catch (error) {
                        this.errorMessage = error.message || 'Could not delete the tax rate.';
                    } finally {
                        this.submitting = false;
                    }
                }
            };
        });
    };

    if (window.Alpine) {
        register();
    } else {
        document.addEventListener('alpine:init', register, { once: true });
    }
})();
JS;
