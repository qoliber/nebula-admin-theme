<?php

declare(strict_types=1);

/** @var \Magento\Sales\Block\Adminhtml\Items\Renderer\DefaultRenderer $block */
$_item = $block->getItem();
$orderItem = $_item->getOrderItem();
$block->setPriceDataObject($_item);
$catalogHelper = $block->getData('catalogHelper');
$skuLines = $catalogHelper ? $catalogHelper->splitSku($block->escapeHtml($block->getSku())) : [$block->escapeHtml($block->getSku())];
$options = $block->getOrderOptions();
$qtyRows = [
    ['label' => (string) __('Ordered'), 'value' => (float) $orderItem->getQtyOrdered()],
    ['label' => (string) __('Invoiced'), 'value' => (float) $orderItem->getQtyInvoiced()],
    ['label' => (string) __('Shipped'), 'value' => (float) $orderItem->getQtyShipped()],
];

if ((float) $orderItem->getQtyRefunded()) {
    $qtyRows[] = ['label' => (string) __('Refunded'), 'value' => (float) $orderItem->getQtyRefunded()];
}

if ((float) $orderItem->getQtyCanceled()) {
    $qtyRows[] = ['label' => (string) __('Canceled'), 'value' => (float) $orderItem->getQtyCanceled()];
}
?>
<tr class="align-top transition hover:bg-gray-50">
    <td class="px-5 py-4">
        <div class="font-medium text-gray-900"><?= $block->escapeHtml($_item->getName()) ?></div>
        <div class="mt-1 text-xs text-gray-500">
            <span class="font-medium uppercase tracking-wide text-gray-400"><?= $block->escapeHtml(__('SKU')) ?>:</span>
            <?= /* @noEscape */ implode('<br />', $skuLines) ?>
        </div>

        <?php if ($options) : ?>
            <dl class="mt-3 space-y-1 text-xs text-gray-500">
                <?php foreach ($options as $option) : ?>
                    <div>
                        <dt class="inline font-medium text-gray-600"><?= $block->escapeHtml($option['label']) ?>:</dt>
                        <dd class="inline text-gray-500">
                            <?php if (isset($option['custom_view']) && $option['custom_view']) : ?>
                                <?= /* @noEscape */ $block->getCustomizedOptionValue($option) ?>
                            <?php else : ?>
                                <?php $formattedOption = $block->getFormattedOption($option['value']); ?>
                                <?= $block->escapeHtml($formattedOption['value'], ['a', 'br']) ?>
                                <?php if (isset($formattedOption['remainder']) && $formattedOption['remainder']) : ?>
                                    <span class="text-gray-400">… <?= $block->escapeHtml($formattedOption['remainder'], ['a']) ?></span>
                                <?php endif; ?>
                            <?php endif; ?>
                        </dd>
                    </div>
                <?php endforeach; ?>
            </dl>
        <?php endif; ?>

        <?php if ($_item->getDescription()) : ?>
            <div class="mt-3 text-xs text-gray-500"><?= $block->escapeHtml($_item->getDescription()) ?></div>
        <?php endif; ?>
    </td>
    <td class="px-5 py-4 text-right text-sm font-medium text-gray-900">
        <?= $block->getColumnHtml($_item, 'price') ?>
    </td>
    <td class="px-5 py-4">
        <div class="space-y-2">
            <?php foreach ($qtyRows as $qtyRow) : ?>
                <div class="flex items-center justify-between gap-3 rounded-lg border border-gray-200 bg-gray-50 px-3 py-2">
                    <span class="text-xs font-medium uppercase tracking-wide text-gray-400"><?= $block->escapeHtml($qtyRow['label']) ?></span>
                    <span class="text-sm font-semibold text-gray-700"><?= (float) $qtyRow['value'] ?></span>
                </div>
            <?php endforeach; ?>
        </div>
    </td>
    <?php if ($block->canParentReturnToStock($_item)) : ?>
        <td class="px-5 py-4 text-center">
            <?php if ($block->canReturnItemToStock($_item)) : ?>
                <label class="inline-flex items-center justify-center">
                    <input type="checkbox"
                           class="admin__control-checkbox h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500"
                           name="creditmemo[items][<?= (int) $_item->getOrderItemId() ?>][back_to_stock]"
                           value="1"<?php if ($_item->getBackToStock()) : ?> checked<?php endif; ?>/>
                </label>
            <?php endif; ?>
        </td>
    <?php endif; ?>
    <td class="px-5 py-4">
        <?php if ($block->canEditQty()) : ?>
            <input type="text"
                   class="qty-input block w-28 rounded-lg border border-gray-300 px-3 py-2 text-sm text-gray-900 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500/20"
                   name="creditmemo[items][<?= (int) $_item->getOrderItemId() ?>][qty]"
                   value="<?= (float) $_item->getQty() ?>"/>
        <?php else : ?>
            <span class="text-sm font-medium text-gray-700"><?= (float) $_item->getQty() ?></span>
        <?php endif; ?>
    </td>
    <td class="px-5 py-4 text-right text-sm text-gray-700"><?= $block->getColumnHtml($_item, 'subtotal') ?></td>
    <td class="px-5 py-4 text-right text-sm text-gray-700"><?= /* @noEscape */ $block->displayPriceAttribute('tax_amount') ?></td>
    <td class="px-5 py-4 text-right text-sm text-gray-700"><?= /* @noEscape */ $block->displayPriceAttribute('discount_amount') ?></td>
    <td class="px-5 py-4 text-right text-sm font-semibold text-gray-900"><?= $block->getColumnHtml($_item, 'total') ?></td>
</tr>
