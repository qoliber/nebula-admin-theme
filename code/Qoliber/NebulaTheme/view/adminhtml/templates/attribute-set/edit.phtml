<script>
function attributeSetEditor() {
    return {
        setName: <?= /* @noEscape */ json_encode($setName) ?>,
        groups: [],
        unassigned: [],
        removedGroups: [],
        unassignedSearch: '',
        saving: false,
        message: '',
        messageError: false,

        init() {
            const rawGroups = <?= /* @noEscape */ $groupsJson ?>;
            this.groups = rawGroups.map(g => ({
                ...g,
                collapsed: false,
                editing: false,
                addingAttribute: false,
                attrSearch: ''
            }));
            this.unassigned = <?= /* @noEscape */ $unassignedJson ?>;
        },

        filteredUnassigned(search) {
            if (!search) return this.unassigned;
            const q = search.toLowerCase();
            return this.unassigned.filter(a =>
                a.code.toLowerCase().includes(q) || a.label.toLowerCase().includes(q)
            );
        },

        addGroup() {
            const name = prompt('<?= $escaper->escapeJs((string) __('Enter new group name:')) ?>');
            if (!name || !name.trim()) return;

            // Check uniqueness
            if (this.groups.some(g => g.name.toLowerCase() === name.trim().toLowerCase())) {
                alert('<?= $escaper->escapeJs((string) __('A group with this name already exists.')) ?>');
                return;
            }

            this.groups.push({
                id: 'gNEW_' + Date.now(),
                name: name.trim(),
                sort_order: this.groups.length + 1,
                attributes: [],
                collapsed: false,
                editing: false,
                addingAttribute: false,
                attrSearch: ''
            });
        },

        startEditGroupName(group) {
            group.editing = true;
            this.$nextTick(() => {
                const input = this.$el.querySelector('input[x-model="group.name"]');
                if (input) input.focus();
            });
        },

        async deleteGroup(gIdx) {
            const group = this.groups[gIdx];

            // Check for system attributes
            const hasSystem = group.attributes.some(a => !a.is_unassignable);
            if (hasSystem) {
                alert('<?= $escaper->escapeJs((string) __('This group contains system attributes. Move them to another group first.')) ?>');
                return;
            }

            if (group.attributes.length > 0) {
                if (!(await window.Nebula.confirm({ title: '<?= $escaper->escapeJs((string) __('Delete this group?')) ?>', message: '<?= $escaper->escapeJs((string) __('Its attributes will be moved to Unassigned.')) ?>', danger: true, confirmText: '<?= $escaper->escapeJs((string) __('Delete group')) ?>' }))) {
                    return;
                }
            }

            // Move user-defined attributes to unassigned
            group.attributes.forEach(attr => {
                if (attr.is_unassignable) {
                    this.unassigned.push({
                        attribute_id: attr.attribute_id,
                        code: attr.code,
                        label: attr.label,
                        is_user_defined: attr.is_user_defined,
                        entity_id: attr.entity_id
                    });
                }
            });

            // Track removed group if it's an existing one (numeric id)
            if (typeof group.id === 'number' || (typeof group.id === 'string' && !group.id.startsWith('gNEW_'))) {
                this.removedGroups.push(group.id);
            }

            this.groups.splice(gIdx, 1);
        },

        moveGroup(idx, direction) {
            const newIdx = idx + direction;
            if (newIdx < 0 || newIdx >= this.groups.length) return;
            const temp = this.groups[idx];
            this.groups[idx] = this.groups[newIdx];
            this.groups[newIdx] = temp;
            // Force reactivity
            this.groups = [...this.groups];
        },

        moveAttribute(group, idx, direction) {
            const newIdx = idx + direction;
            if (newIdx < 0 || newIdx >= group.attributes.length) return;
            const temp = group.attributes[idx];
            group.attributes[idx] = group.attributes[newIdx];
            group.attributes[newIdx] = temp;
            group.attributes = [...group.attributes];
        },

        assignAttribute(group, attr) {
            // Remove from unassigned
            this.unassigned = this.unassigned.filter(a => a.attribute_id !== attr.attribute_id);

            // Add to group
            group.attributes.push({
                attribute_id: attr.attribute_id,
                code: attr.code,
                label: attr.label,
                entity_id: attr.entity_id || 0,
                is_user_defined: attr.is_user_defined,
                is_unassignable: true
            });

            group.addingAttribute = false;
            group.attrSearch = '';
        },

        unassignAttribute(group, aIdx) {
            const attr = group.attributes[aIdx];
            group.attributes.splice(aIdx, 1);

            this.unassigned.push({
                attribute_id: attr.attribute_id,
                code: attr.code,
                label: attr.label,
                is_user_defined: attr.is_user_defined,
                entity_id: attr.entity_id
            });
        },

        async confirmDelete() {
            if (await window.Nebula.confirm({ title: '<?= $escaper->escapeJs((string) __('Delete this attribute set?')) ?>', message: '<?= $escaper->escapeJs((string) __('All products using this set will be removed. This cannot be undone.')) ?>', danger: true, confirmText: '<?= $escaper->escapeJs((string) __('Delete set')) ?>' })) {
                window.location.href = <?= /* @noEscape */ json_encode($deleteUrl) ?>;
            }
        },

        showMessage(msg, isError) {
            this.message = msg;
            this.messageError = isError;
            setTimeout(() => { this.message = ''; }, 4000);
        },

        save() {
            if (!this.setName.trim()) {
                this.showMessage('<?= $escaper->escapeJs((string) __('Attribute set name is required.')) ?>', true);
                return;
            }

            this.saving = true;

            // Build data in the format organizeData expects
            const reqGroups = [];
            const reqAttributes = [];
            const reqNotAttributes = [];

            this.groups.forEach((group, gIdx) => {
                reqGroups.push([group.id, group.name, gIdx + 1]);

                group.attributes.forEach((attr, aIdx) => {
                    reqAttributes.push([attr.attribute_id, group.id, aIdx + 1, attr.entity_id || 0]);
                });
            });

            this.unassigned.forEach(attr => {
                if (attr.entity_id > 0) {
                    reqNotAttributes.push(attr.entity_id);
                }
            });

            const data = {
                attribute_set_name: this.setName,
                groups: reqGroups,
                attributes: reqAttributes,
                not_attributes: reqNotAttributes,
                removeGroups: [...new Set(this.removedGroups)]
            };

            const formData = new FormData();
            formData.append('data', JSON.stringify(data));
            formData.append('form_key', <?= /* @noEscape */ json_encode($formKey) ?>);

            fetch(<?= /* @noEscape */ json_encode($saveUrl) ?>, {
                method: 'POST',
                body: formData
            })
            .then(r => r.json())
            .then(response => {
                this.saving = false;
                if (response.error) {
                    this.showMessage(response.message || '<?= $escaper->escapeJs((string) __('An error occurred while saving.')) ?>', true);
                } else if (response.url) {
                    this.showMessage('<?= $escaper->escapeJs((string) __('Saved successfully.')) ?>', false);
                    setTimeout(() => { window.location.href = response.url; }, 1000);
                }
            })
            .catch(() => {
                this.saving = false;
                this.showMessage('<?= $escaper->escapeJs((string) __('An error occurred while saving.')) ?>', true);
            });
        }
    };
}
</script>
