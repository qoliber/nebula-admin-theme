<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Qoliber\NebulaTheme\ViewModel\ConfigurableOptions $viewModel */
$viewModel = $block->getData('view_model');

if (!$viewModel instanceof \Qoliber\NebulaTheme\ViewModel\ConfigurableOptions) {
    throw new \RuntimeException(
        'Nebula snippet "configurable_options": view_model was not injected '
        . '(expected \Qoliber\NebulaTheme\ViewModel\ConfigurableOptions). Check the SnippetViewModelRegistry binding or layout wiring.'
    );
}

$entity = $block->getData('entity');
$formBlock = $block->getData('form_block');

if (!$entity || $entity->getTypeId() !== 'configurable') {
    return;
}

$attributeSetId = (int) $entity->getAttributeSetId();
$availableAttributes = $viewModel->getAvailableAttributes($attributeSetId);
$variationsData = $viewModel->resolveVariations($entity);

$formKey = $formBlock->getFormKey();
$getAttributesUrl = $formBlock->getUrl('catalog/product_attribute/getAttributes');

$wizardConfig = json_encode([
    'availableAttributes' => $availableAttributes,
    'existingVariations' => $variationsData['existingVariations'],
    'usedAttributeCodes' => $variationsData['usedAttributeCodes'],
    'usedAttributeIds' => $variationsData['usedAttributeIds'],
    'getAttributesUrl' => $getAttributesUrl,
    'formKey' => $formKey,
], JSON_HEX_APOS | JSON_HEX_QUOT);
?>

<div x-data="nebulaConfigWizard(<?= $escaper->escapeHtmlAttr($wizardConfig) ?>)">
    <?php include $block->getTemplateFile('Qoliber_NebulaTheme::snippet/configurable_options/variations-table.phtml'); ?>
    <?php include $block->getTemplateFile('Qoliber_NebulaTheme::snippet/configurable_options/empty-state.phtml'); ?>
    <?php include $block->getTemplateFile('Qoliber_NebulaTheme::snippet/configurable_options/wizard-modal.phtml'); ?>
</div>
