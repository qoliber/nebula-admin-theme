<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Qoliber\NebulaTheme\ViewModel\BundleOptions $viewModel */

$viewModel = $block->getData('view_model');
if (!$viewModel instanceof \Qoliber\NebulaTheme\ViewModel\BundleOptions) {
    throw new \RuntimeException(
        'Nebula snippet "bundle_options": view_model was not injected '
        . '(expected \Qoliber\NebulaTheme\ViewModel\BundleOptions). Check the SnippetViewModelRegistry binding or layout wiring.'
    );
}

$entity = $block->getData('entity');
$formBlock = $block->getData('form_block');

if (!$entity || $entity->getTypeId() !== 'bundle') {
    return;
}

$existingOptions = $viewModel->getExistingOptions($entity);

$searchUrl = $formBlock->getUrl('nebula/grid/productSearch');
$formKey = $formBlock->getFormKey();

$bundleConfig = json_encode([
    'existingOptions' => $existingOptions,
    'searchUrl' => $searchUrl,
    'formKey' => $formKey,
], JSON_HEX_APOS | JSON_HEX_QUOT);
