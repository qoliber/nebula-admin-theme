                    </button>
                </div>
                <div class="flex flex-wrap gap-2">
                    <template x-for="opt in attr.options" :key="opt.value">
                        <label class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full text-sm cursor-pointer transition-all duration-150 select-none"
