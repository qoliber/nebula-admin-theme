    @media (min-width: 1024px) {
        .nebula-cat-sidebar { display: block; }
        .nebula-cat-browse-btn { display: none; }
    }
</style>

<div
    x-data="nebulaForm({
        formKey: '<?= $escaper->escapeJs($formKey) ?>',
        categoryDrawerStorageKey: '<?= $escaper->escapeJs($drawerStorageKey) ?>'
    })"
