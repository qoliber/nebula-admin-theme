<?php

/**
 * EAV Form — full-width action bar, two-column body (tree left, tabs right).
 *
 * Desktop : category tree always visible beside the form content.
 * Tablet/Mobile : tree hidden, "Browse Categories" button opens the drawer.
 *
 * @var \Qoliber\NebulaForm\Block\EavForm $block
 */

declare(strict_types=1);

// ---------------------------------------------------------------------------
// Sidebar snippet
// ---------------------------------------------------------------------------
$definition       = $block->getDefinition();
$sidebarRenderer  = (string) ($definition['settings']['sidebarRenderer'] ?? '');
$formId           = (string) ($definition['id'] ?? $block->getFormId());
$drawerStorageKey = 'nebula-category-drawer-' . md5($formId);

$sidebarHtml = '';
$snippet     = $block->resolveSnippet($sidebarRenderer);
if ($snippet !== null && !empty($snippet['template'])) {
    /** @var \Magento\Framework\View\Element\Template $sidebarBlock */
    $sidebarBlock = $block->getLayout()->createBlock(\Magento\Framework\View\Element\Template::class);
    $block->setModuleOnBlock($sidebarBlock, $snippet['template']);
    $sidebarBlock->setTemplate($snippet['template']);
    $sidebarBlock->setData('entity', $block->getEntity());
    $sidebarBlock->setData('entity_data', $block->getEntityData());
    $sidebarBlock->setData('form_block', $block);
    $sidebarHtml = $sidebarBlock->toHtml();
}

$block->setData('_sidebar_rendered', true);

// ---------------------------------------------------------------------------
// "Browse Categories" button — tablet/mobile only via .nebula-cat-browse-btn
// ---------------------------------------------------------------------------
$treeTriggerHtml =
    '<button'
    . ' type="button"'
    . ' @click="toggleDrawer()"'
    . ' class="nebula-cat-browse-btn items-center gap-1.5 rounded-lg bg-white px-3 py-2 text-sm font-semibold text-gray-700 shadow-sm border border-gray-300 transition hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-indigo-500/30"'
    . ' :aria-expanded="drawerOpen ? \'true\' : \'false\'"'
    . ' aria-controls="nebula-category-drawer-panel"'
    . '>'
    . '<svg class="h-4 w-4 shrink-0" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">'
    . '<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 0 1 6 3.75h2.25A2.25 2.25 0 0 1 10.5 6v2.25a2.25 2.25 0 0 1-2.25 2.25H6a2.25 2.25 0 0 1-2.25-2.25V6ZM3.75 15.75A2.25 2.25 0 0 1 6 13.5h2.25a2.25 2.25 0 0 1 2.25 2.25V18A2.25 2.25 0 0 1 18 20.25h-2.25a2.25 2.25 0 0 1-2.25-2.25v-2.25Z" />'
    . '</svg>'
    . '<span x-text="drawerOpen ? \'' . $escaper->escapeJs((string) __('Hide Categories')) . '\' : \'' . $escaper->escapeJs((string) __('Browse Categories')) . '\'"></span>'
    . '</button>';

$buttonBlock = $block->getLayout()->createBlock(\Magento\Framework\View\Element\Text::class);
$buttonBlock->setText($treeTriggerHtml);
$block->setChild('actions_before_back', $buttonBlock);

// ---------------------------------------------------------------------------
// Variables required by form-shell.phtml (mirrors eav/form.phtml setup)
// ---------------------------------------------------------------------------
$entityId    = $block->getEntityId();
$isNew       = $block->isNewEntity();
$formKey     = $block->getFormKey();
$saveUrl     = $block->getSaveUrl();
$backUrl     = $block->getBackUrl();
$deleteUrl   = $block->getDeleteUrl();
$entityType  = (string) ($definition['entity'] ?? '');
$headerTitle = (string) ($definition['settings']['title'] ?? 'Edit');

if ($entityType === 'catalog_product') {
    $title       = (string) ($block->getFieldValue('name') ?? (string) __('New Product'));
    $statusValue = (int) ($block->getFieldValue('status') ?? 1);
    $statusLabel = (string) ($statusValue === 1 ? __('Enabled') : __('Disabled'));
    $statusClass = $statusValue === 1 ? 'bg-green-100 text-green-800 ring-green-600/20' : 'bg-red-100 text-red-800 ring-red-600/20';
    $subtitle    = ucfirst((string) ($block->getFieldValue('type_id') ?? 'simple'));
    if ($entityId) {
        $subtitle .= ' · SKU: ' . (string) ($block->getFieldValue('sku') ?? '');
    }
} elseif ($entityType === 'customer') {
    $firstName   = (string) ($block->getFieldValue('firstname') ?? '');
    $lastName    = (string) ($block->getFieldValue('lastname') ?? '');
    $title       = trim($firstName . ' ' . $lastName) ?: (string) __('New Customer');
    $statusLabel = null;
    $statusClass = '';
    $subtitle    = (string) ($block->getFieldValue('email') ?? $headerTitle);
} elseif ($entityType === 'catalog_category') {
    $title       = (string) ($block->getFieldValue('name') ?? (string) __('New Category'));
    $statusValue = (int) ($block->getFieldValue('is_active') ?? 1);
    $statusLabel = (string) ($statusValue === 1 ? __('Active') : __('Inactive'));
    $statusClass = $statusValue === 1 ? 'bg-green-100 text-green-800 ring-green-600/20' : 'bg-red-100 text-red-800 ring-red-600/20';
    $subtitle    = $headerTitle;
} else {
    $title       = (string) ($block->getFieldValue('name')
        ?? $block->getFieldValue('title')
        ?? ($isNew ? __('New %1', $headerTitle) : __('Edit %1', $headerTitle)));
    $statusLabel = null;
    $statusClass = '';
    $subtitle    = $headerTitle;
}

$hasFiles   = false;
$formRef    = 'nebulaEavForm';
$routeFields = $block->getHiddenInputs();
?>

<style>
    /* Tree sidebar: hidden on tablet/mobile, visible on desktop */
    .nebula-cat-sidebar { display: none; }
    /* Browse Categories button: visible on tablet/mobile, hidden on desktop */
