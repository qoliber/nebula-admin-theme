            ></div>

            <aside
                id="nebula-category-drawer-panel"
                x-show="drawerOpen"
                x-transition:enter="transform transition ease-out duration-300"
                x-transition:enter-start="translate-x-full"
                x-transition:enter-end="translate-x-0"
                x-transition:leave="transform transition ease-in duration-200"
                x-transition:leave-start="translate-x-0"
                x-transition:leave-end="translate-x-full"
                class="absolute right-0 top-0 h-full w-full max-w-xl overflow-hidden border-l border-gray-200 bg-white shadow-2xl"
                style="z-index:2147483647;"
                role="dialog"
                aria-modal="true"
                aria-labelledby="nebula-category-drawer-title"
                @click.stop
                x-ref="drawerPanel"
            >
                <div class="flex h-full flex-col">
                    <div class="flex items-center justify-between border-b border-gray-200 px-6 py-4">
                        <div>
                            <h2 id="nebula-category-drawer-title" class="text-lg font-bold text-gray-900">
                                <?= $escaper->escapeHtml((string) __('Category Tree')) ?>
                            </h2>
                            <p class="mt-0.5 text-sm text-gray-500">
                                <?= $escaper->escapeHtml((string) __('Browse categories and switch editing context.')) ?>
                            </p>
                        </div>
                        <button
                            type="button"
                            @click="closeDrawer()"
                            class="rounded-lg p-2 text-gray-400 transition hover:bg-gray-100 hover:text-gray-600"
                        >
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                            </svg>
                        </button>
                    </div>
                    <div class="min-h-0 flex-1 overflow-y-auto px-6 py-5">
                        <?= /* @noEscape */ $sidebarHtml ?>
                    </div>
                </div>
            </aside>
        </div>

    </div>
</div>

<script>
(function () {
    if (window._nebulaCategoryDrawerRegistered) return;
    window._nebulaCategoryDrawerRegistered = true;
    var register = function () {
        Alpine.data('nebulaCategoryDrawer', function (config) {
            return {
                drawerOpen: !!config.defaultOpen,
                storageKey: config.storageKey || null,
                init() {
                    if (this.storageKey) {
                        try {
                            var stored = window.localStorage.getItem(this.storageKey);
                            if (stored !== null) this.drawerOpen = (stored === 'open');
                        } catch (e) {}
                    }
                    this.$watch('drawerOpen', (value) => {
                        if (this.storageKey) {
                            try { window.localStorage.setItem(this.storageKey, value ? 'open' : 'closed'); } catch (e) {}
                        }
                    });
                },
                toggleDrawer() { this.drawerOpen = !this.drawerOpen; },
                closeDrawer() { this.drawerOpen = false; }
            };
        });
    };
    if (window.Alpine) register();
    else document.addEventListener('alpine:init', register);
})();
</script>
