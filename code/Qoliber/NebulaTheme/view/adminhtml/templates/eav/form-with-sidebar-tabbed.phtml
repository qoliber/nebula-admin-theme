        include $block->getTemplateFile('Qoliber_NebulaForm::form-shell.phtml');
        ?>

        <div class="flex gap-6 w-full mt-0">
            <!-- Category tree: desktop sidebar -->
            <div class="nebula-cat-sidebar w-64 flex-shrink-0">
                <div class="sticky top-20 max-h-[calc(100vh-6rem)] overflow-y-auto rounded-lg border border-gray-200 bg-white shadow-sm p-4">
                    <?php if ($sidebarHtml) : ?>
                        <?= /* @noEscape */ $sidebarHtml ?>
                    <?php else : ?>
                        <div class="text-sm text-gray-500"><?= $escaper->escapeHtml((string) __('No category tree available.')) ?></div>
                    <?php endif; ?>
                </div>
            </div>

            <!-- Form content: tabs + fields -->
            <div class="flex-1 min-w-0">
                <?= /* @noEscape */ $block->getLayoutTreeRenderer()->render($block, $block->getLayoutTree(), $block->getLayout()) ?>

                <?php $remainingGroups = $block->getRemainingAttributeGroups(); ?>
                <?php if (!empty($remainingGroups)) : ?>
                <div x-data="{ activeAttrTab: 0 }" class="mb-6">
                    <div class="border-b border-gray-200">
                        <nav class="flex gap-1 overflow-x-auto" aria-label="Additional Attribute Groups">
