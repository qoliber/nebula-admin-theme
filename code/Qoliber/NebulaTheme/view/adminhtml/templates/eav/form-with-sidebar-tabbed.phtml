                        </nav>
                    </div>
                    <div class="mt-4">
                        <?php foreach (array_values($remainingGroups) as $i => $group) : ?>
                        <div x-show="activeAttrTab === <?= (int) $i ?>">
                            <div class="rounded-lg border border-gray-200 bg-white shadow-sm">
                                <div class="px-6 py-4 divide-y divide-gray-100">
                                    <?php foreach ($group['attributes'] as $attribute) : ?>
                                        <?= /* @noEscape */ $block->getFieldRenderer()->render($block, (string) $attribute->getAttributeCode(), $block->getLayout()) ?>
                                    <?php endforeach; ?>
                                </div>
                            </div>
                        </div>
                        <?php endforeach; ?>
                    </div>
                </div>
                <?php endif; ?>
            </div>
        </div>

        <?php
        // form-shell-close.phtml closes the <form> + the nebulaForm <div> from form-shell
        include $block->getTemplateFile('Qoliber_NebulaForm::form-shell-close.phtml');
        ?>

        <!-- Drawer: tablet/mobile only, controlled by Alpine x-show -->
        <div
            x-show="drawerOpen"
            x-cloak
            class="fixed inset-0"
            style="z-index:2147483647;"
            @keydown.escape.window="closeDrawer()"
        >
            <div
                x-show="drawerOpen"
                x-transition:enter="transition ease-out duration-200"
                x-transition:enter-start="opacity-0"
