<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */

$entity = $block->getData('entity');
$formBlock = $block->getData('form_block');
$definition = $formBlock->getDefinition();
$fieldPrefix = $definition['settings']['fieldPrefix'] ?? '';

$fields = [
    'no_index' => ['label' => __('No Index'), 'value' => $entity ? (bool) $entity->getData('no_index') : false],
    'no_follow' => ['label' => __('No Follow'), 'value' => $entity ? (bool) $entity->getData('no_follow') : false],
    'no_archive' => ['label' => __('No Archive'), 'value' => $entity ? (bool) $entity->getData('no_archive') : false],
];
?>

<div class="grid grid-cols-3 gap-4 py-4 border-t border-gray-100 mt-2">
    <label class="pt-1 text-sm font-medium text-gray-700"><?= $escaper->escapeHtml((string) __('Indexing')) ?></label>
    <div class="col-span-2 flex items-center gap-6">
        <?php foreach ($fields as $code => $field) : ?>
            <?php
            $name = $fieldPrefix ? $fieldPrefix . '[' . $code . ']' : $code;
            $isOn = $field['value'];
            ?>
        <div x-data="{ on: <?= $isOn ? 'true' : 'false' ?> }" class="flex items-center gap-2">
            <input type="hidden" name="<?= $escaper->escapeHtmlAttr($name) ?>" :value="on ? 1 : 0">
            <button type="button" @click="on = !on"
                    :class="on ? 'bg-indigo-600' : 'bg-gray-300 ring-1 ring-inset ring-gray-400'"
                    class="relative inline-flex h-5 w-9 flex-shrink-0 cursor-pointer rounded-full border-2 border-transparent shadow-sm transition-colors duration-200 ease-in-out focus:outline-none focus:ring-2 focus:ring-indigo-600 focus:ring-offset-2"
                    role="switch" :aria-checked="on">
                <span :class="on ? 'translate-x-4' : 'translate-x-0'"
                      class="pointer-events-none inline-block h-4 w-4 transform rounded-full bg-white shadow-md ring-1 ring-gray-200 transition duration-200 ease-in-out"></span>
            </button>
            <span class="text-xs font-medium" :class="on ? 'text-indigo-600' : 'text-gray-500'"><?= $escaper->escapeHtml((string) $field['label']) ?></span>
        </div>
        <?php endforeach; ?>
    </div>
</div>
