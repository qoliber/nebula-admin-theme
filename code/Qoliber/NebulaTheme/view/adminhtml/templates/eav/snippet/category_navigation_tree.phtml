                    <?= $escaper->escapeHtml((string) __('Exit')) ?>
                </button>
                <div x-show="sortMode && sortDirty" class="flex items-center gap-1.5">
                    <button type="button"
                            @click="cancelSort()"
                            class="inline-flex items-center rounded px-2 py-1 text-xs font-medium text-gray-600 border border-gray-300 hover:bg-gray-100 transition">
