<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Qoliber\NebulaTheme\ViewModel\CategoryTree $viewModel */

$viewModel = $block->getData('view_model');
if (!$viewModel instanceof \Qoliber\NebulaTheme\ViewModel\CategoryTree) {
    throw new \RuntimeException(
        'Nebula snippet "category_navigation_tree": view_model was not injected '
        . '(expected \Qoliber\NebulaTheme\ViewModel\CategoryTree). Check the SnippetViewModelRegistry binding or layout wiring.'
    );
}

$entity = $block->getData('entity');
$formBlock = $block->getData('form_block');

$currentId = $entity ? (string) $entity->getId() : '';

$items = $viewModel->getItems();
$tree = $viewModel->getTree();

// Always expand root/level-1 categories (Default Category etc.)
$expandedIds = [];
foreach ($items as $id => $item) {
    if ($item['level'] <= 2) {
        $expandedIds[$id] = true;
    }
}

// Also expand parents of current category
if ($currentId && isset($items[$currentId])) {
    $current = $currentId;
    while (isset($items[$current]) && isset($items[$items[$current]['parent_id']])) {
        $current = $items[$current]['parent_id'];
        $expandedIds[$current] = true;
    }
}

$treeConfig = json_encode([
    'tree'          => $tree,
    'expandedIds'   => (object) $expandedIds,
    'currentId'     => $currentId,
    'reorderUrl'    => $formBlock->getUrl('nebula/category/reorderChildren'),
    'moveUrl'       => $formBlock->getUrl('catalog/category/move'),
    'deleteBaseUrl' => $formBlock->getUrl('catalog/category/delete'),
    'formKey'       => $formBlock->getFormKey(),
], JSON_HEX_APOS | JSON_HEX_QUOT);
?>

<script>
(function() {
    if (window._nebulaCategoryNavTreeRegistered) return;
    window._nebulaCategoryNavTreeRegistered = true;

    var register = function() {
        Alpine.data('nebulaCategoryNavTree', function(config) {
            return {
                expanded: config.expandedIds || {},
                tree: config.tree || [],
                currentId: config.currentId || '',
                reorderUrl: config.reorderUrl || '',
                moveUrl: config.moveUrl || '',
                deleteBaseUrl: config.deleteBaseUrl || '',
                formKey: config.formKey || '',
                _sortableInstances: [],
                _sortSaving: false,
                sortMode: false,
                sortDirty: false,
                _savedContainerOrder: null,
                _pendingMoves: [],
                _deleteOpen: false,
                _deleteTarget: null,
                _deleteItems: [],

                init: function() {
                    // Sortable is not activated on load — user must click Reorder.
                },

                toggleExpand: function(id) {
                    this.expanded[id] = !this.expanded[id];
                },

                hasUnsavedChanges: function() {
                    if (window.Nebula && typeof window.Nebula.hasUnsavedCategoryChanges === 'function') {
                        return window.Nebula.hasUnsavedCategoryChanges();
                    }

                    return false;
                },

                closeCategoryDrawer: function() {
                    var drawerRoot = document.querySelector('[data-nebula-category-drawer]');
                    if (!drawerRoot || !window.Alpine || typeof Alpine.$data !== 'function') {
                        return;
                    }

                    try {
                        var drawerData = Alpine.$data(drawerRoot);
                        if (drawerData && typeof drawerData.closeDrawer === 'function') {
                            drawerData.closeDrawer();
                        }
                    } catch (e) {
                        // Ignore drawer close failures
                    }
                },

                confirmCategorySwitch: async function(url) {
                    if (this.sortMode && this.sortDirty) {
                        if (window.nebulaToast) window.nebulaToast('error', '<?= $escaper->escapeJs((string) __('Save or cancel the reorder first.')) ?>');
                        return;
                    }

                    if (this.sortMode && !this.sortDirty) {
                        this.disableSortMode();
                    }

                    if (!this.hasUnsavedChanges()) {
                        this.closeCategoryDrawer();
                        window.location.href = url;
                        return;
                    }

                    var confirmed = await window.Nebula.confirm({ title: '<?= $escaper->escapeJs((string) __('Discard unsaved changes?')) ?>', message: '<?= $escaper->escapeJs((string) __('You have edits that will be lost if you leave this page.')) ?>', danger: true, confirmText: '<?= $escaper->escapeJs((string) __('Discard')) ?>', cancelText: '<?= $escaper->escapeJs((string) __('Stay')) ?>' });
                    if (confirmed) {
                        this.closeCategoryDrawer();
                        window.location.href = url;
                    }
                },

                expandAll: function() {
                    var self = this;
                    function walk(nodes) {
                        nodes.forEach(function(n) {
                            if (n.children && n.children.length) {
                                self.expanded[n.id] = true;
                                walk(n.children);
                            }
                        });
                    }
                    walk(this.tree);
                },

                collapseAll: function() {
                    this.expanded = {};
                },

                // --- Sort mode --------------------------------------------------

                enableSortMode: function() {
                    this._savedContainerOrder = this._captureContainerOrder();
                    this.sortMode = true;
                    var self = this;
                    this.$nextTick(function() { self._initAllSortables(); });
                },

                disableSortMode: function() {
                    this._destroyAllSortables();
                    this.sortMode = false;
                    this.sortDirty = false;
                    this._savedContainerOrder = null;
                    this._pendingMoves = [];
                },

                cancelSort: function() {
                    window.location.reload();
                },

                saveSort: function() {
                    var self = this;
                    self._sortSaving = true;
                    self._savePendingChanges().then(function(success) {
                        self._sortSaving = false;
                        if (success) {
                            self.disableSortMode();
                        }
                    });
                },

                _captureContainerOrder: function() {
                    var state = {};
                    document.querySelectorAll('[data-sort-container]').forEach(function(el) {
                        var parentId = el.dataset.parentId;
                        state[parentId] = Array.from(
                            el.querySelectorAll(':scope > [data-cat-id]')
                        ).map(function(child) { return child.dataset.catId; });
                    });
                    return state;
                },

                _savePendingChanges: function() {
                    var self = this;

                    // Step 1: replay cross-parent moves sequentially (order matters for path/level updates)
                    var moveChain = self._pendingMoves.reduce(function(chain, move) {
                        return chain.then(function(ok) {
                            if (!ok) return false;
                            return self._moveCategoryAsync(move.id, move.pid, move.aid);
                        });
                    }, Promise.resolve(true));

                    return moveChain.then(function(movesOk) {
                        if (!movesOk) {
                            if (window.nebulaToast) window.nebulaToast('error', '<?= $escaper->escapeJs((string) __('Could not move category.')) ?>');
                            window.location.reload();
                            return false;
                        }

                        // Step 2: reorder all changed same-parent containers in parallel
                        var current = self._captureContainerOrder();
                        var original = self._savedContainerOrder || {};
                        var saves = [];

                        document.querySelectorAll('[data-sort-container]').forEach(function(el) {
                            var parentId = el.dataset.parentId;
                            var currentIds = current[parentId] || [];
                            var originalIds = original[parentId] || [];
                            if (JSON.stringify(currentIds) !== JSON.stringify(originalIds)) {
                                saves.push(self._reorderSiblingsAsync(parentId, currentIds));
                            }
                        });

                        if (saves.length === 0) {
                            if (window.nebulaToast) window.nebulaToast('success', '<?= $escaper->escapeJs((string) __('Category order saved.')) ?>');
                            return true;
                        }

                        return Promise.all(saves).then(function(results) {
                            var allOk = results.every(Boolean);
                            if (allOk) {
                                if (window.nebulaToast) window.nebulaToast('success', '<?= $escaper->escapeJs((string) __('Category order saved.')) ?>');
                            } else {
                                if (window.nebulaToast) window.nebulaToast('error', '<?= $escaper->escapeJs((string) __('Some categories could not be saved.')) ?>');
                            }
                            return allOk;
                        });
                    });
                },

                _moveCategoryAsync: function(id, pid, aid) {
                    var body = new URLSearchParams({ id: id, pid: pid, aid: aid, form_key: this.formKey });
                    return fetch(this.moveUrl, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/x-www-form-urlencoded', 'X-Requested-With': 'XMLHttpRequest' },
                        body: body.toString()
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(data) {
                        if (data.error && data.messages) {
                            var tmp = document.createElement('div');
                            tmp.innerHTML = data.messages;
                            var text = (tmp.textContent || tmp.innerText || '').trim();
                            if (text && window.nebulaToast) window.nebulaToast('error', text);
                        }
                        return !data.error;
                    })
                    .catch(function() { return false; });
                },

                _reorderSiblingsAsync: function(parentId, ids) {
                    var url = this.reorderUrl + '?form_key=' + encodeURIComponent(this.formKey);
                    return fetch(url, {
                        method: 'POST',
                        credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
                        body: JSON.stringify({ parent_id: parentId, ids: ids })
                    })
                    .then(function(r) { return r.json(); })
                    .then(function(data) { return !!data.success; })
                    .catch(function() { return false; });
                },

                // --- Drag-to-reorder --------------------------------------------

                _initAllSortables: function() {
                    this._destroyAllSortables();
                    var self = this;
                    document.querySelectorAll('[data-sort-container]').forEach(function(el) {
                        if (!window.Sortable) return;
                        var instance = window.Sortable.create(el, {
                            group: { name: 'cat-tree', pull: true, put: true },
                            handle: '[data-cat-drag-handle]',
                            draggable: '[data-cat-id]',
                            animation: 150,
                            ghostClass: 'opacity-40',
                            onEnd: function(evt) { self._onSortEnd(evt); }
                        });
                        self._sortableInstances.push(instance);
                    });
                },

                _destroyAllSortables: function() {
                    this._sortableInstances.forEach(function(s) {
                        if (s && typeof s.destroy === 'function') s.destroy();
                    });
                    this._sortableInstances = [];
                },

                _onSortEnd: function(evt) {
                    if (!evt.item || !evt.from || !evt.to) return;
                    var movedId = evt.item.dataset.catId;
                    if (!movedId) return;

                    var fromParentId = evt.from.dataset.parentId;
                    var toParentId = evt.to.dataset.parentId;

                    if (fromParentId !== toParentId) {
                        if (String(movedId) === String(toParentId) || this._isAncestorOf(movedId, toParentId)) {
                            evt.from.insertBefore(evt.item, evt.from.children[evt.oldIndex] || null);
                            if (window.nebulaToast) window.nebulaToast('error', '<?= $escaper->escapeJs((string) __('A category cannot be moved into one of its own subcategories.')) ?>');
                            return;
                        }
                        var siblings = Array.from(evt.to.querySelectorAll(':scope > [data-cat-id]'));
                        var newIdx = siblings.indexOf(evt.item);
                        var aid = newIdx > 0 ? (siblings[newIdx - 1].dataset.catId || '0') : '0';
                        this._pendingMoves.push({ id: movedId, pid: toParentId, aid: aid });
                    }

                    this.sortDirty = true;
                    // Same-parent: handled by _savePendingChanges() on Save
                },

                _findNodeInTree: function(id, nodes) {
                    nodes = nodes || this.tree;
                    for (var i = 0; i < nodes.length; i++) {
                        if (String(nodes[i].id) === String(id)) return nodes[i];
                        if (nodes[i].children && nodes[i].children.length) {
                            var found = this._findNodeInTree(id, nodes[i].children);
                            if (found) return found;
                        }
                    }
                    return null;
                },

                _countDescendants: function(id) {
                    var node = this._findNodeInTree(id);
                    if (!node) return 0;
                    function count(n) {
                        var total = 0;
                        if (n.children) {
                            for (var i = 0; i < n.children.length; i++) {
                                total += 1 + count(n.children[i]);
                            }
                        }
                        return total;
                    }
                    return count(node);
                },

                _isAncestorOf: function(ancestorId, descendantId) {
                    var ancestor = this._findNodeInTree(ancestorId);
                    if (!ancestor) return false;
                    function has(n, targetId) {
                        if (!n.children) return false;
                        for (var i = 0; i < n.children.length; i++) {
                            if (String(n.children[i].id) === String(targetId)) return true;
                            if (has(n.children[i], targetId)) return true;
                        }
                        return false;
                    }
                    return has(ancestor, descendantId);
                },

                confirmDeleteCategory: function(id, name) {
                    var items = [];
                    function flatten(node, depth) {
                        items.push({
                            id: node.id,
                            name: node.name,
                            depth: depth,
                            isActive: node.is_active !== false
                        });
                        if (node.children) {
                            node.children.forEach(function(child) { flatten(child, depth + 1); });
                        }
                    }
                    var node = this._findNodeInTree(id);
                    if (node) { flatten(node, 0); }
                    this._deleteTarget = { id: id, name: name };
                    this._deleteItems = items;
                    this._deleteOpen = true;
                },

                _cancelDelete: function() {
                    this._deleteOpen = false;
                    this._deleteTarget = null;
                    this._deleteItems = [];
                },

                _executeDelete: function() {
                    if (this._deleteTarget) {
                        window.location.href = this.deleteBaseUrl + 'id/' + this._deleteTarget.id + '/';
                    }
                }
            };
        });
    };

    if (window.Alpine) { register(); }
    else { document.addEventListener('alpine:init', register); }
})();
</script>

<script>
(function() {
    if (window._nebulaCategoryDirtyStateRegistered) return;
    window._nebulaCategoryDirtyStateRegistered = true;

    window.Nebula = window.Nebula || {};

    window.Nebula.serializeCategoryFormState = function(form) {
        if (!form) {
            return '';
        }

        try {
            return JSON.stringify(Array.from(new FormData(form).entries()));
        } catch (e) {
            return '';
        }
    };

    window.Nebula.captureInitialCategoryState = function() {
        var form = document.querySelector('form[x-ref="nebulaEavForm"], form[x-ref="nebulaForm"]');
        if (!form) {
            return;
        }

        var serialized = window.Nebula.serializeCategoryFormState(form);
        if (serialized !== '') {
            form.dataset.nebulaInitialState = serialized;
        }
    };

    window.Nebula.hasUnsavedCategoryChanges = function() {
        var form = document.querySelector('form[x-ref="nebulaEavForm"], form[x-ref="nebulaForm"]');
        if (!form) {
            return false;
        }

        if (!form.dataset.nebulaInitialState) {
            window.Nebula.captureInitialCategoryState();
        }

        var currentState = window.Nebula.serializeCategoryFormState(form);
        if (currentState === '' || !form.dataset.nebulaInitialState) {
            return false;
        }

        return currentState !== form.dataset.nebulaInitialState;
    };

    window.addEventListener('pageshow', function() {
        window.Nebula.captureInitialCategoryState();
    });

    document.addEventListener('DOMContentLoaded', function() {
        window.Nebula.captureInitialCategoryState();
    });
})();
</script>

