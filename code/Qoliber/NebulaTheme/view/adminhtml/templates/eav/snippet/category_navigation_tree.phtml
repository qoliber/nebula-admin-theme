                            class="inline-flex items-center rounded px-2 py-1 text-xs font-semibold text-white bg-indigo-600 hover:bg-indigo-500 disabled:opacity-60 transition">
                        <span x-text="_sortSaving ? '<?= $escaper->escapeJs((string) __('Saving…')) ?>' : '<?= $escaper->escapeJs((string) __('Save order')) ?>'"></span>
                    </button>
                </div>
            </div>
        </div>
        <div class="flex items-center gap-2">
            <a href="<?= $escaper->escapeUrl($formBlock->getUrl('catalog/category/add')) ?>"
               class="inline-flex items-center gap-1 rounded-md bg-indigo-600 px-2.5 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-indigo-500">
                <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                <?= $escaper->escapeHtml((string) __('Root Category')) ?>
            </a>
            <?php if ($currentId) : ?>
            <a href="<?= $escaper->escapeUrl($formBlock->getUrl('catalog/category/add', ['parent' => $currentId])) ?>"
               class="inline-flex items-center gap-1 rounded-md bg-white px-2.5 py-1.5 text-xs font-semibold text-gray-700 shadow-sm ring-1 ring-inset ring-gray-300 transition hover:bg-gray-50">
                <svg class="h-3.5 w-3.5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15"/></svg>
                <?= $escaper->escapeHtml((string) __('Subcategory')) ?>
            </a>
            <?php endif; ?>
        </div>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-3">
        <?php
        $renderNavNode = function (array $nodes, $block, $formBlock, string $currentId, int $depth = 0) use (&$renderNavNode, $escaper): void {
            foreach ($nodes as $node) {
                $hasChildren = !empty($node['children']);
                $isCurrent = ($node['id'] === $currentId);
                $editUrl = $formBlock->getUrl('catalog/category/edit', ['id' => $node['id']]);
                $depthPaddingClass = match (true) {
                    $depth <= 0 => 'pl-0',
                    $depth === 1 => 'pl-3',
                    $depth === 2 => 'pl-6',
                    $depth === 3 => 'pl-9',
                    default => 'pl-12',
                };
                ?>
                <div class="<?= $escaper->escapeHtmlAttr($depthPaddingClass) ?>" data-cat-id="<?= $escaper->escapeHtmlAttr((string) $node['id']) ?>">
                    <div class="flex items-center gap-1 py-px">
                        <button type="button"
                                data-cat-drag-handle
                                title="<?= $escaper->escapeHtmlAttr((string) __('Drag to reorder')) ?>"
                                :class="sortMode ? 'cursor-grab active:cursor-grabbing text-gray-300 hover:text-gray-500' : 'opacity-0 pointer-events-none cursor-default'"
                                class="flex-shrink-0 p-0.5 rounded transition-opacity">
                            <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="9"  cy="5"  r="1.5"/>
                                <circle cx="15" cy="5"  r="1.5"/>
                                <circle cx="9"  cy="12" r="1.5"/>
                                <circle cx="15" cy="12" r="1.5"/>
                                <circle cx="9"  cy="19" r="1.5"/>
                                <circle cx="15" cy="19" r="1.5"/>
                            </svg>
                        </button>
                        <?php if ($hasChildren) : ?>
                            <button type="button"
                                    @click="toggleExpand('<?= $escaper->escapeJs((string) $node['id']) ?>')"
                                    aria-label="<?= $escaper->escapeHtmlAttr((string) __('Toggle child categories for %1', $node['name'])) ?>"
                                    title="<?= $escaper->escapeHtmlAttr((string) __('Toggle child categories for %1', $node['name'])) ?>"
                                    class="flex-shrink-0 text-gray-400 hover:text-gray-600 w-4 h-4 flex items-center justify-center transition">
                                <svg class="h-3 w-3 transition-transform" :class="expanded['<?= $escaper->escapeJs((string) $node['id']) ?>'] ? 'rotate-90' : ''" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
                            </button>
                        <?php endif; ?>
                        <?php if ($isCurrent) : ?>
                            <span class="truncate rounded px-2 py-0.5 text-sm font-semibold text-indigo-700 bg-indigo-100 flex-1">
                                <?= $escaper->escapeHtml($node['name']) ?>
                            </span>
                        <?php else : ?>
                            <a href="<?= $escaper->escapeUrl($editUrl) ?>"
                               @click.prevent="confirmCategorySwitch('<?= $escaper->escapeJs($editUrl) ?>')"
                               class="truncate rounded px-2 py-0.5 text-sm hover:bg-gray-100 transition flex-1 <?= $node['is_active'] ? 'text-gray-700' : 'text-gray-400 line-through' ?>">
                                <?= $escaper->escapeHtml($node['name']) ?>
                            </a>
                        <?php endif; ?>
                    </div>
                    <?php if ($hasChildren) : ?>
                        <div x-show="expanded['<?= $escaper->escapeJs((string) $node['id']) ?>']"
                             x-collapse
                             class="border-l border-gray-200 ml-2"
                             data-sort-container
                             data-parent-id="<?= $escaper->escapeHtmlAttr((string) $node['id']) ?>">
                            <?php $renderNavNode($node['children'], $block, $formBlock, $currentId, $depth + 1); ?>
                        </div>
                    <?php endif; ?>
                </div>
                <?php
            }
        };
?>
        <div data-sort-container data-parent-id="0">
            <?php $renderNavNode($tree, $block, $formBlock, $currentId); ?>
        </div>
    </div>
</div>
