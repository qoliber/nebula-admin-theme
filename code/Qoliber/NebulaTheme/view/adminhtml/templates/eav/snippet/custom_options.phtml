<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Magento\Framework\Escaper $escaper */

$entity = $block->getData('entity');
$formBlock = $block->getData('form_block');

$existingOptions = [];
if ($entity && $entity->getOptions()) {
    foreach ($entity->getOptions() as $option) {
        $optData = [
            'option_id' => $option->getOptionId(),
            'title' => $option->getTitle(),
            'type' => $option->getType(),
            'is_require' => (int)$option->getIsRequire(),
            'sort_order' => (int)$option->getSortOrder(),
            'price' => $option->getPrice() ? (float)$option->getPrice() : '',
            'price_type' => $option->getPriceType() ?: 'fixed',
            'sku' => $option->getSku() ?: '',
            'max_characters' => $option->getMaxCharacters() ? (int)$option->getMaxCharacters() : '',
            'file_extension' => $option->getFileExtension() ?: '',
            'values' => [],
        ];
        if ($option->getValues()) {
            foreach ($option->getValues() as $value) {
                $optData['values'][] = [
                    'option_type_id' => $value->getOptionTypeId(),
                    'title' => $value->getTitle(),
                    'price' => (float)$value->getPrice(),
                    'price_type' => $value->getPriceType() ?: 'fixed',
                    'sku' => $value->getSku() ?: '',
                    'sort_order' => (int)$value->getSortOrder(),
                ];
            }
        }
        $existingOptions[] = $optData;
    }
}

$optionsConfig = json_encode([
    'existingOptions' => $existingOptions,
    'messages' => [
        'titleRequired' => (string) __('Option title is required'),
        'addValue' => (string) __('Add at least one value with a title'),
        'uniqueSkus' => (string) __('Value SKUs must be unique'),
    ],
], JSON_HEX_APOS | JSON_HEX_QUOT);
