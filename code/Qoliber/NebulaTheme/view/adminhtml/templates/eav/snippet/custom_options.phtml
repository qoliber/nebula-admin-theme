                                    <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
                                    </svg>
                                    <?= $escaper->escapeHtml((string)__('Add Value')) ?>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <div class="sticky bottom-0 bg-white border-t border-gray-200 px-8 py-4 rounded-b-2xl flex items-center justify-between shrink-0">
                    <button type="button" @click="modalStep > 0 && editIndex === null ? (prevModalStep(), resetWizard()) : closeModal()"
                            class="inline-flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm hover:bg-gray-50 transition">
                        <span x-text="modalStep === 0 || editIndex !== null ? '<?= $escaper->escapeJs((string)__('Cancel')) ?>' : '<?= $escaper->escapeJs((string)__('Back')) ?>'"></span>
                    </button>
                    <div x-show="modalStep === 1" class="flex items-center gap-3">
                        <p x-show="validationMessage && !canSave" class="text-sm text-red-600" x-text="validationMessage"></p>
                        <button type="button" @click="saveOption()" :disabled="!canSave"
                                class="inline-flex items-center gap-2 rounded-lg bg-indigo-600 px-5 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 disabled:opacity-40 disabled:cursor-not-allowed transition">
                            <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m4.5 12.75 6 6 9-13.5" />
                            </svg>
                            <span x-text="editIndex !== null ? '<?= $escaper->escapeJs((string)__('Update Option')) ?>' : '<?= $escaper->escapeJs((string)__('Add Option')) ?>'"></span>
                        </button>
