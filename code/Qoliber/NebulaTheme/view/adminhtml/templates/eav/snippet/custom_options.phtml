                                                            <option value="percent"><?= $escaper->escapeHtml((string)__('Percent')) ?></option>
                                                        </select>
                                                    </td>
                                                    <td class="px-3 py-2">
                                                        <input type="text" x-model="val.sku" placeholder="<?= $escaper->escapeHtmlAttr((string)__('SKU')) ?>"
