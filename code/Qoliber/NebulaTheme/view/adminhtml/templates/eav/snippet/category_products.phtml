<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Qoliber\NebulaTheme\ViewModel\CategoryProducts $viewModel */

$viewModel = $block->getData('view_model');
if (!$viewModel instanceof \Qoliber\NebulaTheme\ViewModel\CategoryProducts) {
    // nebula:allow-object-manager dynamic-snippet-view-model fallback.
    $viewModel = \Magento\Framework\App\ObjectManager::getInstance()
        ->get(\Qoliber\NebulaTheme\ViewModel\CategoryProducts::class);
}

$entity = $block->getData('entity');
$formBlock = $block->getData('form_block');

$assignedProducts = $viewModel->getAssignedProducts($entity);

$searchUrl = $formBlock->getUrl('nebula/grid/productSearch');
$formKey = $formBlock->getFormKey();

$productsJson = [];
foreach ($assignedProducts as $p) {
    $productsJson[$p['id']] = $p['position'];
}
?>

<script>
(function() {
    if (window._nebulaCategoryProductsRegistered) return;
    window._nebulaCategoryProductsRegistered = true;

    var register = function() {
        Alpine.data('nebulaCategoryProducts', function(config) {
            return {
                products: config.products || [],
                productsJson: config.productsJson || {},

                syncJson: function() {
                    var json = {};
                    this.products.forEach(function(p, i) {
                        json[p.id] = p.position !== undefined ? p.position : i;
                    });
                    this.productsJson = json;
                },

                addProduct: function(product) {
                    if (this.products.find(function(p) { return p.id === product.id; })) return;
                    product.position = this.products.length;
                    this.products.push(product);
                    this.syncJson();
                },

                removeProduct: function(id) {
                    this.products = this.products.filter(function(p) { return p.id !== id; });
                    this.syncJson();
                },

                updatePosition: function(id, pos) {
                    var p = this.products.find(function(p) { return p.id === id; });
                    if (p) { p.position = parseInt(pos) || 0; }
                    this.syncJson();
                }
            };
        });
    };

    if (window.Alpine) { register(); }
    else { document.addEventListener('alpine:init', register); }
})();
</script>

<div x-data="nebulaCategoryProducts(<?= $escaper->escapeHtmlAttr(json_encode([
    'products' => $assignedProducts,
    'productsJson' => (object) $productsJson,
    'searchUrl' => $searchUrl,
    'formKey' => $formKey,
])) ?>)" class="min-h-0">
    <input type="hidden" name="category_products" :value="JSON.stringify(productsJson)">

    <div class="max-h-[calc(100vh-18rem)] overflow-y-auto pr-1">
        <?php
        /** @var \Magento\Framework\View\Element\Template $renderer */
        $renderer = $formBlock->getLayout()->createBlock(\Magento\Framework\View\Element\Template::class);
$formBlock->setModuleOnBlock($renderer, 'Qoliber_NebulaComponent::snippet/product_selector.phtml');
$renderer->setTemplate('Qoliber_NebulaComponent::snippet/product_selector.phtml');
$renderer->setData('field_name', 'category_products_ids[]');
$renderer->setData('selected_products', $assignedProducts);
$renderer->setData('search_url', $searchUrl);
$renderer->setData('form_key', $formKey);
$renderer->setData('label', (string) __('Products in Category'));
$renderer->setData('max_results', 20);

echo $renderer->toHtml();
?>
    </div>
</div>
