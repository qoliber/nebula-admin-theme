<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Qoliber\NebulaTheme\ViewModel\CategoryTree $viewModel */

$viewModel = $block->getData('view_model');
if (!$viewModel instanceof \Qoliber\NebulaTheme\ViewModel\CategoryTree) {
    throw new \RuntimeException(
        'Nebula snippet "category_tree": view_model was not injected '
        . '(expected \Qoliber\NebulaTheme\ViewModel\CategoryTree). Check the SnippetViewModelRegistry binding or layout wiring.'
    );
}

$entity = $block->getData('entity');
$formBlock = $block->getData('form_block');
$assignedIds = [];

if ($entity) {
    $assignedIds = $entity->getCategoryIds();
    if (!is_array($assignedIds)) {
        $assignedIds = [];
    }
    $assignedIds = array_map('strval', $assignedIds);
}

$items = $viewModel->getItems();

// Build paths
$options = [];
foreach ($items as $id => $item) {
    $parts = [];
    $current = $id;
    while (isset($items[$current])) {
        $parts[] = $items[$current]['name'];
        $current = $items[$current]['parent_id'];
    }
    $options[] = [
        'value' => $id,
        'label' => $item['name'],
        'path' => implode(' / ', array_reverse($parts)),
    ];
}

$tree = $viewModel->getTree();

// Auto-expand parents of assigned categories
$expandedIds = [];
foreach ($assignedIds as $catId) {
    $current = $catId;
    while (isset($items[$current]) && isset($items[$items[$current]['parent_id']])) {
        $current = $items[$current]['parent_id'];
        $expandedIds[$current] = true;
    }
}

// Render the searchable multiselect
$renderer = $formBlock->getLayout()->createBlock(\Magento\Framework\View\Element\Template::class);
$formBlock->setModuleOnBlock($renderer, 'Qoliber_NebulaComponent::snippet/searchable_multiselect.phtml');
$renderer->setTemplate('Qoliber_NebulaComponent::snippet/searchable_multiselect.phtml');
$renderer->setData('field_name', 'product[category_ids][]');
$renderer->setData('options', $options);
$renderer->setData('selected', $assignedIds);
$renderer->setData('placeholder', (string) __('Search categories...'));
$renderer->setData('max_results', 50);
$renderer->setData('show_tree_button', true);

echo $renderer->toHtml();

// Tree modal data
$treeConfig = json_encode([
    'tree' => $tree,
    'expandedIds' => (object) $expandedIds,
], JSON_HEX_APOS | JSON_HEX_QUOT);
?>

