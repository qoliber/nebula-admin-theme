                    <?php
                    /**
                     * Walk the subtree rooted at $node and return all names
                     * concatenated, lowercased, space-separated. Used as the
                     * `data-search-text` payload so the client-side filter
                     * can match against an entire branch in one indexOf call.
                     */
                    $subtreeText = function (array $node) use (&$subtreeText): string {
                        $parts = [(string) $node['name']];
                        foreach ($node['children'] ?? [] as $child) {
                            $parts[] = $subtreeText($child);
                        }
                        return mb_strtolower(implode(' ', $parts));
                    };

$renderTreeNode = function (array $nodes, $block, int $depth = 0, bool $isLast = false) use (&$renderTreeNode, $subtreeText, $escaper): void {
    $count = count($nodes);
    foreach ($nodes as $i => $node) {
        $hasChildren = !empty($node['children']);
        $isLastNode = ($i === $count - 1);
        ?>
                            <div class="relative <?= $depth > 0 ? 'pl-5' : 'pl-0' ?>"
                                 data-node-id="<?= $escaper->escapeHtmlAttr((string) $node['id']) ?>"
                                 data-search-text="<?= $escaper->escapeHtmlAttr($subtreeText($node)) ?>"
                                 x-show="matchesSearch($el)">
                                <?php if ($depth > 0) : ?>
                                <!-- Branch line -->
                                <div class="absolute left-0 top-0 w-px bg-gray-200 <?= $isLastNode ? 'h-4' : 'h-full' ?>"></div>
                                <div class="absolute left-0 top-3.5 w-3 h-px bg-gray-200"></div>
                                <?php endif; ?>
                                <div class="flex items-center gap-2 py-1">
                                    <?php if ($hasChildren) : ?>
                                        <button type="button"
                                                @click="toggleExpand('<?= $escaper->escapeJs((string) $node['id']) ?>')"
                                                aria-label="<?= $escaper->escapeHtmlAttr((string) __('Toggle child categories for %1', $node['name'])) ?>"
                                                title="<?= $escaper->escapeHtmlAttr((string) __('Toggle child categories for %1', $node['name'])) ?>"
                                                class="flex-shrink-0 text-gray-400 hover:text-gray-600 w-5 h-5 flex items-center justify-center transition">
                                            <svg class="h-3.5 w-3.5 transition-transform" :class="expanded['<?= $escaper->escapeJs((string) $node['id']) ?>'] ? 'rotate-90' : ''" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" d="m8.25 4.5 7.5 7.5-7.5 7.5"/></svg>
                                        </button>
                                    <?php else : ?>
                                        <span class="flex-shrink-0 w-5"></span>
                                    <?php endif; ?>
                                    <label class="flex items-center gap-2 cursor-pointer flex-1 min-w-0 rounded-md px-1.5 py-0.5 -ml-1.5 hover:bg-gray-50 transition">
                                        <input type="checkbox"
                                               :checked="isChecked('<?= $escaper->escapeJs((string) $node['id']) ?>')"
                                               @change="toggleCategory('<?= $escaper->escapeJs((string) $node['id']) ?>')"
                                               class="h-4 w-4 flex-shrink-0 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                                        <span class="text-sm <?= $node['is_active'] ? 'text-gray-900' : 'text-gray-400 line-through' ?>">
                                            <?= $escaper->escapeHtml($node['name']) ?>
                                        </span>
                                        <?php if (!$node['is_active']) : ?>
                                        <span class="text-xs text-gray-400">(<?= $escaper->escapeHtml((string) __('disabled')) ?>)</span>
                                        <?php endif; ?>
                                    </label>
                                </div>
                                <?php if ($hasChildren) : ?>
                                    <div x-show="expanded['<?= $escaper->escapeJs((string) $node['id']) ?>']" x-collapse>
                                        <?php $renderTreeNode($node['children'], $block, $depth + 1, $isLastNode); ?>
                                    </div>
                                <?php endif; ?>
                            </div>
                            <?php
    }
};
$renderTreeNode($tree, $block);
?>
