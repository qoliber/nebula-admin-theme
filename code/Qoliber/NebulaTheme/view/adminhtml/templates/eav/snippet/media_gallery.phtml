<?php

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */
/** @var \Qoliber\NebulaTheme\ViewModel\MediaGallery $viewModel */

$viewModel = $block->getData('view_model');
if (!$viewModel instanceof \Qoliber\NebulaTheme\ViewModel\MediaGallery) {
    // nebula:allow-object-manager dynamic-snippet-view-model fallback.
    $viewModel = \Magento\Framework\App\ObjectManager::getInstance()
        ->get(\Qoliber\NebulaTheme\ViewModel\MediaGallery::class);
}

$entity = $block->getData('entity');
$formBlock = $block->getData('form_block');

$uploadUrl = $formBlock->getUrl('catalog/product_gallery/upload');
$formKey = $formBlock->getFormKey();

$galleryData = $entity ? $entity->getData('media_gallery') : ['images' => []];
$existingImages = $galleryData['images'] ?? [];

$baseImage = $entity ? $entity->getData('image') : null;
$smallImage = $entity ? $entity->getData('small_image') : null;
$thumbnail = $entity ? $entity->getData('thumbnail') : null;
$swatchImage = $entity ? $entity->getData('swatch_image') : null;

$imagesData = $viewModel->buildImagesData($entity, $existingImages);

$configJson = json_encode([
    'images' => $imagesData,
    'baseImage' => $baseImage,
    'smallImage' => $smallImage,
    'thumbnailImage' => $thumbnail,
    'swatchImage' => $swatchImage,
    'uploadUrl' => $uploadUrl,
    'formKey' => $formKey,
], JSON_HEX_APOS | JSON_HEX_QUOT);
?>

