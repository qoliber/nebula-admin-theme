                        <label class="flex items-center gap-1.5 text-xs cursor-pointer">
                            <input type="radio" name="product[small_image]" :value="img.file" :checked="img.file === smallImage" @change="smallImage = img.file" class="h-3 w-3 border-gray-300 text-indigo-600 focus:ring-indigo-600">
                            <?= $escaper->escapeHtml((string) __('Small')) ?>
                        </label>
                        <label class="flex items-center gap-1.5 text-xs cursor-pointer">
                            <input type="radio" name="product[thumbnail]" :value="img.file" :checked="img.file === thumbnailImage" @change="thumbnailImage = img.file" class="h-3 w-3 border-gray-300 text-indigo-600 focus:ring-indigo-600">
                            <?= $escaper->escapeHtml((string) __('Thumb')) ?>
                        </label>
                        <label class="flex items-center gap-1.5 text-xs cursor-pointer">
                            <input type="radio" name="product[swatch_image]" :value="img.file" :checked="img.file === swatchImage" @change="swatchImage = img.file" class="h-3 w-3 border-gray-300 text-indigo-600 focus:ring-indigo-600">
                            <?= $escaper->escapeHtml((string) __('Swatch')) ?>
                        </label>
                    </div>

                    <!-- Hidden fields -->
                    <input type="hidden" :name="'product[media_gallery][images][' + getRealIndex(img) + '][file]'" :value="img.file">
                    <input type="hidden" :name="'product[media_gallery][images][' + getRealIndex(img) + '][media_type]'" value="image">
                    <input type="hidden" :name="'product[media_gallery][images][' + getRealIndex(img) + '][value_id]'" :value="img.value_id || ''">
                    <input type="hidden" :name="'product[media_gallery][images][' + getRealIndex(img) + '][position]'" :value="index + 1">
                    <input type="hidden" :name="'product[media_gallery][images][' + getRealIndex(img) + '][disabled]'" :value="img.disabled ? 1 : 0">
                    <input type="hidden" :name="'product[media_gallery][images][' + getRealIndex(img) + '][removed]'" :value="0">
