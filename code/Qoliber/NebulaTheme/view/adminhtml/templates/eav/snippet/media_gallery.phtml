                        <circle cx="9" cy="10" r="1.5"/><circle cx="15" cy="10" r="1.5"/>
                        <circle cx="9" cy="15" r="1.5"/><circle cx="15" cy="15" r="1.5"/>
                        <circle cx="9" cy="20" r="1.5"/><circle cx="15" cy="20" r="1.5"/>
