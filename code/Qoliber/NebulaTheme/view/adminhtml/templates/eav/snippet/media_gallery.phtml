    <!-- Removed images (hidden inputs to mark deletion) -->
    <template x-for="(img, index) in removedImages" :key="'removed_' + img.file">
        <div>
            <input type="hidden" :name="'product[media_gallery][images][' + (visibleImages.length + index) + '][file]'" :value="img.file">
            <input type="hidden" :name="'product[media_gallery][images][' + (visibleImages.length + index) + '][value_id]'" :value="img.value_id || ''">
            <input type="hidden" :name="'product[media_gallery][images][' + (visibleImages.length + index) + '][removed]'" value="1">
            <input type="hidden" :name="'product[media_gallery][images][' + (visibleImages.length + index) + '][media_type]'" value="image">
        </div>
    </template>

    <!-- Empty state -->
    <div x-show="visibleImages.length === 0 && !uploading"
         class="rounded-lg border border-dashed border-gray-300 bg-gray-50 py-8 text-center text-sm text-gray-500">
        <?= $escaper->escapeHtml((string) __('No images yet. Upload some above.')) ?>
    </div>
</div>

<script>
document.addEventListener('alpine:init', () => {
    if (window._nebulaMediaGalleryRegistered) return;
    window._nebulaMediaGalleryRegistered = true;

    Alpine.data('nebulaMediaGallery', (config) => ({
        images: config.images || [],
        baseImage: config.baseImage || '',
        smallImage: config.smallImage || '',
        thumbnailImage: config.thumbnailImage || '',
        swatchImage: config.swatchImage || '',
        uploadUrl: config.uploadUrl,
        formKey: config.formKey,
        uploadDragging: false,
        uploading: false,
        dragIndex: null,

        get visibleImages() {
            return this.images.filter(i => !i.removed);
        },

        get removedImages() {
            return this.images.filter(i => i.removed && i.value_id);
        },

        getRealIndex(img) {
            return this.images.indexOf(img);
        },

        // --- Drag to reorder ---
        dragOverIndex: null,

        startDrag(index, event) {
            this.dragIndex = index;
            event.dataTransfer.effectAllowed = 'move';
            event.dataTransfer.setData('text/plain', index);
        },

        endDrag() {
            this.dragIndex = null;
            this.dragOverIndex = null;
        },

        dragOver(index) {
            if (this.dragIndex === null || this.dragIndex === index) return;
            this.dragOverIndex = index;
        },

        drop(index) {
            if (this.dragIndex === null || this.dragIndex === index) {
                this.dragIndex = null;
                this.dragOverIndex = null;
                return;
            }
            const item = this.images.splice(this.dragIndex, 1)[0];
            this.images.splice(index, 0, item);
            this.images.forEach((img, i) => { img.position = i + 1; });
            this.dragIndex = null;
            this.dragOverIndex = null;
        },

        // --- Upload ---
        handleDrop(event) {
            this.uploadDragging = false;
            if (event.dataTransfer.files.length) {
                this.uploadFiles(event.dataTransfer.files);
            }
        },

        handleFiles(event) {
            this.uploadFiles(event.target.files);
            event.target.value = '';
        },

        async uploadFiles(files) {
            this.uploading = true;
            for (const file of files) {
                await this.uploadFile(file);
            }
            this.uploading = false;
        },

        async uploadFile(file) {
            const formData = new FormData();
            formData.append('image', file);
            formData.append('form_key', this.formKey);

            try {
                const resp = await fetch(this.uploadUrl, {
                    method: 'POST',
                    body: formData,
                    credentials: 'same-origin',
                    headers: { 'X-Requested-With': 'XMLHttpRequest' }
                });
                if (!resp.ok) {
                    throw new Error('HTTP ' + resp.status);
                }
                const result = await resp.json();
                if (!result.error) {
                    const newImg = {
                        value_id: null,
                        file: result.file,
                        url: result.url,
                        label: '',
                        position: this.images.length + 1,
                        disabled: false,
                        removed: false,
                        media_type: 'image',
                        new: true
                    };
                    this.images.push(newImg);
                    // Auto-assign all roles to first image
                    if (this.visibleImages.length === 1) {
                        this.baseImage = result.file;
                        this.smallImage = result.file;
                        this.thumbnailImage = result.file;
                        this.swatchImage = result.file;
                    }
                } else {
                    alert('Upload error: ' + (result.message || 'Unknown error'));
                }
            } catch (e) {
                console.error('Upload failed:', e);
                alert('Upload failed. Check console for details.');
            }
        },

        removeImage(index) {
            this.images[index].removed = true;
            // If removed image had a role, clear it
            const file = this.images[index].file;
            if (this.baseImage === file) this.baseImage = '';
            if (this.smallImage === file) this.smallImage = '';
            if (this.thumbnailImage === file) this.thumbnailImage = '';
            if (this.swatchImage === file) this.swatchImage = '';
        }
    }));
});
</script>
