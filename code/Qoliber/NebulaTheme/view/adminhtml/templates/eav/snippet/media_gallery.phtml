                    <div class="flex items-center justify-between">
                        <p class="text-xs font-medium text-gray-700 truncate" x-text="img.file.split('/').pop()"></p>
                        <div class="flex items-center gap-2 flex-shrink-0 ml-4">
                            <button type="button" @click="img.disabled = !img.disabled"
                                    :class="img.disabled ? 'bg-gray-300 border border-gray-300' : 'bg-indigo-600'"
