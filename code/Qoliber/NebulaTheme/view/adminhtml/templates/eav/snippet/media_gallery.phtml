        </svg>
        <p class="text-sm text-gray-600"><?= $escaper->escapeHtml((string) __('Drop images here or')) ?> <span class="text-indigo-600 font-semibold"><?= $escaper->escapeHtml((string) __('browse')) ?></span></p>
        <p class="text-xs text-gray-400 mt-1">JPG, JPEG, PNG, GIF</p>
