<!-- Specified Page row: picks a CMS page via the cms_page chooser. Renders
     when row.page_group === 'pages'. -->
<template x-if="rowEntityKind(row) === 'page'">
    <div class="flex items-center gap-3">
        <label class="text-xs font-semibold text-gray-700 w-24 shrink-0">CMS Page <span class="text-red-500">*</span></label>
        <span class="flex-1 px-3 py-2 rounded-lg border border-gray-300 bg-white text-sm text-gray-700"
              x-text="row.page_label || (row.page_id !== '0' ? row.page_id : '(none selected)')"></span>
        <button type="button"
                @click="$dispatch('open-chooser-cms-page', {fieldName: 'pg:' + idx + ':page'})"
                class="rounded-lg bg-nebula-600 text-white text-sm font-semibold px-4 py-2 hover:bg-nebula-500">
            <span x-text="row.page_id && row.page_id !== '0' ? 'Change&hellip;' : 'Pick&hellip;'"></span>
        </button>
    </div>
</template>
