                <!-- COLUMN 3 — Storefront -->
                <section class="rounded-2xl bg-white p-6 shadow-sm border border-gray-200 space-y-5 transition-opacity"
                         :class="paramsEnabled() ? '' : 'opacity-50 pointer-events-none select-none'">
                    <header class="border-b border-gray-100 pb-3 flex items-center justify-between">
                        <h2 class="text-sm font-bold uppercase tracking-wide text-indigo-700">3. Storefront</h2>
                        <span x-show="!paramsEnabled()" class="text-xs text-gray-400 italic">Pick type &amp; theme first</span>
                    </header>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Widget Title <span class="text-red-500">*</span></label>
                        <input type="text" name="title" x-model="state.title"
                               class="block w-full rounded-lg border border-gray-300 py-2 px-3 text-sm text-gray-900 shadow-sm placeholder:text-gray-400 focus:border-nebula-500 focus:ring-2 focus:ring-nebula-500/20 focus:outline-none"/>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Store Views <span class="text-red-500">*</span></label>
                        <div x-data='nebulaField_multiselect(<?= $escaper->escapeHtmlAttr($storeViewConfig) ?>)'
                             x-effect="state.store_ids = Array.isArray(value) ? value.map(v => String(v)) : []"
                             class="relative">
                            <div class="rounded-lg border border-gray-200 bg-white shadow-sm">
                                <div class="border-b border-gray-100 px-3 py-2 flex items-center gap-2">
                                    <input type="text" x-model="treeUi.search" placeholder="Search store views…"
                                           class="flex-1 rounded-md border border-gray-300 bg-white px-2.5 py-1.5 text-xs focus:border-indigo-500 focus:ring-1 focus:ring-indigo-500 focus:outline-none"/>
                                    <span class="text-xs text-gray-500"><span x-text="value.length"></span> selected</span>
                                </div>
                                <div class="max-h-56 overflow-y-auto py-1.5 px-3">
                                    <template x-for="node in treeUi.visibleNodes()" :key="(node.value ?? '_g') + '@' + node.depth + '/' + node.label">
                                        <div>
                                            <div x-show="node.group"
                                                 :class="node.depth === 0 ? 'mt-1.5 text-xs font-bold uppercase tracking-wide text-gray-500' : 'mt-1 text-xs font-semibold text-gray-600'"
                                                 :style="'padding-left:' + (node.depth * 1) + 'rem'"
                                                 x-text="node.label"></div>
                                            <label x-show="!node.group"
                                                   class="flex items-center gap-2 py-1 cursor-pointer hover:bg-gray-50 rounded px-1 -mx-1"
                                                   :style="'padding-left:' + (node.depth * 1 + 0.25) + 'rem'">
                                                <input type="checkbox"
                                                       :value="node.value"
                                                       :checked="value.includes(node.value)"
                                                       @change="value = treeUi.toggle(value, node)"
                                                       class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600"/>
                                                <span class="text-sm text-gray-700" x-text="node.label"></span>
                                            </label>
                                        </div>
                                    </template>
                                </div>
                            </div>
                        </div>
                        <template x-for="id in state.store_ids" :key="id">
                            <input type="hidden" name="store_ids[]" :value="id"/>
                        </template>
                    </div>

                    <div>
                        <label class="block text-sm font-semibold text-gray-700 mb-1">Sort Order</label>
                        <input type="number" name="sort_order" x-model.number="state.sort_order"
                               class="block w-32 rounded-lg border border-gray-300 py-2 px-3 text-sm text-gray-900 shadow-sm focus:border-nebula-500 focus:ring-2 focus:ring-nebula-500/20 focus:outline-none"/>
                    </div>
                </section>
