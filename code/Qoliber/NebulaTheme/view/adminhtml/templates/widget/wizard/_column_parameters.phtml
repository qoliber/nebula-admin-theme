                <!-- COLUMN 2 — Parameters -->
                <section class="rounded-2xl bg-white p-6 shadow-sm border border-gray-200 space-y-5 transition-opacity"
                         :class="paramsEnabled() ? '' : 'opacity-50 pointer-events-none select-none'">
                    <header class="border-b border-gray-100 pb-3 flex items-center justify-between">
                        <h2 class="text-sm font-bold uppercase tracking-wide text-indigo-700">2. Parameters</h2>
                        <span x-show="!paramsEnabled()" class="text-xs text-gray-400 italic">Pick type &amp; theme first</span>
                    </header>

                    <template x-for="field in fields" :key="field.name">
                        <div>
                            <!-- visible=false: hidden input only, no UI. -->
                            <template x-if="field.visible === false">
                                <input type="hidden" :name="'parameters[' + field.name + ']'"
                                       :value="state.parameters[field.name] ?? field.default"/>
                            </template>

                            <!-- Visible field, possibly gated by depends. -->
                            <template x-if="field.visible !== false">
                                <div x-show="isFieldVisible(field)">
                                    <label class="block text-sm font-semibold text-gray-700 mb-1">
                                        <span x-text="field.label"></span>
                                        <span x-show="field.required" class="text-red-500">*</span>
                                    </label>

                                    <template x-if="field.type === 'text'">
                                        <input type="text" :name="'parameters[' + field.name + ']'"
                                               x-model="state.parameters[field.name]"
                                               class="block w-full rounded-lg border border-gray-300 py-2 px-3 text-sm text-gray-900 shadow-sm placeholder:text-gray-400 focus:border-nebula-500 focus:ring-2 focus:ring-nebula-500/20 focus:outline-none"/>
                                    </template>

                                    <template x-if="field.type === 'select'">
                                        <select :name="'parameters[' + field.name + ']'"
                                                x-model="state.parameters[field.name]"
                                                class="block w-full rounded-lg border border-gray-300 py-2 px-3 text-sm text-gray-900 shadow-sm placeholder:text-gray-400 focus:border-nebula-500 focus:ring-2 focus:ring-nebula-500/20 focus:outline-none">
                                            <option value="">&mdash; Select &mdash;</option>
                                            <template x-for="opt in field.options" :key="opt.value">
                                                <option :value="opt.value" x-text="opt.label"></option>
                                            </template>
                                        </select>
                                    </template>

                                    <template x-if="field.type === 'multiselect'">
                                        <div>
                                            <select :name="'parameters[' + field.name + '][]'"
                                                    x-model="state.parameters[field.name]"
                                                    multiple size="5"
                                                    class="block w-full rounded-lg border border-gray-300 py-2 px-3 text-sm text-gray-900 shadow-sm focus:border-nebula-500 focus:ring-2 focus:ring-nebula-500/20 focus:outline-none">
                                                <template x-for="opt in field.options" :key="opt.value">
                                                    <option :value="opt.value" x-text="opt.label"></option>
                                                </template>
                                            </select>
                                            <p class="mt-1 text-xs text-gray-500">Hold Ctrl / &#8984; to select multiple.</p>
                                        </div>
                                    </template>

                                    <!-- Inline-mode choosers (e.g. conditions rule editor) — registered with
                                         mode=inline in the chooser registry. The PHP loop below iterates
                                         them ONCE per registered alias, wrapping each in an x-if so only
                                         the matching field renders the inline scope. The template runs
                                         INSIDE the parameter row's Alpine scope so it sees `field`/`state`. -->
                                    <?php foreach ($chooserRegistry->inline() as $inlineAlias => $inlineCfg): ?>
                                        <template x-if="field.type === 'chooser' && field.chooser === '<?= $escaper->escapeJs($inlineAlias) ?>'">
                                            <div>
                                                <?php
                                                $conditionsVm = $chooserRegistry->resolveViewModel($inlineAlias);
                                                include $block->getTemplateFile($inlineCfg['template']);
                                                ?>
                                            </div>
                                        </template>
                                    <?php endforeach; ?>

                                    <!-- Modal-mode choosers: "Pick…" button dispatches open-chooser-<alias>;
                                         the chooser snippet itself is mounted as a sibling of the form.
                                         The inline-aliases array is HTML-escaped so the embedded `"`
                                         become `&quot;` and don't terminate the surrounding attribute;
                                         the HTML parser decodes them back to `"` before Alpine sees the
                                         expression. -->
                                    <?php $inlineAliasesJson = $escaper->escapeHtmlAttr(json_encode(array_keys($chooserRegistry->inline()))); ?>
                                    <template x-if="field.type === 'chooser' && isChooserAvailable(field.chooser) && !<?= /* @noEscape */ $inlineAliasesJson ?>.includes(field.chooser)">
                                        <div class="flex items-center gap-3">
                                            <input type="hidden" :name="'parameters[' + field.name + ']'"
                                                   x-model="state.parameters[field.name]"/>
                                            <span class="flex-1 px-3 py-2 rounded-lg border border-gray-300 bg-gray-50 text-sm text-gray-700"
                                                  x-text="state.parameter_labels[field.name] || state.parameters[field.name] || '(none selected)'"></span>
                                            <button type="button"
                                                    @click="$dispatch('open-chooser-' + field.chooser.replace('_', '-'), {fieldName: field.name})"
                                                    class="rounded-lg bg-nebula-600 text-white text-sm font-semibold px-4 py-2 hover:bg-nebula-500">
                                                <span x-text="state.parameters[field.name] ? 'Change&hellip;' : 'Pick&hellip;'"></span>
                                            </button>
                                        </div>
                                    </template>

                                    <template x-if="field.type === 'chooser' && !isChooserAvailable(field.chooser)">
                                        <div class="flex items-center gap-3">
                                            <input type="hidden" :name="'parameters[' + field.name + ']'"
                                                   x-model="state.parameters[field.name]"/>
                                            <span class="flex-1 px-3 py-2 rounded-lg border border-amber-200 bg-amber-50 text-sm text-amber-800">
                                                <span x-text="state.parameters[field.name] || '(no selection)'"></span>
                                                <span class="block text-xs mt-0.5">
                                                    Chooser for <code class="bg-amber-100 px-1 rounded" x-text="field.chooser"></code> lands in B2.
                                                    Use Magento's legacy widget UI to pick a value for now.
                                                </span>
                                            </span>
                                        </div>
                                    </template>

                                    <p x-show="field.description" class="mt-1 text-xs text-gray-500" x-html="field.description"></p>
                                </div>
                            </template>
                        </div>
                    </template>

                    <template x-if="paramsEnabled() && !fields.length">
                        <p class="text-sm text-gray-500">This widget type has no parameters to configure.</p>
                    </template>
                    <template x-if="!paramsEnabled()">
                        <p class="text-sm text-gray-400">Once you pick a widget type and theme, its parameters appear here.</p>
                    </template>
                </section>

