<!-- Page Layouts row: layout-handle select sourced from PageLayoutConfig.
     Renders when row.page_group === 'page_layouts'. -->
<template x-if="rowEntityKind(row) === 'page_layout'">
    <div class="flex items-center gap-3">
        <label class="text-xs font-semibold text-gray-700 w-24 shrink-0">Page Layout <span class="text-red-500">*</span></label>
        <select x-model="row.layout_handle"
                x-init="$nextTick(() => { $el.value = row.layout_handle })"
                class="flex-1 rounded-lg border border-gray-300 py-2 px-3 text-sm text-gray-900 shadow-sm focus:border-nebula-500 focus:ring-2 focus:ring-nebula-500/20 focus:outline-none">
            <option value="">&mdash; Select page layout &mdash;</option>
            <template x-for="opt in pageLayoutOptions" :key="opt.value">
                <option :value="opt.value" x-text="opt.label"></option>
            </template>
        </select>
    </div>
</template>
