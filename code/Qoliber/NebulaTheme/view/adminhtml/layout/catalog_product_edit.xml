<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <update handle="nebula_eav_form"/>
    <body>
        <referenceBlock name="page.title" remove="true"/>
        <move element="store_switcher" destination="nebula.catalog_product_edit" as="scope_switcher"/>
        <!--
            Form block + scripts live in catalog_product_form so both new and
            edit pages inherit them (catalog_product_new extends form via
            Magento's vendor layout). Declaring the form block here would
            duplicate it on edit because the edit handle inherits the form
            handle via the catalog_product_new chain.
        -->
    </body>
</page>
