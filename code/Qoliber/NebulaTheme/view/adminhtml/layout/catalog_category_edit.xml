<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="admin-1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="page.title" remove="true"/>
        <referenceBlock name="category.tree" remove="true"/>
        <referenceBlock name="category_form" remove="true"/>
        <referenceBlock name="category.edit" remove="true"/>
        <referenceBlock name="store_switcher" remove="true"/>
        <move element="category.store.switcher" destination="nebula.catalog_category_edit" as="scope_switcher"/>
        <referenceContainer name="content">
            <block class="Qoliber\NebulaForm\Block\EavForm"
                   name="nebula.catalog_category_edit"
                   after="-">
                <arguments>
                    <argument name="form_id" xsi:type="string">catalog_category_edit</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template"
                   name="nebula.catalog.category.scripts"
                   template="Qoliber_NebulaTheme::scripts/catalog-product.phtml"/>
        </referenceContainer>
    </body>
</page>
