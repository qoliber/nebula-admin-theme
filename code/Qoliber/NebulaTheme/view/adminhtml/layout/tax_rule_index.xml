<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="adminhtml.block.tax.rule.container" remove="true"/>
        <referenceContainer name="content" htmlTag="div">
            <block class="Qoliber\NebulaTheme\Block\Adminhtml\Tax\Rule\Manager"
                   name="nebula.tax_rule_manager"
                   after="-">
                <block class="Qoliber\NebulaGrid\Block\Grid"
                       name="nebula.tax_rule_listing"
                       as="grid">
                    <arguments>
                        <argument name="grid_id" xsi:type="string">tax_rule_listing</argument>
                    </arguments>
                </block>
                <block class="Qoliber\NebulaForm\Block\Form"
                       name="nebula.tax_rule_form"
                       as="form">
                    <arguments>
                        <argument name="form_id" xsi:type="string">tax_rule_edit</argument>
                    </arguments>
                </block>
            </block>
        </referenceContainer>
    </body>
</page>
