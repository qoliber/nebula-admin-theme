<?xml version="1.0"?>
<!--
/**
 * Minimal stub kept after the legacy Nebula form-mount layout was removed.
 *
 * The form-mount block and the `attribute_edit_*` removals are now injected by
 * Qoliber\NebulaForm\Plugin\InjectFormLayout from the form JSON definition.
 *
 * What the wirer CANNOT do — and why this file still exists: it sets the page
 * `layout` attribute. Magento's own catalog_product_attribute_edit.xml uses
 * `admin-2columns-left` (it needs the left rail for the EAV tabs); the Nebula
 * single-column form has no left rail, so the page must be forced back to
 * `admin-1column`. The wirer is an afterLoad addUpdate() and cannot set the
 * <page layout> attribute. The htmlTag on the content container is likewise
 * preserved here.
 */
-->
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      layout="admin-1column"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content" htmlTag="div"/>
    </body>
</page>
