<?xml version="1.0"?>
<!--
    Qoliber_NebulaTheme — consolidated theme glue module.

    Hosts data providers + view assets for Magento admin areas that need
    nothing more than form/grid JSONs, layout XML overrides, and a
    DataProvider implementation. Replaces 13 single-purpose Nebula*
    modules that previously each carried only one provider or one view
    folder.

    PHP architecture (NebulaComponent, NebulaForm, NebulaGrid, etc.)
    stays in its own modules. This module only depends on those.
-->
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Module/etc/module.xsd">
    <module name="Qoliber_NebulaTheme">
        <sequence>
            <module name="Magento_Backend"/>
            <module name="Magento_Bundle"/>
            <module name="Magento_Catalog"/>
            <module name="Magento_Customer"/>
            <module name="Magento_CatalogRule"/>
            <module name="Magento_Cms"/>
            <module name="Magento_ConfigurableProduct"/>
            <module name="Magento_Email"/>
            <module name="Magento_Integration"/>
            <module name="Magento_Newsletter"/>
            <module name="Magento_Sales"/>
            <module name="Magento_SalesRule"/>
            <module name="Magento_Search"/>
            <module name="Magento_Sitemap"/>
            <module name="Magento_Tax"/>
            <module name="Magento_UrlRewrite"/>
            <module name="Magento_User"/>
            <module name="Qoliber_NebulaComponent"/>
            <module name="Qoliber_NebulaForm"/>
            <module name="Qoliber_NebulaGrid"/>
        </sequence>
    </module>
</config>
