            </div>

            <div x-show="searchQuery.length >= 2 && !searching && searchResults.length === 0"
                 class="py-12 text-center text-sm text-gray-500">
                <?= $escaper->escapeHtml(__('No products found.')) ?>
            </div>

            <template x-for="product in searchResults" :key="product.id">
                <div @click="addProduct(product)"
                     class="flex cursor-pointer items-center gap-3 rounded-lg px-3 py-2.5 hover:bg-indigo-50 transition-colors border-b border-gray-100 last:border-0">
                    <div class="h-10 w-10 flex-shrink-0 overflow-hidden rounded bg-gray-100">
                        <img x-show="product.thumbnail" :src="product.thumbnail" :alt="product.name"
                             class="h-full w-full object-cover">
                        <div x-show="!product.thumbnail"
                             class="flex h-full w-full items-center justify-center text-gray-400">
                            <svg class="h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" d="m2.25 15.75 5.159-5.159a2.25 2.25 0 0 1 3.182 0l5.159 5.159m-1.5-1.5 1.409-1.409a2.25 2.25 0 0 1 3.182 0l2.909 2.909M3.75 21h16.5A2.25 2.25 0 0 0 22.5 18.75V5.25A2.25 2.25 0 0 0 20.25 3H3.75A2.25 2.25 0 0 0 1.5 5.25v13.5A2.25 2.25 0 0 0 3.75 21Z"/>
                            </svg>
                        </div>
                    </div>
                    <div class="flex-1 min-w-0">
