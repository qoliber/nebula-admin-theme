                        <div class="text-xs text-gray-500">
                            <span class="font-mono" x-text="product.sku"></span>
                            <span x-show="product.type_id" class="ml-2 rounded bg-gray-100 px-1.5 py-0.5 text-[10px] uppercase text-gray-500" x-text="product.type_id"></span>
                        </div>
                    </div>
                    <div class="text-sm text-gray-700 flex-shrink-0"
                         x-text="product.price != null ? '$' + Number(product.price).toFixed(2) : ''"></div>
                    <div class="flex-shrink-0">
                        <span class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-xs font-medium text-indigo-700">
                            <?= $escaper->escapeHtml(__('Add')) ?>
                        </span>
                    </div>
                </div>
            </template>
        </div>

        <div class="flex items-center justify-end border-t border-gray-200 px-6 py-3">
            <button type="button" @click="searchOpen = false; searchQuery = ''; searchResults = []"
