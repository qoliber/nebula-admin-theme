<?php

declare(strict_types=1);

/**
 * Snippet: searchable_multiselect
 *
 * Available variables:
 * @var \Magento\Framework\View\Element\Template $block
 * $block->getData('field_name')   - input name (e.g., 'category_ids[]')
 * $block->getData('options')      - array of [{value, label, path?}]
 * $block->getData('selected')     - array of selected values (strings)
 * $block->getData('placeholder')  - search placeholder text
 * $block->getData('label')        - field label for the modal title
 */

$fieldName = $block->getData('field_name') ?? 'items[]';
$options = $block->getData('options') ?? [];
$selected = $block->getData('selected') ?? [];
$placeholder = $block->getData('placeholder') ?? __('Search...');
$fieldLabel = $block->getData('label') ?? __('Select Options');
$componentId = 'multiselect_' . md5($fieldName);

$configJson = json_encode([
    'fieldName' => $fieldName,
    'options' => array_values($options),
    'selected' => array_map('strval', $selected),
    'label' => (string) $fieldLabel,
], JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR);
?>

<div id="<?= $escaper->escapeHtmlAttr($componentId) ?>"
     x-data="nebulaMultiselect(<?= $escaper->escapeHtmlAttr($configJson) ?>)">

    <?php if (count($options) <= 12) : ?>
    <!-- Inline checkboxes for small option sets -->
    <div class="grid grid-cols-2 gap-x-4 gap-y-1.5">
        <template x-for="opt in allOptions" :key="opt.value">
            <label class="flex items-center gap-2 py-1 cursor-pointer hover:bg-gray-50 rounded px-1 -mx-1">
                <input type="checkbox"
                       :checked="isSelected(opt.value)"
                       @change="toggle(opt.value)"
                       class="h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-600">
                <span class="text-sm text-gray-700" x-text="opt.path || opt.label"></span>
            </label>
        </template>
    </div>
    <?php else : ?>
