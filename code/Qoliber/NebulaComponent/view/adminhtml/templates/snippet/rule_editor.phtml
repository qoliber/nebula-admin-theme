<?php

/**
 * Snippet: rule_conditions
 *
 * Available block data:
 *   - `entity_data`  — the rule entity data array
 *   - `form_block`   — the parent form block
 *   - `section`      — section config from JSON definition (carries rule_type)
 *
 * The ViewModel is resolved via `renderPhtmlSection()` which injects the
 * `view_model` argument when the `section` declares `viewModel: FQCN`.
 * If no view model is wired (legacy callers), fall back to a generic
 * ObjectManager lookup scoped to a single allow-om marker.
 */

declare(strict_types=1);

/** @var \Magento\Framework\View\Element\Template $block */

$entityData = (array) ($block->getData('entity_data') ?? []);
$section = (array) ($block->getData('section') ?? []);
$ruleType = (string) ($section['rule_type'] ?? 'catalog');

/** @var \Qoliber\NebulaComponent\ViewModel\RuleEditor|null $viewModel */
$viewModel = $block->getData('view_model');

if (!$viewModel instanceof \Qoliber\NebulaComponent\ViewModel\RuleEditor) {
    // nebula:allow-object-manager dynamic-snippet-view-model — snippet
    // templates are rendered at runtime via Template::class blocks that
    // cannot receive layout-XML arguments, so resolving the view model here
    // is the documented escape hatch until the snippet renderer is upgraded
    // to pass the view model explicitly.
    $viewModel = \Magento\Framework\App\ObjectManager::getInstance()
        ->get(\Qoliber\NebulaComponent\ViewModel\RuleEditor::class);
}

$config = $viewModel->buildConfig($entityData, $ruleType);

$configJson = json_encode(
    $config,
    JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR
);
?>

<div x-data="nebulaRuleEditor(<?= $escaper->escapeHtmlAttr($configJson) ?>)"
     class="nebula-rule-editor"
     x-effect="$el.querySelector('.rule-tree-container').innerHTML = renderTree()">

    <div class="rule-tree-container"></div>
</div>
