$scriptString = <<<JS
(function () {
    var register = function () {
        Alpine.data('nebulaVariableManager', function (config) {
            config = config || {};

            return {
                modalOpen: !!config.open,
                backUrl: config.backUrl || '',
                isEditing: !!config.isEditing,
                init: function () {
                    this.bindValidation();
                },
                openForCreate: function () {
                    this.modalOpen = true;
                    var form = document.getElementById('edit_form');
                    if (form) {
                        this.resetCreateForm(form);
                    }
                },
                closeModal: function () {
                    if (this.isEditing) {
                        window.location.href = this.backUrl;
                        return;
                    }
                    this.modalOpen = false;
                },
                goBack: function () {
                    this.closeModal();
                },
                resetForm: function () {
                    var form = document.getElementById('edit_form');
                    if (!form) {
                        return;
                    }

                    if (this.isEditing) {
                        this.resetExistingForm(form);
                    } else {
                        this.resetCreateForm(form);
                    }
                },
                resetExistingForm: function (form) {
                    if (!form) {
                        return;
                    }

                    form.reset();
                    this.syncFormControls(form);
                    this.clearValidationState(form);
                },
                resetCreateForm: function (form) {
                    if (!form) {
                        return;
                    }

                    [
                        'variable[variable_id]',
                        'variable[code]',
                        'variable[name]',
                        'variable[html_value]',
                        'variable[plain_value]'
                    ].forEach(function (fieldName) {
                        var field = form.querySelector('[name="' + fieldName + '"]');
                        if (field) {
                            field.defaultValue = '';
                            field.value = '';
                        }
                    });

                    var useDefault = form.querySelector('#use_default_value');
                    if (useDefault) {
                        useDefault.defaultValue = '0';
                        useDefault.value = '0';
                    }

                    form.reset();
                    this.syncFormControls(form);
                    this.clearValidationState(form);
                },
                syncFormControls: function (form) {
                    Array.prototype.forEach.call(form.elements, function (element) {
                        if (!element.name) {
                            return;
                        }

                        element.dispatchEvent(new Event('input', { bubbles: true }));
                        element.dispatchEvent(new Event('change', { bubbles: true }));
                    });
                },
                clearValidationState: function (form) {
                    form.querySelectorAll('.mage-error').forEach(function (element) {
                        element.classList.remove('mage-error');
                    });

                    form.querySelectorAll('[generated=true], .admin__field-error').forEach(function (element) {
                        element.remove();
                    });
                },
                submitForm: function (back) {
                    var form = document.getElementById('edit_form');
                    if (!form) {
                        return;
                    }

                    if (window.Nebula && window.Nebula.validateForm && !window.Nebula.validateForm(form)) {
                        return;
                    }

                    var backInput = form.querySelector('input[name="back"]');
                    if (!backInput) {
                        backInput = document.createElement('input');
                        backInput.type = 'hidden';
                        backInput.name = 'back';
                        form.appendChild(backInput);
                    }
                    backInput.value = back || '';

                    if (window.Nebula && window.Nebula.showSaveLoader) {
                        window.Nebula.showSaveLoader();
                    }

                    form.submit();
                },
                confirmDelete: async function () {
                    var deleteUrl = __DELETE_URL__;
                    if (!deleteUrl || !window.Nebula || !window.Nebula.confirm) {
                        return;
                    }

                    var confirmed = await window.Nebula.confirm({
                        title: 'Delete this variable?',
                        message: 'This action cannot be undone.',
                        danger: true,
                        confirmText: 'Delete'
                    });

                    if (!confirmed) {
                        return;
                    }

                    var form = document.createElement('form');
                    form.method = 'POST';
                    form.action = deleteUrl;

                    var key = document.createElement('input');
                    key.type = 'hidden';
                    key.name = 'form_key';
                    key.value = __FORM_KEY__;
                    form.appendChild(key);

                    document.body.appendChild(form);
                    form.submit();
                },
                bindValidation: function () {
                    require(['jquery', 'mage/mage'], function ($) {
                        var form = $('#edit_form');
                        if (!form.length) {
                            return;
                        }

                        form.mage('form').mage('validation', {
                            validationUrl: __VALIDATION_URL__,
                            highlight: function (element) {
                                $(element).trigger('highlight.validate');
                            }
                        });
                    });
                }
            };
        });
    };

    if (window.Alpine) {
        register();
    } else {
        document.addEventListener('alpine:init', register);
    }
})();
JS;
$scriptString = strtr($scriptString, [
    '__DELETE_URL__' => $deleteUrlJs,
    '__FORM_KEY__' => $formKeyJs,
    '__VALIDATION_URL__' => $validationUrlJs,
]);
?>
<?= /* @noEscape */ $secureRenderer->renderTag('script', [], $scriptString, false) ?>
