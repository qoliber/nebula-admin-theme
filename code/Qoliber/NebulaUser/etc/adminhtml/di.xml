<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!--
        Replace the stock role-edit buttons block with a no-op subclass so it
        survives Nebula's flattened layout (no page.actions.toolbar). The block
        is single-use (adminhtml_user_role_editrole.xml only), so this preference
        is fully scoped to role editing.
    -->
    <preference for="Magento\User\Block\Buttons" type="Qoliber\NebulaUser\Block\RoleButtons"/>
</config>
