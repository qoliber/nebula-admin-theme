<?php

/**
 * Snippet: role_users_grid
 *
 * Renders the "Role Users" tab of the role edit page as a flat checkbox table.
 * Each row represents an admin user; checking a row assigns that user to the
 * role on save. The stock SaveRole controller diffs two POST fields:
 *
 *   - in_role_user      → the new state (serialised `userId=&userId=&...`)
 *   - in_role_user_old  → the prior DB state (same shape)
 *
 * We emit a fresh value for `in_role_user` on every form serialisation via a
 * tiny pre-submit Alpine hook on the host form, and a static value for
 * `in_role_user_old` built from the ViewModel's snapshot.
 *
 * The search box filters rows client-side (no AJAX) — admin user lists are
 * small enough that a full DOM filter is faster than round-tripping.
 *
 * Available block data set by SectionRenderer when this snippet is mounted:
 *   - `view_model` → \Qoliber\NebulaUser\ViewModel\RoleUsersGrid
 *   - `entity_data`, `form_block`, `section` (unused here)
 *
 * @var \Magento\Framework\View\Element\Template $block
 * @var \Magento\Framework\Escaper $escaper
 */

declare(strict_types=1);

$viewModel = $block->getData('view_model');
if (!$viewModel instanceof \Qoliber\NebulaUser\ViewModel\RoleUsersGrid) {
    throw new \RuntimeException(
        'Nebula snippet "role_users_grid": view_model was not injected '
        . '(expected \Qoliber\NebulaUser\ViewModel\RoleUsersGrid). Check the SnippetViewModelRegistry binding or layout wiring.'
    );
}

if (!$viewModel->hasRole()) {
    ?>
    <div class="rounded-lg border border-dashed border-gray-300 bg-gray-50 px-6 py-8 text-center text-sm text-gray-500">
        <?= $escaper->escapeHtml((string) __('Save the role first to assign users to it.')) ?>
    </div>
    <?php
    return;
}

$users       = $viewModel->getUsers();
$assignedIds = $viewModel->getAssignedUserIds();
$currentRid  = (string) ($block->getRequest()->getParam('rid', '') ?: '');

// Build the prior-state `in_role_user_old` value: SaveRole calls parse_str()
// on it and reads the keys, so emit `id1=&id2=&id3=` (no values needed).
$inRoleUserOld = '';
if ($assignedIds !== []) {
    $inRoleUserOld = implode(
        '&',
        array_map(static fn (string $id): string => rawurlencode($id) . '=', $assignedIds)
    );
}

$initial = [
    'assigned'   => $assignedIds,
    'currentRid' => $currentRid,
    'msgWarning' => (string) __('This user is currently assigned to role "%1". Adding them here will remove that assignment — Magento allows only one role per user. Continue?', '__ROLE__'),
];

$config = json_encode($initial, JSON_HEX_APOS | JSON_HEX_QUOT | JSON_UNESCAPED_SLASHES);
?>
<script>
(function() {
    if (window._nebulaRoleUsersGridRegistered) return;
    window._nebulaRoleUsersGridRegistered = true;

    var register = function() {
        Alpine.data('nebulaRoleUsersGrid', function(initial) {
            return {
                assigned:   {},
                filter:     '',
                onlyInRole: true,
                currentRid: String(initial.currentRid || ''),
                msgWarning: String(initial.msgWarning || ''),

                init: function() {
                    var self = this;
                    (initial.assigned || []).forEach(function(id) {
                        var s = String(id);
                        if (/^\d+$/.test(s)) { self.assigned[s] = true; }
                    });

                    // Keep the serialised `in_role_user` hidden in sync on every
                    // form submit — vendor SaveRole calls parse_str() on the
                    // value, so we emit `id1=&id2=&...` (empty values). Whitelist
                    // numeric ids only so a stray non-id key never leaks into
                    // the POST and triggers User->save() validation.
                    var hidden = self.$root.querySelector('[data-in-role-user]');
                    var form   = self.$root.closest('form');
                    if (hidden && form) {
                        var serialise = function() {
                            hidden.value = Object.keys(self.assigned)
                                .filter(function(id) {
                                    return self.assigned[id] && /^\d+$/.test(id);
                                })
                                .map(function(id) { return encodeURIComponent(id) + '='; })
                                .join('&');
                        };
                        form.addEventListener('submit', serialise, true);
                        // Also set the initial value so first-render POSTs
                        // (e.g. immediate Ctrl+S) get the right payload.
                        serialise();
                    }
                },

                /**
                 * Toggle a user's checkbox. If the user is currently assigned
                 * to another role (currentRoleId !== this role's rid), confirm
                 * the reassignment first — Magento allows only one role per
                 * user, and saving would silently move them out of the other role.
                 */
                toggle: function(id, currentRoleId, currentRoleName) {
                    var idStr = String(id);
                    if (!/^\d+$/.test(idStr)) { return; }

                    var nowChecked = !this.assigned[idStr];
                    var inOtherRole = nowChecked
                        && currentRoleId
                        && String(currentRoleId) !== this.currentRid;

                    var apply = function (ctx) {
                        var next = Object.assign({}, ctx.assigned);
                        if (next[idStr]) { delete next[idStr]; } else { next[idStr] = true; }
                        ctx.assigned = next;
                    };

                    if (!inOtherRole) {
                        apply(this);
                        return;
                    }

                    var self = this;
                    var msg  = this.msgWarning.replace('__ROLE__', currentRoleName || '');
                    if (window.Nebula && typeof window.Nebula.confirm === 'function') {
                        Promise.resolve(window.Nebula.confirm({
                            title:       'Reassign user?',
                            message:     msg,
                            confirmText: 'Yes, move',
                            cancelText:  'Cancel'
                        })).then(function (ok) {
                            if (ok) { apply(self); }
                            else    { self._uncheckBox(idStr); }
                        });
                    } else {
                        if (window.confirm(msg)) { apply(self); }
                        else                     { self._uncheckBox(idStr); }
                    }
                },

                _uncheckBox: function(id) {
                    // Revert the checkbox state for users who declined the
                    // role-reassignment prompt — Alpine's :checked binding
                    // depends on `assigned[id]`, so we just nudge Alpine to
                    // re-render by reassigning the map.
                    this.assigned = Object.assign({}, this.assigned);
                },

                isAssigned: function(id) {
                    return !!this.assigned[String(id)];
                },

                rowMatches: function(haystack, isInRole) {
                    if (this.onlyInRole && !isInRole) { return false; }
                    if (!this.filter) { return true; }
                    return haystack.toLowerCase().indexOf(this.filter.toLowerCase()) !== -1;
                },

                assignedCount: function() {
                    var n = 0;
                    var self = this;
                    Object.keys(this.assigned).forEach(function(id) {
                        if (self.assigned[id] && /^\d+$/.test(id)) { n++; }
                    });
                    return n;
                }
            };
        });
    };

    if (window.Alpine) { register(); }
    else { document.addEventListener('alpine:init', register); }
})();
</script>

