                                    </span>
                                <?php elseif ($currentRoleId !== ''): ?>
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 font-semibold ring-1 ring-inset bg-amber-50 text-amber-700 ring-amber-200">
