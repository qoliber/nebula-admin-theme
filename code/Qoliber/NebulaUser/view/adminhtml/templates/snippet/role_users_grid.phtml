                    <th scope="col" class="w-10 px-3 py-2"></th>
                    <th scope="col" class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><?= $escaper->escapeHtml((string) __('User Name')) ?></th>
                    <th scope="col" class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><?= $escaper->escapeHtml((string) __('Name')) ?></th>
                    <th scope="col" class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><?= $escaper->escapeHtml((string) __('Email')) ?></th>
                    <th scope="col" class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><?= $escaper->escapeHtml((string) __('Current Role')) ?></th>
                    <th scope="col" class="px-3 py-2 text-left text-xs font-semibold uppercase tracking-wide text-gray-600"><?= $escaper->escapeHtml((string) __('Status')) ?></th>
