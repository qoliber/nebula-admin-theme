                            <?= $escaper->escapeHtml((string) __('No admin users exist yet.')) ?>
                        </td>
                    </tr>
                <?php else : ?>
                    <?php foreach ($users as $row) : ?>
                        <?php
                        $id              = $row['user_id'];
                        $haystack        = strtolower($row['username'] . ' ' . $row['firstname'] . ' ' . $row['lastname'] . ' ' . $row['email']);
                        $fullName        = trim($row['firstname'] . ' ' . $row['lastname']);
                        $statusCls       = $row['is_active']
                            ? 'bg-emerald-50 text-emerald-700 ring-emerald-200'
                            : 'bg-gray-100 text-gray-600 ring-gray-200';
                        $statusLbl       = $row['is_active'] ? (string) __('Active') : (string) __('Inactive');
                        $currentRoleId   = $row['current_role_id'];
                        $currentRoleName = $row['current_role_name'];
                        $inThisRole      = $row['in_role'] ? 'true' : 'false';
                        ?>
                        <tr class="hover:bg-gray-50"
                            x-show="rowMatches('<?= $escaper->escapeJs($haystack) ?>', <?= /* @noEscape */ $inThisRole ?>)">
