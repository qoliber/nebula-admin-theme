                                <?= $escaper->escapeHtml($row['username']) ?>
                            </td>
                            <td class="px-3 py-2 align-middle text-sm text-gray-700">
                                <?= $escaper->escapeHtml($fullName === '' ? '—' : $fullName) ?>
                            </td>
                            <td class="px-3 py-2 align-middle text-sm text-gray-700">
                                <?= $escaper->escapeHtml($row['email']) ?>
                            </td>
                            <td class="px-3 py-2 align-middle text-xs">
                                <?php if ($currentRoleId !== '' && $currentRoleId === $currentRid): ?>
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 font-semibold ring-1 ring-inset bg-indigo-50 text-indigo-700 ring-indigo-200">
