{
  "id": "admin_role_listing",
  "acl": "Magento_User::acl_roles",
  "dataSource": {
    "provider": "grid.collection",
    "config": {
      "collection": "admin_role.collection"
    }
  },
  "settings": {
    "pageSize": 20,
    "pageSizes": [10, 20, 50, 100],
    "defaultSort": {
      "field": "role_id",
      "direction": "asc"
    },
    "massActions": false,
    "addButton": {
      "label": "Add New Role",
      "url": "adminhtml/user_role/editrole"
    }
  },
  "columns": {
    "role_id": {
      "label": "ID",
      "type": "text",
      "sortable": true,
      "filter": "range",
      "position": 10
    },
    "role_name": {
      "label": "Role Name",
      "type": "text",
      "sortable": true,
      "filter": "text",
      "searchable": true,
      "position": 20
    },
    "actions": {
      "label": "",
      "type": "actions",
      "actions": [
        {
          "label": "Edit",
          "url": "adminhtml/user_role/editrole/rid/{{role_id}}"
        }
      ],
      "position": 999
    }
  }
}
